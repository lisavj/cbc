// ===== CHT (chart-time) CHANGELOG =====
// v1.01 (10/05/2026): compile fix CE10156 -- Pine has no array literal for input options; the level list is now written inline in each of the 4 level pickers.
// v1.00 (10/05/2026): new standalone indicator. Runs the CBC v8.80 "HTF" signals on the CHART's own timeframe
//   (built for 15m, works on any timeframe, e.g. 10m). Nothing is requested from a higher timeframe.
//   Alerts: CBC Flip, EMA9 / EMA20 Pierce, Pullback - Structure Confirmed, Enters EMA9/20 zone, EMA20 Touch,
//   EMA200 Break, EMA9/20 Cross. Setups: same engine as v8.80 (ESLib/18): TP/SL from the level pool (daily
//   pivots, YD H/L, PM H/L, NY/LN/AS opening ranges, chart swing pivots + EQH/EQL, VWAP, EMA200; NO 3m pivots),
//   Trade Levels box, R:R table, Setup Ended alert, Setup Triggers list, filters (CHOP / VWAP stretch / flip
//   count) and the VWAP / pivot reclaim blocks. Every alert bullet starts with "CH<minutes>" (e.g.
//   "• CH15 Trade Setup: LONG") so the Alert Feed (index v81+) shows them in their own groups and setup box.
//@version=6
indicator("CHT v1.01", overlay = true, behind_chart = false, calc_bars_count = 10000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
import samuelsuss8/ESLib/18 as obLib

const string ny_tz = "America/New_York"
int tf_min = int(math.round(timeframe.in_seconds() / 60))
string s_tf = str.tostring(tf_min) + "m"
string s_ch = "CH" + str.tostring(tf_min)
f_n(float x) => na(x) ? "—" : str.tostring(x, "#.##")
f_s(float x) => na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, "#.##")
f_hm(int t) => str.format_time(t, "HH:mm", ny_tz)

// ============================== INPUTS ==============================
g_trig = "Setup Triggers"
t_flip = input.bool(true, "Trigger: CBC Flip (confirmed)", group=g_trig, tooltip="A setup on every confirmed CBC flip of the chart timeframe (not blocked by the 3-candle cooldown).")
flip_wait_on = input.bool(false, "CBC Flip: require a pullback first", group=g_trig, tooltip="ON = after the flip, wait for a touch of the EMA20 and a close back in the trade direction (within the bars below).")
flip_win_in = input.int(10, "CBC Flip: wait for pullback (bars)", minval=1, group=g_trig)
flip_two_step = input.bool(true, "CBC Flip: touch and close-back may be on separate candles", group=g_trig)
t_e9 = input.bool(true, "Trigger: EMA9 Pierce", group=g_trig, tooltip="CBC direction + pullback into the chart EMA9 + close back on the trade side.")
t_e20 = input.bool(true, "Trigger: EMA20 Pierce", group=g_trig, tooltip="Same as EMA9 Pierce on the chart EMA20.")
late_bars = input.int(1, "Pierce late-confirm window (bars)", minval=0, group=g_trig, tooltip="If the pierce candle closed through the line, a trade-side close within this many candles still triggers. 0 = pierce candle only.")
late_color = input.bool(true, "Pierce late confirm: trade-color candle", group=g_trig)
t_momo = input.bool(true, "Trigger: Momentum break (no pullback)", group=g_trig, tooltip="CBC direction + a candle closes beyond the last swing high (long) / low (short) in the trade colour.")
t_pb = input.bool(true, "Trigger: Pullback - Structure Confirmed", group=g_trig, tooltip="Recent CBC flip (away from EMA20) + structure HH/HL (long) or LH/LL (short) + price enters the EMA9/20 zone.")
pb_recent = input.int(4, "Pullback: recent flip window (bars)", minval=1, group=g_trig)

g_ats = "Auto Trade Setup"
ats_on = input.bool(true, "Auto-Draw Trade Setup (Entry/Stop/Target)", group=g_ats)
allow_toward = input.bool(true, "Include 'toward' flips", group=g_ats, tooltip="On: setups also after a 'toward' flip (long flip closing below the EMA20 / short flip closing above it); marked Flip side: TOWARD. Off: only after 'away' flips.")
vw_blk_on = input.bool(true, "VWAP reclaim blocks setups for (bars)", inline="vwb", group=g_ats, tooltip="CBC short: a candle closes down through VWAP and a later candle closes back above it -> no SHORT setup on that candle and the next N. Long mirrored. Resets at each CBC flip.")
vw_blk_n = input.int(5, "", minval=1, inline="vwb", group=g_ats)
pv_blk_on = input.bool(true, "Pivot reclaim (R1-R3 / S1-S3) blocks setups (same bars)", group=g_ats, tooltip="Same rule for each of R1, R2, R3, S1, S2, S3 (not PP).")
ats_alert_on = input.bool(true, "Alert: new Trade Setup / Setup Ended", group=g_ats)
col_rw = input.color(color.new(#22C55E, 82), "Reward zone", inline="c1", group=g_ats)
col_rk = input.color(color.new(#EF4444, 82), "Risk zone", inline="c1", group=g_ats)
col_rw2 = input.color(color.new(#22C55E, 90), "Reward zone 2", inline="c2", group=g_ats)
col_rk2 = input.color(color.new(#EF4444, 90), "Risk zone 2", inline="c2", group=g_ats)
pk_sl1 = input.string("Automatic (nearest)", "Stop level", options=["Automatic (nearest)", "R3", "R2", "R1", "PP", "S1", "S2", "S3", "YD-H", "YD-L", "PMH", "PML", "Piv-H", "Piv-L", "EQH", "EQL", "EMA 200", "VWAP"], group=g_ats)
pk_tp1 = input.string("Automatic (nearest)", "Target level", options=["Automatic (nearest)", "R3", "R2", "R1", "PP", "S1", "S2", "S3", "YD-H", "YD-L", "PMH", "PML", "Piv-H", "Piv-L", "EQH", "EQL", "EMA 200", "VWAP"], group=g_ats)
show_tp2 = input.bool(true, "Show TP2", inline="s2", group=g_ats)
show_sl2 = input.bool(true, "Show SL2", inline="s2", group=g_ats)
pk_sl2 = input.string("Automatic (nearest)", "SL2 level", options=["Automatic (nearest)", "R3", "R2", "R1", "PP", "S1", "S2", "S3", "YD-H", "YD-L", "PMH", "PML", "Piv-H", "Piv-L", "EQH", "EQL", "EMA 200", "VWAP"], group=g_ats)
pk_tp2 = input.string("Automatic (nearest)", "TP2 level", options=["Automatic (nearest)", "R3", "R2", "R1", "PP", "S1", "S2", "S3", "YD-H", "YD-L", "PMH", "PML", "Piv-H", "Piv-L", "EQH", "EQL", "EMA 200", "VWAP"], group=g_ats)
keep_old = input.bool(true, "Keep previous setup when a new one fires", group=g_ats)
min_sl_on = input.bool(true, "Minimum SL distance (pts)", inline="msl", group=g_ats)
min_sl = input.float(4.0, "", minval=0.0, step=0.25, inline="msl", group=g_ats)
atr_sl_on = input.bool(false, "SL method: ATR (instead of pivots)", group=g_ats, tooltip="ATR of the chart timeframe.")
atr_len = input.int(14, "ATR length / SL1 x / SL2 x", inline="atr", group=g_ats)
atr_m1 = input.float(1.0, "", inline="atr", group=g_ats)
atr_m2 = input.float(1.5, "", inline="atr", group=g_ats)
atr_tp_on = input.bool(false, "TP method: ATR (instead of pivots)", group=g_ats)
atr_t1 = input.float(1.5, "TP1 x / TP2 x", inline="atrtp", group=g_ats)
atr_t2 = input.float(3.0, "", inline="atrtp", group=g_ats)
eod_end = input.bool(true, "End setups at 17:00 ET", group=g_ats)
tbl_show = input.bool(true, "Show Trade Levels box", inline="tbl", group=g_ats)
tbl_pos = input.string("Top right", "", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], inline="tbl", group=g_ats)
tbl_size = input.string("Normal", "", options=["Tiny", "Small", "Normal", "Large", "Huge"], inline="tbl", group=g_ats)
rr_pos = input.string("Middle right", "R:R table position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=g_ats)

g_flt = "Trade Setup Filters"
f_chop_on = input.bool(false, "Block in chop: Choppiness Index above", inline="f1", group=g_flt)
f_chop_max = input.float(61.8, "", inline="f1", group=g_flt)
f_chop_len = input.int(14, "Choppiness length", minval=2, group=g_flt)
f_ext_on = input.bool(false, "Block when stretched from VWAP: more than (x ATR)", inline="f2", group=g_flt)
f_ext_max = input.float(3.0, "", minval=0.1, step=0.1, inline="f2", group=g_flt)
f_flip_on = input.bool(false, "Block after frequent CBC flips: flips >=", inline="f3", group=g_flt)
f_flip_n = input.int(2, "", minval=1, inline="f3", group=g_flt)
f_flip_win = input.int(8, "in last candles", minval=1, inline="f3", group=g_flt)

g_lv = "Levels (TP/SL pool)"
sh_pp = input.bool(true, "PP", inline="p1", group=g_lv)
sh_r1 = input.bool(true, "R1", inline="p1", group=g_lv)
sh_s1 = input.bool(true, "S1", inline="p1", group=g_lv)
sh_r2 = input.bool(true, "R2", inline="p2", group=g_lv)
sh_s2 = input.bool(true, "S2", inline="p2", group=g_lv)
sh_r3 = input.bool(true, "R3", inline="p3", group=g_lv)
sh_s3 = input.bool(true, "S3", inline="p3", group=g_lv)
sh_yd = input.bool(true, "YD High / Low", group=g_lv)
sh_pm = input.bool(true, "Premarket High / Low", group=g_lv)
sh_ny = input.bool(true, "NY Opening Range H / L", group=g_lv)
sh_ln = input.bool(true, "London Opening Range H / L", group=g_lv)
sh_as = input.bool(true, "Asia Opening Range H / L", group=g_lv)
sh_sw = input.bool(true, "Swing Pivot High / Low (chart timeframe)", group=g_lv)
piv_n = input.int(1, "Swing pivot N (bars left/right)", minval=1, group=g_lv)
sh_eq = input.bool(true, "Equal High / Low (EQH / EQL)", group=g_lv)
eq_mult = input.float(0.10, "EQH/EQL tolerance (x ATR 14)", minval=0.0, step=0.01, group=g_lv)
sh_e200 = input.bool(true, "EMA 200", inline="ev", group=g_lv)
sh_vw = input.bool(true, "VWAP", inline="ev", group=g_lv)
show_pool = input.bool(true, "Draw pool levels on the chart", group=g_lv)
or_minutes = input.int(30, "Opening range minutes", minval=1, group=g_lv)

g_al = "Alerts"
al_flip = input.bool(true, "CBC Flip (Long/Short)", group=g_al)
al_pierce = input.bool(true, "EMA9 / EMA20 Pierce - Entry", group=g_al)
al_pb = input.bool(true, "Pullback Entry - Structure Confirmed", group=g_al)
al_zone = input.bool(true, "Price Enters EMA9/20 Zone - Entry", group=g_al)
al_touch = input.bool(true, "EMA20 Touch - Pullback Entry", group=g_al)
al_e200 = input.bool(false, "EMA 200 Break (Bullish/Bearish)", group=g_al)
al_cross = input.bool(false, "EMA9/20 Cross (Bullish/Bearish)", group=g_al)
pullback_only = input.bool(true, "Pierce/Touch: pullbacks only (price must come from the trade side)", group=g_al)
ses_as = input.bool(true, "Asian", inline="sa", group=g_al)
win_as = input.session("1800-2230", "", inline="sa", group=g_al)
ses_ln = input.bool(true, "London", inline="sl", group=g_al)
win_ln = input.session("0300-0745", "", inline="sl", group=g_al)
ses_ny = input.bool(true, "New York", inline="sn", group=g_al)
win_ny = input.session("0930-1700", "", inline="sn", group=g_al)

g_dis = "Display"
show_ema = input.bool(true, "EMA9 / EMA20 cloud", group=g_dis)
show_e200 = input.bool(true, "EMA 200 line", group=g_dis)
show_vw = input.bool(true, "VWAP line", group=g_dis)
show_flip = input.bool(true, "CBC Flip triangles", group=g_dis)
show_mk = input.bool(true, "Pierce / Pullback markers", group=g_dis)
show_flop = input.bool(true, "Label potential flop flips", group=g_dis)

// ============================== CORE SERIES ==============================
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema200 = ta.ema(close, 200)
vwap_v = ta.vwap(hlc3)
float atr_v = ta.atr(atr_len)
p9 = plot(show_ema ? ema9 : na, "EMA9", color=color.new(#22C55E, 0))
p20 = plot(show_ema ? ema20 : na, "EMA20", color=color.new(#EF4444, 0))
fill(p9, p20, color=ema9 >= ema20 ? color.new(#22C55E, 75) : color.new(#EF4444, 75), title="EMA cloud")
plot(show_e200 ? ema200 : na, "EMA200", color=color.new(#FACC15, 0), linewidth=2)
plot(show_vw ? vwap_v : na, "VWAP", color=color.new(#7E22CE, 0), linewidth=2)

// CBC state (same rule as CBC v8.80): strict breaks of the prior bar
f_cbc_state() =>
    var bool state = false
    state := state[1]
    if state and close < low[1]
        state := false
    if not state and close > high[1]
        state := true
    state
cbc = f_cbc_state()
var bool cbc_c = false
if barstate.isconfirmed
    cbc_c := cbc
bool dir_bull = cbc_c
bool dir_bear = not cbc_c
bool flip_bull = barstate.isconfirmed and cbc and not cbc[1]
bool flip_bear = barstate.isconfirmed and not cbc and cbc[1]
bool any_flip = flip_bull or flip_bear

var bool flip_away = false
var int flip_bar = na
var int flip_t_open = na
var int flip_t_close = na
var float flip_lo = na
var float flip_hi = na
var bool last_flip_bull = false
if any_flip
    flip_away := flip_bull ? close > ema20 : close < ema20
    flip_bar := bar_index
    flip_t_open := time
    flip_t_close := time_close
    flip_lo := low
    flip_hi := high
    last_flip_bull := flip_bull
int bsf = na(flip_bar) ? na : bar_index - flip_bar + 1
bool flip_ok = allow_toward or flip_away

if show_flip and any_flip
    label.new(bar_index, flip_bull ? low - (high - low) * 0.15 : high + (high - low) * 0.15, "", color=flip_bull ? #15FF00 : #FF1500, style=flip_bull ? label.style_triangleup : label.style_triangledown, size=size.small, tooltip=syminfo.ticker + " —\n• " + s_ch + " CBC Flip: " + (flip_bull ? "LONG" : "SHORT") + (flip_away ? "" : " (TOWARD)") + "\nFired: " + obLib.f_fmt_ny_time_sec(time_close))

// ============================== LEVELS ==============================
[pv_h, pv_l, pv_c] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
float pv_rng = pv_h - pv_l
float piv_pp = (pv_h + pv_l + pv_c) / 3
float piv_r1 = 2 * piv_pp - pv_l
float piv_s1 = 2 * piv_pp - pv_h
float piv_r2 = piv_pp + pv_rng
float piv_s2 = piv_pp - pv_rng
float piv_r3 = pv_h + 2 * (piv_pp - pv_l)
float piv_s3 = pv_l - 2 * (pv_h - piv_pp)
float[] piv_arr = array.from(piv_r3, piv_r2, piv_r1, piv_pp, piv_s1, piv_s2, piv_s3)
bool[] piv_en = array.from(sh_r3, sh_r2, sh_r1, sh_pp, sh_s1, sh_s2, sh_s3)

// yesterday's RTH high/low, premarket high/low (same sessions as CBC v8.80)
bool is_pm = not na(time(timeframe.period, "1800-0929", ny_tz))
bool is_rth = not na(time(timeframe.period, "0930-1600", ny_tz))
bool new_day = is_rth and not is_rth[1]
var float rth_hi = na
var float rth_lo = na
var float YDH = na
var float YDL = na
if not is_rth and is_rth[1]
    YDH := rth_hi
    YDL := rth_lo
if new_day
    rth_hi := high
    rth_lo := low
else if is_rth
    rth_hi := na(rth_hi) ? high : math.max(rth_hi, high)
    rth_lo := na(rth_lo) ? low : math.min(rth_lo, low)
var float pm_hi = na
var float pm_lo = na
var float PMH = na
var float PML = na
if is_pm and not is_pm[1]
    pm_hi := high
    pm_lo := low
else if is_pm
    pm_hi := math.max(nz(pm_hi, high), high)
    pm_lo := math.min(nz(pm_lo, low), low)
if new_day
    PMH := pm_hi
    PML := pm_lo

// opening ranges (first N minutes after 9:30 / 3:00 / 20:00 ET)
int or_ms = or_minutes * 60000
int ny_open = timestamp(ny_tz, year(time, ny_tz), month(time, ny_tz), dayofmonth(time, ny_tz), 9, 30)
int ln_open = timestamp(ny_tz, year(time, ny_tz), month(time, ny_tz), dayofmonth(time, ny_tz), 3, 0)
int as_open = obLib.f_asia_or_open_ms()
bool ny_act = time >= ny_open and time < ny_open + or_ms
bool ln_act = time >= ln_open and time < ln_open + or_ms
bool as_act = time >= as_open and time < as_open + or_ms
var float ORH_NY = na
var float ORL_NY = na
var float ORH_LN = na
var float ORL_LN = na
var float ORH_AS = na
var float ORL_AS = na
if ny_act
    ORH_NY := ny_act[1] ? math.max(ORH_NY, high) : high
    ORL_NY := ny_act[1] ? math.min(ORL_NY, low) : low
if ln_act
    ORH_LN := ln_act[1] ? math.max(ORH_LN, high) : high
    ORL_LN := ln_act[1] ? math.min(ORL_LN, low) : low
if as_act
    ORH_AS := as_act[1] ? math.max(ORH_AS, high) : high
    ORL_AS := as_act[1] ? math.min(ORL_AS, low) : low

// chart-timeframe swing pivots, structure, equal highs/lows
float ph = ta.pivothigh(high, piv_n, piv_n)
float pl = ta.pivotlow(low, piv_n, piv_n)
float eq_tol = ta.atr(14) * eq_mult
var float sw_hi = na
var float sw_lo = na
var float EQH = na
var float EQL = na
var string hi_struct = "—"
var string lo_struct = "—"
if not na(ph)
    if not na(sw_hi)
        hi_struct := ph > sw_hi ? "Higher High" : "Lower High"
        if math.abs(ph - sw_hi) <= eq_tol
            EQH := ph
    sw_hi := ph
if not na(pl)
    if not na(sw_lo)
        lo_struct := pl < sw_lo ? "Lower Low" : "Higher Low"
        if math.abs(pl - sw_lo) <= eq_tol
            EQL := pl
    sw_lo := pl

// ============================== SIGNALS ==============================
var int last_draw = na
bool betw = close >= math.min(ema9, ema20) and close <= math.max(ema9, ema20)
bool betw_enter = betw and not betw[1]
bool pb_long = dir_bull and betw_enter and hi_struct == "Higher High" and lo_struct == "Higher Low" and bsf <= pb_recent and flip_away
bool pb_short = dir_bear and betw_enter and hi_struct == "Lower High" and lo_struct == "Lower Low" and bsf <= pb_recent and flip_away

// EMA pierce (same rules as CBC v8.80 HTF EMA9/20 Pierce, on the chart EMAs)
f_pierce(float lvl, bool on) =>
    var int last_bar = -1000000
    var int arm = na
    var bool arm_l = false
    bool st = not na(lvl) and low <= lvl and high >= lvl
    bool ready = st and not st[1] and bar_index - last_bar > 3 and flip_ok
    bool al = ready and dir_bull and (not pullback_only or low[1] > lvl[1])
    bool ash = ready and dir_bear and (not pullback_only or high[1] < lvl[1])
    if al or ash
        last_bar := bar_index
        arm := bar_index
        arm_l := al
    int age = na(arm) ? -1 : bar_index - arm
    bool live = on and age >= 1 and age <= late_bars and (na(last_draw) or last_draw < arm)
    bool late_l = live and arm_l and dir_bull and close > lvl and (not late_color or close > open)
    bool late_s = live and not arm_l and dir_bear and close < lvl and (not late_color or close < open)
    if age > late_bars
        arm := na
    [on and (al and close > lvl or late_l), on and (ash and close < lvl or late_s), al or ash, al, late_l or late_s]
[e9_l, e9_s, e9_fire, e9_long, e9_late] = f_pierce(ema9, ats_on and t_e9)
[e20_l, e20_s, e20_fire, e20_long, e20_late] = f_pierce(ema20, ats_on and t_e20)
if show_mk and e9_fire
    label.new(bar_index, e9_long ? low : high, "9", yloc=e9_long ? yloc.belowbar : yloc.abovebar, color=e9_long ? #2962FF : #9C27B0, textcolor=color.white, style=e9_long ? label.style_label_up : label.style_label_down, size=size.tiny, tooltip=s_ch + " EMA9 Pierce - " + obLib.f_pierce_word(e9_long, ema9) + "\nEMA9: " + f_n(ema9))
if show_mk and e20_fire
    label.new(bar_index, e20_long ? low : high, "20", yloc=e20_long ? yloc.belowbar : yloc.abovebar, color=e20_long ? #2962FF : #9C27B0, textcolor=color.white, style=e20_long ? label.style_label_up : label.style_label_down, size=size.tiny, tooltip=s_ch + " EMA20 Pierce - " + obLib.f_pierce_word(e20_long, ema20) + "\nEMA20: " + f_n(ema20))
if show_mk and (pb_long or pb_short)
    label.new(bar_index, pb_long ? low : high, "PB", yloc=pb_long ? yloc.belowbar : yloc.abovebar, color=#F59E0B, textcolor=color.black, style=pb_long ? label.style_label_up : label.style_label_down, size=size.tiny, tooltip=s_ch + " Pullback Entry - Structure Confirmed: " + (pb_long ? "LONG" : "SHORT"))

// EMA20 touch (pullback against the CBC direction, at most every other candle)
var int touch_last = -1000000
bool touch20 = not na(ema20) and low <= ema20 and high >= ema20 and ((dir_bull and close < close[1] and (not pullback_only or low[1] > ema20[1])) or (dir_bear and close > close[1] and (not pullback_only or high[1] < ema20[1]))) and bar_index - touch_last > 1
if touch20
    touch_last := bar_index
bool e200_up = close > ema200 and close[1] <= ema200[1]
bool e200_dn = close < ema200 and close[1] >= ema200[1]
bool x_up = ta.crossover(ema9, ema20)
bool x_dn = ta.crossunder(ema9, ema20)

// potential flop: levels inside the flip candle's range
string flop_txt = obLib.f_flop(any_flip, flip_bull, show_flop, low, high, ema200, vwap_v, piv_pp, piv_r1, piv_r2, piv_r3, piv_s1, piv_s2, piv_s3)

// ============================== SETUP ENGINE (ESLib/18, same as CBC v8.80) ==============================
var float[] cand = array.new_float(0)
var string[] cand_nm = array.new_string(0)
if ats_on
    cand := obLib.f_ats_build_candidates(piv_arr, piv_en, YDH, sh_yd, YDL, sh_yd, PMH, sh_pm, PML, sh_pm, sw_hi, sh_sw, sw_lo, sh_sw, EQH, sh_eq, EQL, sh_eq, float(na), false, float(na), false, ema200, sh_e200, vwap_v, sh_vw, ORH_NY, sh_ny, ORL_NY, sh_ny, ORH_LN, sh_ln, ORL_LN, sh_ln, ORH_AS, sh_as, ORL_AS, sh_as, false, false, false, false, cand_nm)
    // chart-timeframe pivots are named Piv-H / Piv-L / EQH / EQL here (the library calls them "HTF ...")
    if array.size(cand_nm) > 0
        for i = 0 to array.size(cand_nm) - 1
            if str.startswith(array.get(cand_nm, i), "HTF ")
                array.set(cand_nm, i, str.substring(array.get(cand_nm, i), 4))
f_pk(string s) => s == "Piv-H" ? "HTF Piv-H" : s == "Piv-L" ? "HTF Piv-L" : s == "EQH" ? "HTF EQH" : s == "EQL" ? "HTF EQL" : s

// VWAP (slot 7) and R1-R3 / S1-S3 (slots 0-6, PP skipped) reclaim against the CBC direction
f_x(float l) => [close > l and close[1] <= l[1], close < l and close[1] >= l[1]]
[u0, d0] = f_x(piv_r3)
[u1, d1] = f_x(piv_r2)
[u2, d2] = f_x(piv_r1)
[u4, d4] = f_x(piv_s1)
[u5, d5] = f_x(piv_s2)
[u6, d6] = f_x(piv_s3)
[u7, d7] = f_x(vwap_v)
bool[] xu_arr = array.from(u0, u1, u2, false, u4, u5, u6, u7)
bool[] xd_arr = array.from(d0, d1, d2, false, d4, d5, d6, d7)
var int[] rc_st = array.new_int(8, 0)
var int rc_b = na
for k = 0 to 7
    bool xu = array.get(xu_arr, k)
    bool xd = array.get(xd_arr, k)
    int st = array.get(rc_st, k)
    if (k == 7 ? vw_blk_on : pv_blk_on and k != 3) and ((xu and st == -1) or (xd and st == 1))
        rc_b := st * bar_index
    array.set(rc_st, k, any_flip ? 0 : xd and dir_bear ? -1 : xu and dir_bull ? 1 : xu or xd ? 0 : st)
bool rc_blk = not na(rc_b) and bar_index - math.abs(rc_b) <= vw_blk_n

int flip_win = flip_wait_on ? flip_win_in : 0
int flip_pb = obLib.f_ats_flip_pb(ats_on and t_flip and flip_bull and flip_ok, ats_on and t_flip and flip_bear and flip_ok, flip_win, float(na), float(na), ema20, dir_bull, dir_bear, last_draw, flip_two_step)
bool tf_l = flip_win == 0 ? ats_on and t_flip and flip_bull and flip_ok : flip_pb > 0
bool tf_s = flip_win == 0 ? ats_on and t_flip and flip_bear and flip_ok : flip_pb < 0
bool tpb_l = ats_on and t_pb and pb_long and flip_ok
bool tpb_s = ats_on and t_pb and pb_short and flip_ok
float[] flt = obLib.f_ats_filters(vwap_v, atr_v, f_chop_on, f_chop_max, f_chop_len, f_ext_on, f_ext_max, any_flip, f_flip_on, f_flip_n, f_flip_win, timeframe.period)
int momo = obLib.f_ats_momo(ats_on and t_momo and flip_ok, sw_hi, sw_lo, dir_bull, dir_bear)
bool trig_l = ats_on and not (rc_blk and rc_b > 0) and array.get(flt, 0) > 0 and (tf_l or e9_l or e20_l or tpb_l or momo > 0)
bool trig_s = ats_on and not (rc_blk and rc_b < 0) and array.get(flt, 1) > 0 and (tf_s or e9_s or e20_s or tpb_s or momo < 0)
bool cool_ok = na(last_draw) or bar_index - last_draw >= 3 or tf_l or tf_s
int hm_close = hour(time_close, ny_tz) * 60 + minute(time_close, ny_tz)
bool eod = eod_end and hm_close >= 1020 and hm_close[1] < 1020
float msl = min_sl_on ? min_sl : 0.0
float[] call = array.new_float(5, na)
bool new_setup = obLib.f_ats_compute_trigger(trig_l, trig_s, cool_ok and not eod and barstate.isconfirmed, close, f_pk(pk_sl1), f_pk(pk_tp1), f_pk(pk_sl2), f_pk(pk_tp2), cand, piv_r3, piv_r2, piv_r1, piv_pp, piv_s1, piv_s2, piv_s3, YDH, YDL, PMH, PML, sw_hi, sw_lo, EQH, EQL, float(na), float(na), ema200, vwap_v, flip_lo, flip_hi, 0.0, 0.0, 0.0, 0.0, show_tp2, show_sl2, call)
var float[] alt = array.new_float(13, na)
if new_setup
    last_draw := bar_index
    alt := obLib.f_ats_atr_lv(call, atr_v, atr_m1, atr_m2, atr_t1, atr_t2, atr_sl_on, atr_tp_on, msl)
    obLib.f_ats_min_sl_call(call, msl)
string flip_box = na(flip_t_close) ? "" : "CBC (" + s_tf + ") Flip " + (last_flip_bull ? "Long " : "Short ") + f_hm(flip_t_open) + "-" + f_hm(flip_t_close) + " - " + str.tostring(bsf)
var float[] st_arr = array.new_float(7, na)
if ats_on
    st_arr := obLib.f_ats_draw_setup(new_setup, array.get(call, 0), array.get(call, 1), array.get(call, 2), col_rw, col_rk, show_tp2 or show_sl2, array.get(call, 3), array.get(call, 4), col_rw2, col_rk2, 0.0, 0.0, 0.0, 0.0, obLib.f_aplus_pivot_dist(0.0), cand, tbl_show, tbl_pos, tbl_size, cand_nm, dir_bull or eod, dir_bear or eod, pk_tp1 == "Automatic (nearest)" and not atr_tp_on, pk_sl1 == "Automatic (nearest)" and not atr_sl_on, pk_tp2 == "Automatic (nearest)" and not atr_tp_on, pk_sl2 == "Automatic (nearest)" and not atr_sl_on, keep_old, flip_box, last_flip_bull, msl, rr_pos, alt, atr_sl_on, atr_tp_on)

// pool levels on the chart (last bar only)
var line[] pool_ln = array.new_line()
var label[] pool_lb = array.new_label()
if barstate.islast
    while array.size(pool_ln) > 0
        line.delete(array.pop(pool_ln))
    while array.size(pool_lb) > 0
        label.delete(array.pop(pool_lb))
    if show_pool and ats_on and array.size(cand) > 0
        for i = 0 to array.size(cand) - 1
            float v = array.get(cand, i)
            if not na(v)
                array.push(pool_ln, line.new(bar_index - 30, v, bar_index + 5, v, color=color.new(color.gray, 40), style=line.style_dotted))
                array.push(pool_lb, label.new(bar_index + 5, v, array.get(cand_nm, i) + " " + f_n(v), style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.gray, size=size.tiny))

// ============================== ALERTS ==============================
bool ses_ok = ses_as and not na(time(timeframe.period, win_as, ny_tz)) or ses_ln and not na(time(timeframe.period, win_ln, ny_tz)) or ses_ny and not na(time(timeframe.period, win_ny, ny_tz))
string a_mkt = obLib.f_market_session_et()
float or_hi = a_mkt == "Asian" ? ORH_AS : a_mkt == "London" ? ORH_LN : ORH_NY
float or_lo = a_mkt == "Asian" ? ORL_AS : a_mkt == "London" ? ORL_LN : ORL_NY
string a_or = na(or_hi) ? "Pending" : close > or_hi ? "Above range" : close < or_lo ? "Below range" : "Inside range"
f_fav(float lv) => na(lv) ? "—" : ((cbc ? close > lv : close < lv) ? "Favorable" : "Against") + " (" + f_n(lv) + ", " + f_s(cbc ? close - lv : lv - close) + ")"
string snap = "Time: " + obLib.f_fmt_ny_time_sec(time_close) + "\nMarket: " + a_mkt + "\nChart: " + syminfo.ticker + " " + s_tf + "\nPrice: " + f_n(close) + "\nCBC (" + s_tf + "): " + (cbc ? "Bullish" : "Bearish") + "\nEMA cloud (" + s_tf + "): " + (ema9 >= ema20 ? "Bullish" : "Bearish") + "\nVWAP: " + f_fav(vwap_v) + "\nEMA 200: " + f_fav(ema200) + "\nStructure (" + s_tf + "): " + obLib.f_struct_abbrev(hi_struct) + " / " + obLib.f_struct_abbrev(lo_struct) + "\nOpening range: " + a_or + (flop_txt == "" ? "" : "\nFlip flop: crossed " + flop_txt) + (flip_away ? "" : "\nFlip side: TOWARD") + obLib.f_ats_state_msg(st_arr, cand, cand_nm, ats_alert_on, dir_bull, dir_bear)
string flip_line = na(flip_t_close) ? "" : "HTF (" + s_tf + ") flip: " + (last_flip_bull ? "LONG " : "SHORT ") + f_hm(flip_t_close) + " · " + str.tostring(bsf) + " bars ago"

// signal alerts: every bullet that fired on this closed candle, in one message
if barstate.isconfirmed and ses_ok
    string m = ""
    string b = "• " + s_ch + " "
    if al_flip and any_flip
        m += b + "CBC Flip: " + (flip_bull ? "LONG" : "SHORT") + (flip_away ? "" : " (toward EMA20)") + "\n"
    if al_pierce and e9_fire
        m += b + "EMA9 Pierce - " + obLib.f_pierce_word(e9_long, ema9) + "\n"
    if al_pierce and e20_fire
        m += b + "EMA20 Pierce - " + obLib.f_pierce_word(e20_long, ema20) + "\n"
    if al_pb and (pb_long or pb_short)
        m += b + "Pullback Entry - Structure Confirmed: " + (pb_long ? "LONG" : "SHORT") + "\n"
    if al_zone and betw_enter and flip_away and not (pb_long or pb_short)
        m += b + "Price Enters EMA9/20 Zone: " + (dir_bull ? "LONG" : "SHORT") + "\n"
    if al_touch and touch20
        m += b + "EMA20 Touch - Pullback Entry: " + (dir_bull ? "LONG" : "SHORT") + "\n"
    if al_e200 and (e200_up or e200_dn)
        m += b + "EMA 200 Break: " + (e200_up ? "Bullish (crossed above" : "Bearish (crossed below") + " EMA200)\n"
    if al_cross and (x_up or x_dn)
        m += b + "EMA9/20 Cross: " + (x_up ? "Bullish (crossed above)" : "Bearish (crossed below)") + "\n"
    if m != ""
        alert(syminfo.ticker + " —\n" + m + "\n" + snap, alert.freq_once_per_bar_close)

// Trade Setup alert (same line format as CBC v8.80 so the Alert Feed table parser works)
if ats_alert_on and new_setup and ses_ok
    bool lg = array.get(call, 2) > array.get(call, 0)
    string why = ""
    if lg ? tf_l : tf_s
        why += flip_win == 0 ? "CBC Flip, " : "CBC Flip (pullback, " + str.tostring(math.abs(flip_pb)) + " bars after), "
    if lg ? e9_l : e9_s
        why += e9_late ? "EMA9 Pierce (late), " : "EMA9 Pierce, "
    if lg ? e20_l : e20_s
        why += e20_late ? "EMA20 Pierce (late), " : "EMA20 Pierce, "
    if lg ? tpb_l : tpb_s
        why += "Pullback Structure, "
    if momo == (lg ? 1 : -1)
        why += "Momentum break, "
    why := str.length(why) > 2 ? str.substring(why, 0, str.length(why) - 2) : "Setup"
    alert(syminfo.ticker + " —\n• " + s_ch + " Trade Setup: " + (lg ? "LONG" : "SHORT") + "\nTrigger: " + s_tf + " " + why + obLib.f_ats_flt_txt(flt, lg, f_flip_win) + "\n" + obLib.f_ats_lv_lines(call, alt, cand, cand_nm, msl, atr_sl_on, atr_tp_on) + (flip_line == "" ? "" : flip_line + "\n") + "\n" + snap, alert.freq_once_per_bar)

// Setup Ended alert
bool s_lg = array.get(call, 2) > array.get(call, 0)
float s_tp3 = na(array.get(call, 4)) ? float(na) : s_lg ? obLib.f_ats_nearest_above(array.get(call, 4), cand) : obLib.f_ats_nearest_below(array.get(call, 4), cand)
float s_tp4 = na(s_tp3) ? float(na) : s_lg ? obLib.f_ats_nearest_above(s_tp3, cand) : obLib.f_ats_nearest_below(s_tp3, cand)
string end_msg = obLib.f_ats_track(new_setup, array.get(call, 0), array.get(call, 1), array.get(call, 2), array.get(call, 4), s_tp3, s_tp4, dir_bull, dir_bear, eod, syminfo.ticker, s_tf)
if end_msg != "" and ats_alert_on and ses_ok
    alert(str.replace(end_msg, "• Setup Ended:", "• " + s_ch + " Setup Ended:"), alert.freq_once_per_bar)
