// ===========================
// CBC agreement bar colors — small color-key legend (only meaningful while show_bar_coloring is on)
// ===========================
var table cbc_legend_tbl = na
var string cbc_legend_pos_last = ""

if barstate.islast
    if not (show_bar_coloring and show_cbc_legend)
        table.delete(cbc_legend_tbl)
        cbc_legend_tbl := na
        cbc_legend_pos_last := ""
    else
        if not na(cbc_legend_tbl) and cbc_legend_pos_last != cbc_legend_position
            table.delete(cbc_legend_tbl)
            cbc_legend_tbl := na
        if na(cbc_legend_tbl)
            cbc_legend_tbl := table.new(obLib.f_status_pos(cbc_legend_position), 2, 4, bgcolor=color.new(#020617, 0), border_color=tbl_border, border_width=1, frame_color=tbl_frame, frame_width=2)
            table.merge_cells(cbc_legend_tbl, 0, 0, 1, 0)
            cbc_legend_pos_last := cbc_legend_position
        cbc_legend_txt_sz = obLib.f_table_text_size(cbc_legend_text_size)
        table.cell(cbc_legend_tbl, 0, 0, "CBC Agreement Colors", bgcolor=tbl_header_bg, text_color=txt_head, text_size=cbc_legend_txt_sz, text_halign=text.align_center)
        // v6.26 (CE10117 trim): same loop-over-arrays technique just applied to Marker Key — 6 unrolled
        // table.cell calls collapsed to 2 inside a loop. No display change.
        for li = 0 to 2
            table.cell(cbc_legend_tbl, 0, li + 1, "", bgcolor=array.get((array.from(col_cbc_bar_long, col_cbc_bar_short, col_cbc_bar_neutral)), li))
            table.cell(cbc_legend_tbl, 1, li + 1, array.get((array.from("Long agreement", "Short agreement", "No agreement")), li), bgcolor=tbl_label_bg, text_color=txt_on, text_size=cbc_legend_txt_sz, text_halign=text.align_left)

// ===========================
// Marker Key — small legend table defining each of the 6 on-chart alert marker symbols
// ===========================
var table marker_key_tbl = na
var string marker_key_pos_last = ""

if barstate.islast
    if not show_marker_key
        table.delete(marker_key_tbl)
        marker_key_tbl := na
        marker_key_pos_last := ""
    else
        if not na(marker_key_tbl) and marker_key_pos_last != marker_key_position
            table.delete(marker_key_tbl)
            marker_key_tbl := na
        if na(marker_key_tbl)
            marker_key_tbl := table.new(obLib.f_status_pos(marker_key_position), 2, 8, bgcolor=color.new(#020617, 0), border_color=tbl_border, border_width=1, frame_color=tbl_frame, frame_width=2)
            table.merge_cells(marker_key_tbl, 0, 0, 1, 0)
            marker_key_pos_last := marker_key_position
        marker_key_txt_sz = obLib.f_table_text_size(cbc_legend_text_size)
        table.cell(marker_key_tbl, 0, 0, "Marker Key", bgcolor=tbl_header_bg, text_color=txt_head, text_size=marker_key_txt_sz, text_halign=text.align_center)
        // v6.25 (CE10117 trim): 12 unrolled table.cell calls collapsed into a 2-call loop over parallel
        // arrays — same "repetitive statements -> single loop" pattern f_render_confluence_cells()
        // already uses. Compiled size counts the loop body once regardless of how many times it runs at
        // runtime, unlike 12 separate hardcoded calls. No display change — same symbols, same order.
        // v6.36: 7th entry ("K" / Key Level Alert) appended for the new pivot-cross marker.
        // v6.37: relabeled to match the new leader-line letters (A/H/V/C/L unchanged from ◆/Z/✕/H/E's
        // old meanings, just new letters — HTF CBC Flip's ● stays a plain dot, K unchanged).
        // v6.57: "HTF CBC Flip" row label now notes the two dot shades (solid = confirmed, faint =
        // v6.52's anticipatory 99%-elapsed dot) directly in the legend, per direct follow-up ("did you
        // add this to the marker definitions") — previously only explained in chat, not on-chart.
        // v6.59: "HTF CBC Flip" row label now also notes the gold reversal-bar color, per direct
        // follow-up ("so it is a htf reversal? gold dot" / "is this in the marker key?") — previously
        // only the solid/faint (confirmed/anticipatory) distinction was documented in the legend; the
        // separate gold-on-the-flip-bar override (marker_fill, reused from the LTF Reversal triangles'
        // own #F9CB00) had no mention here at all.
        // v6.60: that same label now wraps onto 2 lines via an embedded "\n" (table.cell text supports
        // line breaks the same way label tooltips do), per direct request ("wrap text of the line info
        // into two rows to reduce width") — the single long line was forcing the whole Marker Key
        // table wider than the other 6 rows need. Text itself unchanged, just split after the comma
        // following "solid=confirmed," so the column now sizes to the longest of the two shorter lines
        // instead of the one long one; the row itself just grows taller to fit both lines. No other
        // Marker Key row touched.
        for i = 0 to 6
            table.cell(marker_key_tbl, 0, i + 1, array.get((array.from("A", "H", "V", "C", "●", "L", "R1")), i), bgcolor=tbl_label_bg, text_color=txt_on, text_size=marker_key_txt_sz, text_halign=text.align_center)
            table.cell(marker_key_tbl, 1, i + 1, array.get((array.from("A+ Setup", "Price Enters HTF EMA9/20 Zone", "VWAP Bounce - High R:R", "High Confluence Setup", "HTF CBC Flip (solid=confirmed,\nfaint=anticipatory, gold=reversal bar)", "LTF EMA20 Pierce - Entry", "Key Level Alert - shows the actual\nlevel (PP/R1-3/S1-3) crossed")), i), bgcolor=tbl_label_bg, text_color=txt_on, text_size=marker_key_txt_sz, text_halign=text.align_left)

