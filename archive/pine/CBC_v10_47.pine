// ===========================
// v3.75 addition: Confluence Score (Chop Detection and Scaling Alerts were cut in the
// token-trimming pass — the base script was already near Pine's CE10117 ceiling)
// ===========================
confluence_alert_threshold = input.int(5, "Alert threshold (score ≥)", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Default 5 as of v7.31's scoring redesign (HTF CBC=3, all other included factors=1 each) — see the per-factor weighting notes on the factor toggles above.")
alert_on_confluence = input.bool(true, "Alert: High Confluence Setup", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Fires once when score newly reaches the threshold.")
// v6.34: per direct request ("is there a way to have the H one candle earlier") — the HTF factor
// normally only counts once the HTF bar fully closes/confirms, which is why High Confluence Setup can
// lag a full LTF bar behind an HTF flip that's obviously already happened. Off by default: turning
// this on lets the HTF factor (and so the score/marker) use the live, still-forming HTF CBC reading
// once the HTF bar is at least 98% elapsed (htf_conf_late_window above) instead of always waiting for
// confirmation. Narrowed to "last 2%" per follow-up, to keep the revert-before-close risk small.
confluence_htf_early = input.bool(false, "HTF factor: allow early/unconfirmed in last 2% of HTF bar", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="When on, the confluence score's HTF factor (and the High Confluence Setup marker) can reflect the live/still-forming HTF CBC state once the HTF bar is at least 98% elapsed, instead of always waiting for the HTF bar to fully close/confirm. Can occasionally revert if price flips back in that last sliver before the HTF bar closes.")
confluence_recency_ltf_bars = input.int(10, "Zone/Sweep Factors: Valid Within N LTF Bars of HTF Flip", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="The Zone (BRSG/FVG) and Liquidity Sweep factors below only count while this many LTF bars or fewer have passed since the HTF flip they're anchored to — keeps a stale, long-past zone/sweep from still contributing to the score.")
confluence_use_flip = input.bool(false, "Include Flip (LTF) in score", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Off by default, per follow-up. When off, this factor is excluded from the Confluence Score entirely — its ✓/✗ line is omitted from the alert breakdown and the score denominator drops by 1.")
confluence_use_level = input.bool(false, "Include Level in score", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Off by default, per follow-up (same treatment as Flip (LTF) above). When off, this factor is excluded from the Confluence Score entirely — its ✓/✗ line is omitted from the alert breakdown and the score denominator drops by 1.")
confluence_use_structure_break = input.bool(false, "Include HTF Structure Break (BOS/CHoCH) in score [legacy]", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31: superseded by 'Structure HTF' below (same status-table HH/HL-or-LH/LL reading) and defaulted OFF as part of the scoring redesign. Kept only so the underlying toggle/booleans still exist for reference; no longer counted in the score regardless of this setting's value unless you re-add it yourself.")
confluence_use_htf_ema = input.bool(true, "Include HTF EMA Cloud in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 scoring redesign: this is the single 'EM Cloud HTF' / 'HTF EMA Cloud' factor (the two were confirmed to be the same factor) — checks the HTF's own EMA9/20 cloud direction against CBC direction. Default ON.")
confluence_use_htf_cbc = input.bool(true, "Include HTF CBC in score (weight 3)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 scoring redesign: HTF CBC direction agreement, now its own toggle (previously always counted). Weight 3. Default ON.")
confluence_use_zone = input.bool(true, "Include Zone (BRSG/FVG) in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 scoring redesign: price inside the BRSG zone or an unfilled HTF FVG on the flip's side, now its own toggle (previously always counted, previously weight 2). Weight 1. Default ON.")
confluence_use_sweep = input.bool(true, "Include Sweep in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 scoring redesign: Liquidity Sweep, now its own toggle (previously always counted). Weight 1. Default ON.")
confluence_use_structure_htf = input.bool(true, "Include Structure HTF in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 new factor: reuses the exact HH/HL-or-LH/LL classification already shown in the Status table's HTF Structure row (htf_hi_struct/htf_lo_struct) — scores 1 point when that HTF structure reading agrees with the current CBC HTF direction (Higher High + Higher Low when bullish, Lower High + Lower Low when bearish). Weight 1. Default ON.")
confluence_use_ltf_ema20_pierce = input.bool(true, "Include LTF EMA20 Pierce in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 new factor: reuses the existing LTF EMA20 Pierce state (price wicking through the chart's own EMA20 this bar) already used for the LTF EMA20 Pierce marker/alert. Weight 1. Default ON.")
confluence_use_htf_between = input.bool(true, "Include Price in HTF EMA9/20 Zone in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31 new factor: reuses the existing 'price between the HTF's EMA9 and EMA20' state already used for the Price Enters HTF EMA9/20 Zone marker/alert. Weight 1. Default ON.")
confluence_use_volume = input.bool(false, "Include HTF Flip Volume Spike in score", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Off by default, per follow-up. When off, this factor is excluded from the Confluence Score entirely — its ✓/✗ line is omitted from the alert breakdown and the score denominator drops by 1.")
confluence_vol_mult = input.float(1.5, "Volume Spike: Flip Candle Volume ≥ N × Average", minval=1.0, step=0.1, group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="How many times the HTF flip candle's own volume must exceed its trailing average (below) to count as a genuine volume spike — real participation, not a low-volume drift-through flip.")
htf_vol_avg_len = input.int(20, "Volume Spike: HTF Bars for Average", minval=2, group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="How many prior HTF bars feed the trailing average volume used for the spike comparison above.")
confluence_use_htf_flip = input.bool(false, "Include HTF Flip within last 4 candles in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31: redefined per scoring redesign — true whenever the current HTF flip happened 4 or fewer HTF bars ago (was previously based on an unfilled Fair Value Gap). Off by default, per direct request.")
confluence_use_fib = input.bool(true, "Include Fib Golden Pocket (50%-61.8%) in score (weight 1)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v7.31: defaulted ON per scoring redesign. Price wicks into the 50%-61.8% retracement zone of the last confirmed HTF swing (same swing used by Liquidity Sweep), within the same recency window as Zone/Sweep above. When off, excluded from the score entirely. Also shown as its own always-visible Status table row regardless of this toggle.")
show_fib_zone_box = input.bool(false, "Show Fib Zone box on chart (old, over the candles)", inline="fibbox", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Draws a small shaded horizontal zone at the 50%-61.8% retracement levels, anchored near the current bar, with the price levels printed as text inside it. Green when price is currently touching the zone (matches the Fib Golden Pocket factor's raw touch state), gray otherwise. Independent of the Fib Zone Status table row and of the Include-in-score toggle above — this is purely a chart visual.")
show_fib_side = input.bool(true, "Fib zone to the right of price", inline="fibside", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v10.34: the 50%-61.8% zone drawn as a small block in the empty space RIGHT of the last candle (2-16 bars ahead), never over the candles. Text: \"Fib 15m 50 / 61.8  IN\". Green border when price is inside the zone, gray otherwise.")
show_fib_lines = input.bool(true, "Fib 50 / 61.8 dotted lines", inline="fibside", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="v10.34: two thin dotted lines at the 50% and 61.8% levels across the last N bars (same width as the box above), no fill, so the candles stay readable. Green when price is in the zone, gray otherwise.")
fib_zone_box_bars = input.int(20, "width (bars)", minval=2, inline="fibbox", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━")
show_fib_01_lines = input.bool(true, "Show 0% / 100% Fib lines", inline="fib01", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="Draws two extra reference lines at the 0% and 100% levels — the actual last confirmed HTF swing high/low the 50%-61.8% zone above is measured from, i.e. the full swing range. Same width (bars back) as the Fib Zone box above. Labeled \"0\" and \"1\" at the right edge.")
col_fib_01_lines = input.color(color.purple, "Line color", inline="fib01", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━")
// v4.64: split out per follow-up ("is there a way to change the text color on 0 and 1 fib and line
// style") — col_fib_01_lines above now controls only the line itself; text color and line pattern
// are separate so they no longer have to match the line's color/style.
txt_fib_01_lines = input.color(color.gray, "Text color", inline="fib01c", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━")
fib_01_line_style = input.enum(RefLineStyle.dashed, "Line style", inline="fib01c", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="0%/100% Fib line pattern.")
// v4.55: replaces the old packed-string row 1/row 2/Info row breakdown — a small dedicated table
// (separate from the Status table, same pattern as the Pivot Points table below) with one cell per
// factor so each can carry its own color: green = counted toward the score, amber = the touch
// condition is true right now but excluded (outside the recency window, or its toggle is off), gray =
// not true. Replaces the Info row's job with color instead of a whole extra row.
confluence_use_cells_table = input.bool(false, "Show Confluence Factors table (color-coded cells)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="A small dedicated table, separate from the Status table, with a leading live Score cell (counted/max) followed by one colored cell per confluence factor (10 — HTF EMA and LTF Structure count toward the score/threshold but are not shown here, a v6.17 token-budget trim) — 11 cells total, ordered HTF/Cloud/Zone/Sweep, then Volume/Fib/Structure/Level/Flip(LTF)/HTFFlip. Factor cells: Green = counted toward the score right now. Amber = the underlying condition is true but excluded — a recency window or its own include/exclude toggle is currently zeroing it out. Gray = not true at all. The HTF/Cloud/Zone/Sweep group right after the Score cell is bracketed with [ ] text markers, since Pine's table API has no way to draw an actual border around a subset of cells.")
confluence_cells_position = input.string("Bottom right", "Confluence Factors Table Position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━")
confluence_cells_rows = input.int(1, "Confluence Factors Table Rows", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="How many rows to spread the 11 cells (Score + 10 factors) across — columns adjust automatically (about 11/rows per row, cells fill left-to-right then wrap). 1 (default) = a single wide row. Higher values make the table narrower but taller. Note: the [ ] bracket around HTF/Cloud/Level/Zone only reads correctly at the default 1 row — at higher row counts that group may wrap onto separate rows.")
// v7.23: "Confluences Checklist" table — a second, independently toggleable confluence display,
// laid out to mirror the user's own Pre-Trade Checklist item 2 (Confluences) exactly: one checkbox
// square + label per factor, 2 columns x 4 rows (CBC LTF/EMA Cloud LTF/VWAP/Structure HTF on the
// left, CBC HTF/EMA Cloud HTF/EMA20 on the right, last cell blank). Deliberately kept SEPARATE from
// the existing compact Confluence Factors cells table above (confluence_use_cells_table) rather than
// replacing it, per direct request — the two can run side by side or independently. VWAP and EMA20
// are brand-new checks (no existing confluence factor covered either) — see the library export's own
// comment for exactly how each of the 7 items is computed.
confluence_checklist_show = input.bool(false, "Show Confluences Checklist table (checkbox layout)", group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━", tooltip="A second, separate confluence display laid out like the Pre-Trade Checklist's own \"Confluences\" section — one colored checkbox + label per item: CBC LTF, EMA Cloud LTF, VWAP, Structure HTF (left column), CBC HTF, EMA Cloud HTF, EMA20 (right column). A checkbox is colored green when that factor currently agrees with the live LTF CBC direction, gray otherwise. Independent of the compact Confluence Factors cells table above — both can be shown together or separately. Off by default.")
confluence_checklist_position = input.string("Middle right", "Confluences Checklist Table Position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group="▌▌▌▌▌▌▌▌▌▌⑱ Confluence Score ━━━━━━━━━━━━━━")

// v7.24: Pre-Trade Checklist items 3/4 — "Stop Structure Checklist" and "Target Structure Checklist"
// tables, mirroring the "Stop is at a real structural level — which type?" section of both checklist
// items. Per direct request ("can we review items 3 and 4"), scoped through two rounds of
// clarification: (1) 12 independent per-type proximity checks (not just "classify the nearest
// level"), so several can light up at once; (2) Order Blocks and Equal Highs/Lows added to the pool,
// on top of the 8 level types already tracked elsewhere in this file; (3) new full-session (not just
// opening-range) high/low tracking added for the 3 "...Session" items — see that block above. The
// "$300 per-trade limit" checkbox from both items is deliberately NOT automated — this script has no
// account size or position-sizing data, so that stays a manual-only checkbox in the HTML dashboard.
chk_tol_mode = input.string("ATR Multiple", "Structure Checklist: Level Tolerance Mode", options=["ATR Multiple", "Fixed"], group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━", tooltip="How close price needs to be to a level for that level's checkbox to light up. Mirrors the Equal Highs/Lows tolerance mode below, but as its own separate setting (these checklist items use much wider structural levels, not the tight EQH/EQL tolerance).")
chk_atr_len = input.int(14, "Tolerance ATR Length", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━")
chk_atr_mult = input.float(0.5, "Tolerance ATR Multiple", minval=0.01, step=0.1, group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━")
chk_fixed_tol = input.float(2.0, "Tolerance (Fixed Points)", minval=0.01, step=0.5, group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━")
chk_stop_show = input.bool(false, "Show Stop Structure Checklist table", group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━", tooltip="Item 3 — 'Stop is at a real structural level, which type?' 12 checkboxes (Prior Day High/Low, Equal Highs/Lows, Order Block, Swing High/Low, Pivot Point, Premarket, and the 3 ORB + 3 full-Session variants), checked on the side OPPOSITE the live LTF CBC direction — i.e. candidate stop locations. Off by default.")
chk_stop_position = input.string("Bottom left", "Stop Structure Checklist Table Position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━")
chk_target_show = input.bool(false, "Show Target Structure Checklist table", group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━", tooltip="Item 4 — the same 12 level types, checked on the side that FAVORS the live LTF CBC direction — i.e. candidate target locations. Off by default.")
// v7.29: default moved "Bottom center" -> "Bottom left" per direct request ("move level table to
// left bottom default"). Now shares its default anchor with the Stop Structure Checklist table right
// above (also "Bottom left") -- TradingView auto-stacks multiple tables sharing one anchor rather than
// overlapping them, but if the stacked layout doesn't look right on your chart, either one can still
// be repositioned independently via its own Position dropdown.
chk_target_position = input.string("Bottom center", "Target Structure Checklist Table Position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group="▌▌▌▌▌▌▌▌▌▌⑲ Pre-Trade Checklist ━━━━━━━━━━━━━━")

alert_on_vwap_bounce = input.bool(true, "Alert: VWAP Bounce - High R:R (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="CBC flip at VWAP, clear of the nearest major support/resistance.")
alert_on_ema20_touch = input.bool(true, "Alert: EMA20 Touch - Pullback Entry (LTF/HTF)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Regressive EMA20 touch while CBC confirms the trend. LTF: max 3 per confirmed HTF flip, 3-bar cooldown between. HTF: at least 1 full bar between alerts.")
alert_ema20_touch_intrabar = input.bool(true, "EMA20 Touch: fire intra-bar (off = wait for bar close)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Off (default): the touch/regression setup must hold through bar close before the alert fires — today's behavior. On: fires as soon as the setup appears on the still-forming bar. Either way, once it fires it won't fire again until the close of the next bar at the earliest.")
ema20_touch_freq = alert_ema20_touch_intrabar ? alert.freq_once_per_bar : alert.freq_once_per_bar_close
pullback_only = input.bool(true, "Pierce/Touch: pullbacks only (price must come from the trade side)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="v8.38: LTF EMA20 Pierce, HTF EMA9/EMA20 Pierce and both EMA20 Touch alerts (and the setups they trigger) only count when price RETREATS to the line: a long needs the previous bar's low ABOVE the line and this bar's low reaching it; a short needs the previous bar's high BELOW the line and this bar's high reaching it. Off = any first touch counts, including price rising into the line from below (the old behavior).")
alert_on_ltf_ema20_pierce = input.bool(true, "Alert: LTF EMA20 Pierce - Entry (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="HTF direction already confirmed, and price pierces the LTF's own EMA20 (first bar back inside after being outside) — a single-line pierce, distinct from the EMA9/20 zone Entry and from EMA20 Touch's regressive-candle requirement.")
ltf_ema20_pierce_cooldown = input.int(3, "LTF EMA20 Pierce: cooldown bars", minval=0, group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Bars that must pass after a Pierce alert fires before another can fire. 0 = no cooldown, every new pierce fires.")
alert_on_htf_ema_pierce = input.bool(true, "Alert: HTF EMA9 / HTF EMA20 Pierce - Entry (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="v8.33: its own alert when price pierces the HTF EMA9 or HTF EMA20 line (first bar touching it after a bar that did not), with the HTF CBC direction confirmed and the flip-away gate passed. Same rules as the Trade Setup trigger, minus the favorable-close check (like LTF EMA20 Pierce). Once every 3 bars per line.")
alert_on_htf_pullback_structure = input.bool(true, "Alert: HTF Pullback Entry - Structure Confirmed (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Recent HTF flip + EMA9/20 pullback + structure, all aligned.")
htf_pullback_recent_bars = input.int(4, "HTF Pullback Entry: recent flip window (HTF bars)", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━")
alert_on_htf_flip_fvg = input.bool(true, "Alert: In FVG of HTF Flip Candle (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires intrabar (doesn't wait for the LTF bar to close) when price is inside the 3-candle Fair Value Gap formed around the last confirmed HTF flip, subject to the two throttle settings below.")
alert_on_ob_htf = input.bool(true, "Alert: Price enters an Order Block in the HTF EMA direction (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="v10.39: at the candle close, when the 15m EMA9 is above the EMA20 (bullish) and the candle traded into an active bullish order block (OB+: low at or below its top, close held at or above its bottom) -> \"OB Entry: LONG\"; bearish 15m EMAs + bearish OB- mirrored -> SHORT. Once per order block. Needs ⑨ Order Blocks (Lux-style) Show ON. Info alert only -- it does not draw a setup.")
alert_ob_e20 = input.bool(true, "   ...only when the HTF EMA20 is inside that order block", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="v10.40: ON (default) = the OB Entry alert fires only when the 15m EMA20 sits between the order block's top and bottom (the block and the HTF EMA20 line up). OFF = any same-side OB touch with the HTF EMAs.")
fvg_alert_min_gap_bars = input.int(2, "In FVG Alert: Min LTF Bars Between Fires", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="The 'In FVG' alert won't re-fire more often than once every this many LTF bars, even though it fires intrabar and price can dip in/out of the zone repeatedly.")
fvg_alert_max_bars_after_flip = input.int(20, "In FVG Alert: Stop After N LTF Bars Post-Flip", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Once this many LTF bars have passed since the HTF flip that formed this gap, the 'In FVG' alert stops firing for that flip cycle, even if price is still trading inside the zone.")
vwap_bounce_min_dist_override = input.float(0, "VWAP Bounce: min distance from major support/resistance (0 = auto by symbol)", minval=0, group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Auto by symbol root: MES/MGC=6, M2K=4, MNQ=60, other=6.")
// v6.41: "potential flop close to VWAP" warning, per direct request. On a long A+ Setup/Zone Entry/
// Confluence/LTF EMA20 Pierce (checked against the LTF flip price) or HTF CBC Flip (checked against
// the HTF flip price), warns if VWAP sits above the flip price by less than this many points — same
// mirrored check on the short side (VWAP below the flip price).
// v6.43: per follow-up ("allow inputs to specify specifically mgc, mes, and mnq which would be used
// for vwap and these levels"), the single 0=auto override above was replaced by 3 explicit per-symbol
// overrides shared by BOTH the VWAP-near-flip warning and the new Pivot-Level-near-flip warning below
// — same threshold, same auto-by-symbol fallback table (MES/MGC=6, M2K=4, MNQ=60, other=6) as before,
// just now individually overridable for the 3 symbols actually traded instead of one shared number.
flip_warn_min_dist_mgc = input.float(0, "MGC (0=auto, 6)", minval=0, inline="flipwarndist", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Min-distance threshold for the VWAP-near-flip and Pivot-Level-near-flip warnings, shared by both. Used when the chart symbol's root is MGC. 0 = auto (6).")
flip_warn_min_dist_mes = input.float(0, "MES (0=auto, 6)", minval=0, inline="flipwarndist", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Same, for MES. 0 = auto (6).")
flip_warn_min_dist_mnq = input.float(0, "MNQ (0=auto, 60)", minval=0, inline="flipwarndist", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Same, for MNQ. 0 = auto (60).")
alert_show_stop = input.bool(false, "Include LTF Trailing Stop in emails", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Adds a \"LTF Trailing Stop\" line to every")
alert_show_flip_level = input.bool(true, "Include CBC Flip Level in emails", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Adds \"CBC Flip Level (LTF/HTF/MTF)\" lines")
alert_session_asian = input.bool(true, "Asian", inline="alertsess1", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip=tt_alert_session)
alert_asia_window = input.session("1800-2230", "", inline="alertsess1", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━")
alert_session_london = input.bool(true, "London", inline="alertsess2", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip=tt_alert_session)
alert_london_window = input.session("0300-0745", "", inline="alertsess2", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━")
alert_session_ny = input.bool(true, "New York", inline="alertsess3", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip=tt_alert_session)
alert_ny_window = input.session("0930-1700", "", inline="alertsess3", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━")

// ═══════════════════════════════════════
//  LEVEL PROXIMITY ALERTS
//  Ported from MapleStax CBC Wire: alerts once when price CROSSES (very close to) or
//  APPROACHES (getting close to) any of these reference levels — separate from, and in
//  addition to, the existing CBC/Structure/EMA-cloud-based alert types above. Unlike CBC
//  Wire's hardcoded 0.5pt/3.0pt thresholds, both distances are configurable here to match
//  this script's usual style, and in points (same units as the symbol's price).
// ═══════════════════════════════════════
alert_on_level_proximity = input.bool(true, "Enable level proximity alerts", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━", tooltip="Master toggle for this whole section.")
prox_crossing_dist = input.float(0.5, "Crossing distance (points)", minval=0.01, group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━", tooltip="Price within this many points of a level")
prox_approach_dist = input.float(3.0, "Approaching distance (points)", minval=0.01, group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━", tooltip="Price within this many points of a level")
prox_cooldown_bars = input.int(5, "Min bars between repeat alerts (same level)", minval=0, group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━", tooltip="Suppresses a repeat proximity alert for this many bars after the last one fired — prevents rapid back-to-back alerts when price hovers right at a level's Crossing/Approaching boundary. 0 = no cooldown.")
prox_check_vwap = input.bool(true, "VWAP", inline="proxlv1", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━")
prox_check_ema20 = input.bool(true, "EMA 20 (chart timeframe)", inline="proxlv1", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━")
