show_htf_flip_fvg = input.bool(true, "HTF Flip FVG", inline="htffvg", group="▌▌▌▌▌▌▌▌▌▌⑥ LTF Signals ━━━━━━━━━━━━━━", tooltip="Shades the 3-candle Fair Value Gap formed around the last confirmed HTF CBC flip (candle before it vs. the candle that closed right after it).")
