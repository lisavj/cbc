ltf_piv_n = input.int(2, "N", minval=1, inline="ltfpiv", group="▌▌▌▌▌▌▌▌▌▌⑥ LTF Signals ━━━━━━━━━━━━━━", tooltip="Bars left and right of a chart bar that")
