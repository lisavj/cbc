alert_agreement_early_ltf_join = input.bool(false, "  ↳ Include \"LTF joining unchanged HTF\" case", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Unchecked: suppresses the case where HTF")
alert_agreement_ltf_join = input.bool(false, "  ↳ Include \"LTF joining unchanged HTF\" case (confirmed)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Unchecked: suppresses when LTF alone joined an unchanged HTF.")
alert_on_a_plus = input.bool(true, "A+ Setup (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires when HTF CBC + both EMA clouds")

