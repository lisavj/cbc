// v8.29: "Order Blocks (Lux-style)" -- a SEPARATE, switchable order-block engine modeled on LuxAlgo's
// open-source Order Blocks & Breaker Blocks logic (swing pivot -> break -> origin candle = the lowest-low
// (bull) / highest-high (bear) candle between the swing and the break). The classic "Order Blocks" group
// above is untouched. To go back: untick "Show" here (or delete this input block + the "v8.29 OB2" block
// further down, and the f_ob2_manage library export); nothing else depends on it.
ob2_show = input.bool(true, "Show", inline="ob2a", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="Lux-style order blocks. On by default (v10.04) -- the classic Order Blocks group above is separate.")
ob2_last = input.int(5, "Show Last", minval=1, inline="ob2a", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━")
ob2_bull_col = input.color(color.new(#089981, 0), "", inline="ob2a", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━")
ob2_bear_col = input.color(color.new(#F23645, 0), "", inline="ob2a", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━")
ob2_activity = input.bool(true, "Internal Buy/Sell Activity", inline="ob2b", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="Splits the candles that built the block into a green (buy volume) and red (sell volume) part, proportional to their share. Volume is split by candle color (close vs open), an estimate, not true order flow.")
ob2_act_buy = input.color(#089981, "", inline="ob2b", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━")
ob2_act_sell = input.color(#F23645, "", inline="ob2b", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━")
ob2_breakers = input.bool(false, "Show Breakers", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="A mitigated order block stays as a dashed zone acting the other way (broken bull OB = resistance) until price closes back beyond its far edge.")
ob2_len = input.int(5, "Length", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="Swing pivot lookback (bars each side) used to find the swing whose break creates the block.")
ob2_mitig = input.string("Close", "Mitigation Method", options=["Close", "Wick", "Average"], group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="Close: a close beyond the block's far edge. Wick: the high/low beyond it. Average: a close beyond the block's mid-line.")
ob2_tf = input.string("Chart", "Timeframe", options=["Chart", "Custom 5x", "HTF"], group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="Chart (default) = the chart's own candles (like LuxAlgo's default). Custom 5x = on charts of 5 minutes or less, blocks are built from 5x the chart period (1m -> 5m, 2m -> 10m, 3m -> 15m, 5m -> 25m), ignoring the HTF Signals setting; above 5 minutes it uses the chart's own candles. HTF = the HTF Signals timeframe. Blocks appear on the bar after the break (confirmed values, no repaint).")
ob2_metrics = input.bool(true, "Show Metrics", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="Buy/sell volume share and total volume of the candles that built the block, shown inside the box.")
ob2_mid = input.bool(true, "Show Mid-Line", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━")
ob2_hide_overlap = input.bool(true, "Hide Overlap", group="▌▌▌▌▌▌▌▌▌▌⑨ Order Blocks (Lux-style) ━━━━━━━━━━━━━━", tooltip="A new block that overlaps an older active block of the same direction hides the older one (it still counts toward Show Last), like LuxAlgo PAC.")

// v6.64: Price Action Structure markers — a brand-new, independent dual-length pivot pipeline
// (Internal/Swing, matching LuxAlgo Price Action Concepts' naming) for on-chart HH/HL/LH/LL labels.
// Deliberately separate from LTF/HTF Signals above (different inputs, different state, touches
// nothing there) so nothing existing changes behavior. Only 2 colors (shared between Internal and
// Swing, distinguished by label size instead) to keep the input count down.
pa_show = input.bool(true, "Show Structure Markers (HH/HL/LH/LL)", group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━")
pa_internal_len = input.int(5, "Internal Length", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="Pivot length for the short-term/internal structure markers (smaller text).")
pa_swing_len = input.int(50, "Swing Length", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="Pivot length for the major/swing structure markers (larger text).")
pa_bull_col = input.color(color.teal, "Bullish (HH/HL)", inline="pacol", group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━")
pa_bear_col = input.color(color.red, "Bearish (LH/LL)", inline="pacol", group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━")
// Equal Highs/Lows (EQH/EQL), per LuxAlgo Price Action Concepts' own "Equal H&L" feature (researched
// before implementing): toggle + a Short-Term/Long-Term term selector that reuses the SAME Internal/
// Swing pivot detection already computed above for HH/HL/LH/LL (LuxAlgo's actual toolkit has no
// separate EQH/EQL length input of its own — Short-Term reads the Internal pivots, Long-Term reads the
// Swing pivots). LuxAlgo's own docs don't disclose an exact equality-tolerance mechanism for this
// toolkit variant; LuxAlgo's separate "EQH/EQL Liquidity Zones" product does expose one, described as a
// percentage/price-proximity threshold ("within a tight proximity"). Implemented here as a points-based
// tolerance (0 = auto by symbol), reusing the existing obLib.f_vwap_bounce_min_dist() per-symbol table
// (MES/MGC=6, M2K=4, MNQ=60, else 6) already used elsewhere in this file for the same kind of
// "how close counts as close" distance check, rather than adding a new auto-table.
eqhl_show = input.bool(true, "Show Equal Highs/Lows (EQH/EQL)", group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━")
eqhl_term = input.string("Long-Term", "Equal H&L Term", options=["Short-Term", "Long-Term"], group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="Short-Term compares consecutive Internal-length pivots; Long-Term compares consecutive Swing-length pivots (same lengths as the HH/HL/LH/LL markers above) — matches LuxAlgo Price Action Concepts' own Short-Term/Long-Term Equal H&L selector.")
// v6.72: tolerance mechanism redesigned after researching several other TradingView EQH/EQL
// implementations (ICT-style "Equal Highs & Lows (EQH/EQL) Liquidity Pools" and others) — ATR-scaled
// tolerance is the common default there (typically ATR length 14, multiplier ~0.10), not a flat
// per-symbol point table; a flat 6pt table on the Internal/5-bar tier was over-tagging almost every
// swing as "equal" on a normal gold intraday chart. ATR Multiple is now the default mode; Fixed Points
// (the old behavior) is kept as an alternate mode for anyone who prefers a constant distance.
eqhl_tol_mode = input.string("ATR Multiple", "Equal H&L Tolerance Mode", options=["ATR Multiple", "Fixed Points"], group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="ATR Multiple (default, matches common ICT-style Equal Highs/Lows indicators): tolerance auto-scales with recent volatility, tightening in quiet markets and widening in fast ones. Fixed Points: a constant price distance regardless of volatility (the original behavior).")
eqhl_atr_len = input.int(14, "  ↳ ATR Length", minval=1, group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="Matches the common default (14) used by ICT-style Equal Highs/Lows indicators.")
eqhl_atr_mult = input.float(0.10, "  ↳ ATR Multiple", minval=0.0, step=0.01, group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="Matches the common default (0.10) used by ICT-style Equal Highs/Lows indicators — roughly a few ticks of tolerance on a typical instrument.")
eqhl_fixed_points = input.float(0.0, "  ↳ Fixed Points Tolerance (0 = auto)", minval=0.0, group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━", tooltip="Only used when Tolerance Mode is Fixed Points. 0 = auto by symbol (MES/MGC=6, M2K=4, MNQ=60, else 6).")
eqhl_col = input.color(color.black, "Equal H&L Label/Line Color", group="▌▌▌▌▌▌▌▌▌▌⑩ Price Action Structure ━━━━━━━━━━━━━━")

