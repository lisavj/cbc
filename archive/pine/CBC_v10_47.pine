// v6.51: master on-chart marker toggle, per direct request ("add checkbox to suppress 6 or 7 markers
// in the input at the top") — re-adds the single switch v6.00 removed for CE10117 relief (see that
// changelog entry for the original removal), placed first in this group so it's the first thing seen.
// Gates only the final draw step (label.new()/line.new() in the v6.47 top-level marker block below),
// not any of the 7 marker types' own condition booleans or the emailed alerts — turning this off hides
// every on-chart marker (letters and the HTF CBC Flip dot alike) while leaving every alert() email/
// webhook completely unaffected, exactly like the pre-v6.00 toggle did.
show_chart_markers = input.bool(true, "Show on-chart markers (A+/Zone/VWAP/Confluence/HTF Flip/Pierce/Key Level)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Master switch for all 7 on-chart marker types. Turning this off only hides the chart markers — your emailed/webhook alerts still fire normally either way.")
mk_l_on = input.bool(false, "  ↳ L (LTF EMA20 Pierce) markers", inline="mklc", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="v9.80: chart letter markers only (default OFF). The alerts and the setup triggers are unchanged.")
mk_c_on = input.bool(false, "C (High Confluence) markers", inline="mklc", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━")
mk_h_on = input.bool(false, "  ↳ H (Price Enters HTF EMA9/20 Zone) markers", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="v9.85: chart letter marker only (default OFF). The alert is unchanged.")
// v6.56: per direct request ("add an input option to switch the text ... and add info"), a Compact/
// Detailed tooltip option for the HTF CBC Flip dot (confirmed AND anticipatory) and the High Confluence
// Setup marker specifically — the two on-chart marker types the request pointed at. Compact (default)
// is the existing tooltip text, byte-for-byte unchanged. Detailed appends the current Status table
// snapshot (Market/Price/CBC/Opening range/EMA cloud/VWAP/EMA 200/Structure/Fib Zone) to those two
// tooltips only — every other marker type's tooltip is untouched either way.
marker_tooltip_detail = input.string("Compact", "HTF CBC Flip / High Confluence Setup tooltip detail", options=["Compact", "Detailed"], group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Compact (default): tooltip text unchanged from before. Detailed: appends a snapshot of the current Status table (Market, Price, CBC, Opening range, EMA cloud, VWAP, EMA 200, Structure, Fib Zone) to the HTF CBC Flip dot's tooltip (both the confirmed dot and the anticipatory pre-close dot) and to the High Confluence Setup marker's tooltip. Has no effect on any other marker type.")
alert_on_ltf_flip = input.bool(false, "LTF CBC Flip (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires an alert() once the bar has fully CLOSED and the")
alert_on_ltf_flip_early = input.bool(false, "LTF CBC Flip - Early (unconfirmed, mid-candle)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires on the live flip before bar close,")
alert_on_htf_flip = input.bool(true, "HTF CBC Flip (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires an alert() once the HTF bar has")
alert_on_htf_flip_early = input.bool(false, "HTF CBC Flip - Early (unconfirmed, still forming)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires on the live HTF flip before its bar closes. Only in the last 20% of the HTF bar.")
alert_htf_flip_early_revert = input.bool(false, "  ↳ Include \"reverted to already-confirmed\" case", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Unchecked: suppresses the alert when the")
// v6.52: per direct request ("can we mark the cbc flip dot when 99% of the 15 minute is over marking
// the 3 minute or ltf candle") — an opt-in anticipatory version of the HTF CBC Flip on-chart dot.
// v6.53: default flipped to ON, per direct follow-up request ("turn it on by default") — everyone
// who hasn't touched this setting will now see the anticipatory dot; unchecking it restores the
// old (99%-gate-off / dot only on confirmed close) behavior.
// v7.02: the old plain on/off checkbox (could only ADD the anticipatory dot on top of the confirmed
// one, never suppress the confirmed dot itself) replaced with a 3-way mode dropdown, per direct
// request ("can we have an input switch which tells only to use anticipatory in drawing dots vs
// anticipatory and closed"). "Both" is the direct equivalent of the old checkbox's checked/default
// state; "Confirmed Only" is the equivalent of unchecked; "Anticipatory Only" is genuinely new — it
// wasn't achievable before, since the confirmed dot had no toggle of its own (turning off the whole
// "HTF CBC Flip" alert above would have also silenced the alert emails, not just the dot). See
// marker_dot_wins/marker_has_visible_drawable further down for how "Anticipatory Only" is kept from
// leaving a bare, empty leader-line marker on a bar where the HTF Flip was the ONLY thing that fired.
htf_flip_dot_mode = input.string("Anticipatory Only", "HTF CBC Flip dot: which to draw", options=["Confirmed Only", "Anticipatory Only", "Both"], group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Confirmed Only: the on-chart HTF CBC Flip dot appears only once the HTF bar has fully closed and confirmed its direction (solid dot) — the semi-transparent early dot never appears. Anticipatory Only (default as of v7.03): only the early dot appears — once the HTF bar is within N seconds of its scheduled close (see the seconds input below), if the live/still-forming direction already differs from the last confirmed direction, a semi-transparent dot paints right then on the current LTF bar — the solid confirmed dot never appears afterward, even once that HTF bar actually closes. Both: shows both — the semi-transparent dot fires early, then the solid dot also fires once the HTF bar actually closes, even when they agree. The early/anticipatory dot can very rarely be followed by an OPPOSITE-color solid dot (when switched to \"Both\") if price reverses in that last sliver before the HTF bar actually closes — that's expected, not a bug (see this file's own repaint-risk discussion). Has no effect if the HTF CBC Flip toggle above is off.")
// v7.05: htf_flip_dot_show_confirmed removed as a separate named var (it was read at exactly ONE
// real call site, marker_dot_wins below) -- inlined there directly. htf_flip_dot_show_anticipatory
// stays as a named var since it's read at 2 real call sites (htf_flip_early_marker_bull/bear).
htf_flip_dot_show_anticipatory = htf_flip_dot_mode != "Confirmed Only"
alert_on_agreement = input.bool(true, "LTF + HTF Agreement (Long/Short)", group="▌▌▌▌▌▌▌▌▌▌⑤ Alerts ━━━━━━━━━━━━━━", tooltip="Fires an alert() the moment the chart")
