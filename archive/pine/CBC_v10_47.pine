prox_check_billbreaker = input.bool(true, "Bill Breakers (100-pt round numbers)", inline="proxlv2", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━")
prox_check_pivot = input.bool(true, "Swing pivots (1-bar lookback, crossing only)", inline="proxlv3", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━", tooltip="Fractal swing highs/lows (1-bar")
prox_check_ydhl = input.bool(true, "Yesterday's High/Low (YDH/YDL)", inline="proxlv3", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━")
prox_check_orb = input.bool(true, "Current session's Opening Range High/Low", inline="proxlv4", group="▌▌▌▌▌▌▌▌▌▌⑳ Level Proximity Alerts ━━━━━━━━━━━━━━", tooltip="Uses whichever session's OR is currently")


