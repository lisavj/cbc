// v6.24: Marker Key — small legend table defining each of the 6 on-chart alert marker symbols
// (diamond/circle/xcross/Z/H/E), same "Show" + position + text-size pattern as CBC bar colors' legend
// above, per direct request ("input option key for the symbols similar to the definitions").
// v6.31 (CE10117 trim): dropped Marker Key's own position/text-size inputs — reuses
// cbc_legend_position/cbc_legend_text_size (the CBC bar colors legend's settings) instead, since 2
// fewer input.string() calls with full 9/5-option arrays was the cheapest safe trim available for an
// 8-token gap. Marker Key keeps its own independent "Show" toggle; only its position/size are now tied
// to the CBC legend's. Revert by re-adding the 2 inputs above if there's headroom later.
// v7.29: default flipped false->true->false again -- per direct request ("turn off marker
// definitions"), the Marker Key legend now defaults OFF. Anyone who already has it on/off keeps their
// own saved choice; this only changes what a fresh install/reset sees.
show_marker_key = input.bool(false, "Show", inline="markerkey", group="▌▌▌▌▌▌▌▌▌▌㉑ Marker Key ━━━━━━━━━━━━━━", tooltip="Small legend table defining each on-chart alert marker symbol.")
// v6.32: re-added a dedicated position input per direct request ("inputs to relocate it") — text size
// still follows cbc_legend_text_size (kept shared to hold down the token cost of re-adding this).
marker_key_position = input.string("Bottom left", "Position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], inline="markerkeypos", group="▌▌▌▌▌▌▌▌▌▌㉑ Marker Key ━━━━━━━━━━━━━━")

or_ny = input.bool(true, "New York", inline="ors_ny", group=grp_or_sessions, tooltip="Opening range: first N minutes after 9:30 AM ET.")
col_orb_ny_lbl = input.color(#ff9800, "", inline="ors_ny", group=grp_or_sessions)
orb_shade_mode = input.string("After OR closes, until session ends", "Opening Range shading shows", options=["After OR closes, until session ends", "During OR formation only"], group=grp_or_sessions, tooltip="Which period the shaded OR zone is visible for.")
col_orb_ny_fill = input.color(color.rgb(255, 235, 59, 95), "", inline="ors_ny", group=grp_or_sessions)
col_orb_ny_line = input.color(color.black, "Line", inline="ors_ny_line", group=grp_or_sessions)
orb_ny_line_w = input.int(1, "Width", minval=1, inline="ors_ny_line", group=grp_or_sessions)
or_london = input.bool(true, "London", inline="ors_ln", group=grp_or_sessions, tooltip="Opening range: first N minutes after 3:00 AM ET.")
col_orb_ln_lbl = input.color(#9c27b0, "", inline="ors_ln", group=grp_or_sessions)
col_orb_ln_fill = input.color(color.rgb(155, 39, 176, 95), "", inline="ors_ln", group=grp_or_sessions)
col_orb_ln_line = input.color(color.black, "Line", inline="ors_ln_line", group=grp_or_sessions)
orb_ln_line_w = input.int(1, "Width", minval=1, inline="ors_ln_line", group=grp_or_sessions)
or_asian = input.bool(true, "Asian", inline="ors_as", group=grp_or_sessions, tooltip="Opening range: first N minutes after 8:00 PM ET.")
col_orb_as_lbl = input.color(#e65100, "", inline="ors_as", group=grp_or_sessions)
col_orb_as_fill = input.color(color.rgb(230, 81, 0, 95), "", inline="ors_as", group=grp_or_sessions)
col_orb_as_line = input.color(color.black, "Line", inline="ors_as_line", group=grp_or_sessions)
orb_as_line_w = input.int(1, "Width", minval=1, inline="ors_as_line", group=grp_or_sessions)
col_orb_lbl_text = input.color(color.black, "ORB-H/L label text", group=grp_or_sessions)
or_minutes = input.int(30, "Minutes", minval=1, inline="or", group=grp_or_sessions, tooltip="Length (minutes) of each enabled")

// ORB Retest / "Break & Base" — the classic ORB playbook: (1) an initial breakout beyond the OR high/low
// that you should NOT chase, (2) a pullback that RETESTS the broken level from the other side (old
// resistance becomes support, or vice versa — the "base"), (3) a bar closes back in the breakout
// direction, confirming the base. Tracks whichever session's ORB (Asian/London/NY) is currently active.
show_orb_retest_markers = input.bool(true, "Show markers on chart", group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="Plots a small triangle at the bar where a")
orb_retest_tolerance = input.float(0.15, "Retest zone (× OR range)", minval=0.01, step=0.01, group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="How close price must come back to the ORB")
orb_retest_min_break = input.float(0.10, "Min breakout distance (× OR range)", minval=0.0, step=0.01, group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="Minimum clear-past-level distance")
orb_retest_max_bars = input.int(60, "Max bars to wait for retest", minval=1, group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="How many bars after the initial breakout")
col_orb_retest_success = input.color(#00e676, "Pass marker color", inline="orbr_col", group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━")
col_orb_retest_fail = input.color(color.red, "Flip marker color", inline="orbr_col", group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━")
col_orb_retest_stall = input.color(#ff9800, "Fail from marker color", inline="orbr_col", group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━")
// v6.76: Session ORB High/Low Cross — a plain, unconditional marker for the first close across
// EITHER boundary of the currently-active session's own Opening Range (whichever of Asian/London/NY
// is tracked and has finished forming, same orb_r_hi/orb_r_lo/orb_r_ready used by ORB Retest above).
// Unlike ORB Retest, this has no retest/base-confirmation logic at all — it just flags the raw
// cross event, once, then a cooldown before the next one (either direction) can fire.
show_orb_hl_cross = input.bool(true, "Session ORB High/Low Cross marker", group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="Marks the first bar where price closes across an Opening Range High or Low. Fires once, then waits the cooldown below (in LTF/chart bars) before it can fire again in either direction.")
orb_hl_cross_mode = input.string("Current Session Only", "Cross marker sessions", options=["Current Session Only", "Asian", "London", "New York", "All Sessions"], group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="Which session's Opening Range the Cross marker watches. 'Current Session Only' (default) follows whichever session is live right now, same as ORB Retest above. Pick one specific session to track only that session's OR all day (regardless of what time it is now), or 'All Sessions' to watch all three independently — still just one shared cooldown across all of them.")
orb_hl_cross_cooldown = input.int(5, "Cross marker cooldown (LTF bars)", minval=0, group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━", tooltip="Bars to wait after a Cross marker fires before another one (either direction) can fire again.")
col_orb_hl_cross = input.color(color.aqua, "Cross marker color", group="▌▌▌▌▌▌▌▌▌▌㉓ ORB Retest (Break & Base) ━━━━━━━━━━━━━━")
// (No "hole color" input needed — the inner circle uses color.new(_, 100), full transparency,
// so it shows through to whatever's actually behind it regardless of chart theme/background.)
show_any_or = or_ny or or_london or or_asian

