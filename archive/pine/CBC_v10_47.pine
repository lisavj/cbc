ob_max     = input.int(1, "Max Order Blocks Per Side", minval = 1, maxval = 10, group="▌▌▌▌▌▌▌▌▌▌⑧ Order Blocks ━━━━━━━━━━━━━━")
ob_bull_col= input.color(color.new(color.teal, 80), "Bullish OB Color", group="▌▌▌▌▌▌▌▌▌▌⑧ Order Blocks ━━━━━━━━━━━━━━")
ob_bear_col= input.color(color.new(color.red, 80), "Bearish OB Color", group="▌▌▌▌▌▌▌▌▌▌⑧ Order Blocks ━━━━━━━━━━━━━━")
// v4.97: commented out (CE10117 trim, same convention as the block below) — HTF Order Blocks feature
// itself is commented out, so this input has nothing to control. Uncomment together.
