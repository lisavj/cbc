aplus_check_vwap = input.bool(true, "Check VWAP", group="▌▌▌▌▌▌▌▌▌▌⑰ A+ Setup - Major Pivot Proximity ━━━━━━━━━━━━━━")
aplus_check_ydhl = input.bool(true, "Check YDH/YDL", group="▌▌▌▌▌▌▌▌▌▌⑰ A+ Setup - Major Pivot Proximity ━━━━━━━━━━━━━━")
