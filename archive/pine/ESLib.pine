// v99 rev25b (10/11/2026): the Lux-style Order Block functions (f_ob2_detect / f_ob2_manage + helpers) moved to the new
// library ESLib2 (CE10117 at 104,111 tokens after rev24/rev25). CBC imports ESLib2 as ob2Lib for those two calls.

// Creates a new LTF order-block box, anchored via a bar_index offset (_idx = bars back from the
// current bar), and pushes it onto _boxes — trimming the oldest box if the per-side cap (_max) is
// exceeded.
export f_obAdd(box[] _boxes, int _idx, color _col, int _max) =>
    array.push(_boxes, box.new(left = bar_index - _idx, top = high[_idx], right = bar_index, bottom = low[_idx], border_color = color.new(_col, 40), bgcolor = _col, extend = extend.right))
    if array.size(_boxes) > _max
        box.delete(array.shift(_boxes))

// Creates a new HTF order-block box, anchored with explicit time bounds (_leftT/_rightT) instead of a
// bar_index offset, since bar_index doesn't map to HTF candle widths — same push/trim behavior as
// f_obAdd otherwise.
export f_htfObAdd(box[] _boxes, int _leftT, float _top, int _rightT, float _bot, color _col, int _max) =>
    array.push(_boxes, box.new(left = _leftT, top = _top, right = _rightT, bottom = _bot, xloc = xloc.bar_time, border_color = color.new(_col, 40), bgcolor = _col, extend = extend.right))
    if array.size(_boxes) > _max
        box.delete(array.shift(_boxes))

// Mitigation check for either LTF or HTF order-block boxes: deletes and removes any box the current
// bar's wick has traded back through (low below the box's bottom for a bullish box, high above the
// box's top for a bearish one).
// Updates one swing-pivot "unbroken high/low" state pair given this bar's fresh pivot values (na if no
// new pivot formed). Used for both LTF and HTF Order Blocks — same 4-line update pattern, now shared
// instead of duplicated at each call site, and moved out of the main script's CE10117 budget entirely.
export f_obUpdateSwing(float _pivHi, float _pivLo, float _swHi, bool _swHiBroken, float _swLo, bool _swLoBroken) =>
    float swHi = not na(_pivHi) ? _pivHi : _swHi
    bool swHiBroken = not na(_pivHi) ? false : _swHiBroken
    float swLo = not na(_pivLo) ? _pivLo : _swLo
    bool swLoBroken = not na(_pivLo) ? false : _swLoBroken
    [swHi, swHiBroken, swLo, swLoBroken]

export f_obManage(box[] _boxes, bool _isBull) =>
    if array.size(_boxes) > 0
        for i = array.size(_boxes) - 1 to 0
            box bx = array.get(_boxes, i)
            if _isBull ? low < box.get_bottom(bx) : high > box.get_top(bx)
                array.remove(_boxes, i)
                box.delete(bx)

// Orders 3 (value, label) pairs ascending and renders them as "label<label<label", starring whichever
// label matches star_label. Used for the "ema9 < ema20 < price" style ordering lines in alert emails.
export f_order3(float v1, string l1, float v2, string l2, float v3, string l3, string star_label) =>
    string s1 = (l1 == star_label ? "*" : "") + l1 + " " + str.tostring(v1, "#.##") + (l1 == star_label ? "*" : "")
    string s2 = (l2 == star_label ? "*" : "") + l2 + " " + str.tostring(v2, "#.##") + (l2 == star_label ? "*" : "")
    string s3 = (l3 == star_label ? "*" : "") + l3 + " " + str.tostring(v3, "#.##") + (l3 == star_label ? "*" : "")
    string result = ""
    if v1 <= v2 and v2 <= v3
        result := s1 + "<" + s2 + "<" + s3
    else if v1 <= v3 and v3 <= v2
        result := s1 + "<" + s3 + "<" + s2
    else if v2 <= v1 and v1 <= v3
        result := s2 + "<" + s1 + "<" + s3
    else if v2 <= v3 and v3 <= v1
        result := s2 + "<" + s3 + "<" + s1
    else if v3 <= v1 and v1 <= v2
        result := s3 + "<" + s1 + "<" + s2
    else
        result := s3 + "<" + s2 + "<" + s1
    result

// Classifies price relative to two EMAs regardless of which one is higher: "Above Both", "Below Both", or "Between".
export f_price_vs_emas(float price, float ema_a, float ema_b) =>
    float lo = math.min(ema_a, ema_b)
    float hi = math.max(ema_a, ema_b)
    string result = price > hi ? "Above Both" : price < lo ? "Below Both" : "Between"
    result

// Abbreviates a Structure classification string ("Higher High" -> "HH", etc.) for compact table display.
export f_struct_abbrev(string s) =>
    string result = s == "Higher High" ? "HH" : s == "Lower High" ? "LH" : s == "Higher Low" ? "HL" : s == "Lower Low" ? "LL" : s
    result

// Level Proximity Alerts (ported from CBC Wire): returns a formatted bullet-text string if price
// is within the CROSSING distance of level_val, else "". "Crossing" here means "currently very
// close to" the level (either side), not a directional cross event like the existing VWAP
// Break/EMA 200 Break alert types. Distance thresholds are passed in since a library can't read the
// main script's own input.float values directly.
export f_prox_crossing(float price, float level_val, string level_name, float crossing_dist) =>
    string result = ""
    if not na(level_val)
        float dist = math.abs(price - level_val)
        if dist <= crossing_dist
            string dir_word = price > level_val ? "above" : "below"
            result := level_name + " Crossing (" + str.tostring(dist, "#.##") + " points " + dir_word + " Price, " + level_name + ": " + str.tostring(level_val, "#.##") + ")"
    result

// Same, but for the wider APPROACHING band (farther than crossing distance, within approaching
// distance). Only called when a full crossing pass has already found nothing.
export f_prox_approaching(float price, float level_val, string level_name, float crossing_dist, float approach_dist) =>
    string result = ""
    if not na(level_val)
        float dist = math.abs(price - level_val)
        if dist > crossing_dist and dist <= approach_dist
            string dir_word = price > level_val ? "above" : "below"
            result := level_name + " Approaching (" + str.tostring(dist, "#.##") + " points " + dir_word + " Price, " + level_name + ": " + str.tostring(level_val, "#.##") + ")"
    result

// Formats a UTC ms timestamp as "M/D H:MM ET" in New York time. Used for "last flip" displays
// (Status table, Historical Bar Panel, alert email) so they all read the same way. Hardcodes
// "America/New_York" internally — this was always a fixed constant in the main script, never a
// user input, so no need to pass it in.
export f_fmt_ny_time(int t) =>
    string result = na(t) ? "—" : str.tostring(month(t, "America/New_York"), "#") + "/" + str.tostring(dayofmonth(t, "America/New_York"), "#") + " " + (hour(t, "America/New_York") < 10 ? "0" : "") + str.tostring(hour(t, "America/New_York"), "#") + ":" + (minute(t, "America/New_York") < 10 ? "0" : "") + str.tostring(minute(t, "America/New_York"), "#") + " ET"
    result

// v15: seconds-resolution sibling of f_fmt_ny_time above, for tooltip-only call sites that want more
// precision than the shared minute-only format (Status table/Historical Bar Panel/alert emails keep
// using f_fmt_ny_time unchanged). Identical structure, with one added zero-padded ":SS" segment.
export f_fmt_ny_time_sec(int t) =>
    string result = na(t) ? "—" : str.tostring(month(t, "America/New_York"), "#") + "/" + str.tostring(dayofmonth(t, "America/New_York"), "#") + " " + (hour(t, "America/New_York") < 10 ? "0" : "") + str.tostring(hour(t, "America/New_York"), "#") + ":" + (minute(t, "America/New_York") < 10 ? "0" : "") + str.tostring(minute(t, "America/New_York"), "#") + ":" + (second(t, "America/New_York") < 10 ? "0" : "") + str.tostring(second(t, "America/New_York"), "#") + " ET"
    result

// v55: replaces v54's f_fmt_ny_time_hm(t) (single-time "H:MM") -- per direct follow-up ("make it
// 9:30-45 or in another case 9:45-10"), the Pivot Points table's Price row now wants a compact OPEN-
// CLOSE range instead of a single time. Format, per the two examples given: "H:MM-mm" when the close
// falls in the SAME hour as the open (e.g. "9:30-45" -- open 9:30, close 9:45, only the close minutes
// repeated); "H:MM-H2" or "H:MM-H2:mm2" when the close falls in a DIFFERENT hour (e.g. "9:45-10" --
// open 9:45, close 10:00, close minutes are exactly :00 so dropped entirely and only the new hour
// shows; a close at e.g. 10:15 would read "9:45-10:15", minutes shown since they're non-zero). No
// month/day/seconds/" ET" -- same narrow-cell reasoning that motivated v54's now-superseded helper.
export f_fmt_ny_time_range(int t_open, int t_close) =>
    int open_h = hour(t_open, "America/New_York")
    int open_m = minute(t_open, "America/New_York")
    int close_h = hour(t_close, "America/New_York")
    int close_m = minute(t_close, "America/New_York")
    string open_str = str.tostring(open_h, "#") + ":" + (open_m < 10 ? "0" : "") + str.tostring(open_m, "#")
    string close_str = close_h == open_h ? (close_m < 10 ? "0" : "") + str.tostring(close_m, "#") : close_m == 0 ? str.tostring(close_h, "#") : str.tostring(close_h, "#") + ":" + (close_m < 10 ? "0" : "") + str.tostring(close_m, "#")
    string result = (na(t_open) or na(t_close)) ? "—" : open_str + "-" + close_str
    result

// v16: builds the LTF CBC Reversal triangle's full tooltip string (ticker header, direction label,
// fixed explainer text, seconds-resolution timestamp via f_fmt_ny_time_sec above) — moved out of the
// main script's CE10117 budget since it's pure string assembly from 3 passed-in parameters, no
// CBC-internal state read.
export f_ltf_reversal_tooltip(string tkr, bool is_bull, int t) =>
    tkr + " —\n• LTF CBC Reversal: " + (is_bull ? "LONG" : "SHORT") + " — flipped, then flipped again on the very next bar\n" + f_fmt_ny_time_sec(t)

// v17 (09/17/2026): CE10117 relief round 2, same report (100333/100256, over by 77 after v16's fix
// brought it down from 201). Two more small moves, both flagged as "next targets" in the main script's
// own v7.10 changelog: (1) f_htf_is_reversal — the small boolean expression behind the v7.08
// htf_reversal named var (bull/bear OR, a bar-count subtraction, an equality check) moved here as a
// pure 4-parameter function; the main script still keeps its own local htf_reversal var (it's read at
// 2 sites there) but that var's right-hand side is now one function call instead of the full inline
// expression. (2) f_htf_reversal_note — the static "⚠ HTF Reversal..." tooltip string itself, with no
// parameters at all, so the main script calls it instead of carrying the string literal. Same
// proven-safe "pure parameters/no parameters in, CBC-internal state never read" category as
// f_ltf_reversal_tooltip above.
export f_htf_is_reversal(bool flip_bull, bool flip_bear, int close_n, int last_flip_bar_n) =>
    (flip_bull or flip_bear) and (close_n - last_flip_bar_n == 1)

export f_htf_reversal_note() =>
    "⚠ HTF Reversal — flipped, then flipped again on the very next HTF bar"

// v19 (09/18/2026): resolves the HTF CBC Flip anticipatory dot's AND the anticipatory arrow's pending
// prediction in one call, 8 plain scalar parameters (v18's array version made the main script's count
// worse — see the changelog note above). For each of the dot/arrow: if it has a pending wait-time AND
// the live HTF bar has moved on past it (meaning the bar it was waiting on has now closed), check
// whether the now-confirmed direction matches what was predicted — if not, delete that label; either
// way the returned wait-time resets to na so the same prediction never resolves twice. Returns a
// 2-tuple (the dot's new wait-time, the arrow's new wait-time) for the caller to reassign onto its own
// persistent vars with :=, since Pine's tuple-declare syntax can't target an existing var directly.
export f_resolve_flip_early(label lbl_dot, float pred_dot, int wait_dot, label lbl_arrow, float pred_arrow, int wait_arrow, float confirmed, int live_t) =>
    int new_wait_dot = wait_dot
    if not na(wait_dot) and live_t != wait_dot
        if confirmed != pred_dot
            label.delete(lbl_dot)
        new_wait_dot := na
    int new_wait_arrow = wait_arrow
    if not na(wait_arrow) and live_t != wait_arrow
        if confirmed != pred_arrow
            label.delete(lbl_arrow)
        new_wait_arrow := na
    [new_wait_dot, new_wait_arrow]

// v19: builds and creates the HTF CBC Flip anticipatory DOT's full label — ticker header, direction,
// "within Ns of close" mechanics note, a fired timestamp (via f_fmt_ny_time_sec above), the EMA-
// distance string, and an optional detailed-snapshot line — all passed in as parameters, no
// CBC-internal state read. This was the single most expensive piece of the v7.13 addition (a brand-new
// multi-part tooltip concatenation, same weight-class as the v7.08 LTF Reversal tooltip that needed
// the same treatment at v7.10).
export f_flip_early_dot(string tkr, bool isBull, int secsBeforeClose, int firedT, string emaDist, bool detailed, string snapshot, color col) =>
    string tip = tkr + " —\n• HTF CBC Flip: " + (isBull ? "LONG" : "SHORT") + " (ANTICIPATORY — within " + str.tostring(secsBeforeClose) + "s of HTF bar close, NOT yet confirmed; can revert before close)\nFired: " + f_fmt_ny_time_sec(firedT) + "\n" + emaDist + (detailed ? "\n" + snapshot : "")
    label.new(bar_index, na, text="", tooltip=tip, yloc=yloc.belowbar, style=label.style_circle, size=size.small, color=color.new(col, 50), textcolor=col)

// v19: builds and creates the HTF CBC Flip anticipatory ARROW's label — y-offset/color/style all
// picked by a direction ternary, same pattern as the confirmed-arrow draw site this file doesn't touch.
export f_flip_early_arrow(bool isBull, float lo, float hi, color longCol, color shortCol, string sz) =>
    label.new(x=bar_index, y=isBull ? lo - (hi - lo) * 0.35 : hi + (hi - lo) * 0.35, text="", color=isBull ? color.new(longCol, 50) : color.new(shortCol, 50), style=isBull ? label.style_triangleup : label.style_triangledown, size=sz)

// Appends ln_txt onto base as a new line (prefixing "\n" only if base already has content). Used
// throughout the alert-email builders to accumulate multi-bullet message bodies one line at a time.
export f_add_line(string base, string ln_txt) =>
    base + (base != "" ? "\n" : "") + ln_txt

// Maps a "Top left"/"Bottom right"/etc. settings-panel string to its position.* value, defaulting to
// top_right for anything unrecognized. Used by every table (Status, Pivot, Confluence Cells) to place
// itself from a single position input.
export f_status_pos(string p) =>
    switch p
        "Top left" => position.top_left
        "Top center" => position.top_center
        "Top right" => position.top_right
        "Middle left" => position.middle_left
        "Middle center" => position.middle_center
        "Middle right" => position.middle_right
        "Bottom left" => position.bottom_left
        "Bottom center" => position.bottom_center
        "Bottom right" => position.bottom_right
        => position.top_right

// Maps a "Tiny"/"Small"/"Normal"/"Large"/"Huge" settings-panel string to its size.* value, defaulting
// to size.small for anything unrecognized.
export f_table_text_size(string s) =>
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.small

// Formats the CHART's own timeframe as a short display string ("15m", "1D", "1W", etc., or the raw
// timeframe.period as a fallback). Reads only Pine's built-in timeframe.* namespace, which reflects
// the calling script's own chart context even from inside a library — no CBC state involved.
export f_chart_tf_disp() =>
    string r = timeframe.isminutes ? str.tostring(timeframe.multiplier) + "m" : timeframe.isseconds ? str.tostring(timeframe.multiplier) + "s" : timeframe.isdaily ? str.tostring(timeframe.multiplier) + "D" : timeframe.isweekly ? str.tostring(timeframe.multiplier) + "W" : timeframe.ismonthly ? str.tostring(timeframe.multiplier) + "M" : timeframe.period
    r

// Same display-string formatting as f_chart_tf_disp, but for an arbitrary timeframe string passed in
// (used for the HTF/MTF timeframe inputs, which aren't the chart's own timeframe).
export f_htf_tf_disp(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string r = tf
    if not na(sec) and sec > 0
        if sec == 86400
            r := "1D"
        else if sec == 604800
            r := "1W"
        else if sec < 86400 and sec % 3600 == 0
            r := str.tostring(sec / 3600) + "H"
        else if sec < 86400 * 7 and sec % 60 == 0
            r := str.tostring(sec / 60) + "m"
        else
            r := tf
    r

// Strips the trailing " Crossing (...)"/" Approaching (...)" detail off a Level Proximity Alerts
// bullet string, leaving just the level's own name — used to detect when the SAME level is still the
// latched proximity match across bars (vs. a different level taking over), without re-parsing the
// full bullet text at every comparison site.
export f_prox_latch_name(string bullet) =>
    string result = bullet
    int sep_c = str.pos(bullet, " Crossing (")
    int sep_a = str.pos(bullet, " Approaching (")
    if not na(sep_c)
        result := str.substring(bullet, 0, sep_c)
    else if not na(sep_a)
        result := str.substring(bullet, 0, sep_a)
    result

// Finds the best-matching HTF bar (within max_off bars back) whose time window [t_open, t_close]
// contains this LTF bar's timestamp, and returns an anchor point [bar_index, price] slightly below
// that bar's low — used to place the HTF-flip long-side label/line near the actual HTF candle that
// flipped, not just the current LTF bar. Reads only bar_index/time[]/low[]/high[], Pine's own
// built-in series (available from library scope the same way f_obAdd already reads high[_idx]).
export f_htf_anchor_long(float sig_lo, int t_open, int t_close, int max_off) =>
    int best_off = 0
    float best_err = na
    bool found = false
    for off = 0 to max_off
        if bar_index >= off
            int ot = time[off]
            if not na(ot) and not na(t_open) and not na(t_close) and ot >= t_open and ot <= t_close
                float err = math.abs(low[off] - sig_lo)
                if not found or err < best_err or (err == best_err and off > best_off)
                    best_err := err
                    best_off := off
                    found := true
    int off_use = found ? best_off : 0
    [bar_index - off_use, low[off_use] - (high[off_use] - low[off_use]) * 0.3]

// Same as f_htf_anchor_long, but anchors above the matching bar's high — used for the HTF-flip
// short-side label/line.
export f_htf_anchor_short(float sig_hi, int t_open, int t_close, int max_off) =>
    int best_off = 0
    float best_err = na
    bool found = false
    for off = 0 to max_off
        if bar_index >= off
            int ot = time[off]
            if not na(ot) and not na(t_open) and not na(t_close) and ot >= t_open and ot <= t_close
                float err = math.abs(high[off] - sig_hi)
                if not found or err < best_err or (err == best_err and off > best_off)
                    best_err := err
                    best_off := off
                    found := true
    int off_use = found ? best_off : 0
    [bar_index - off_use, high[off_use] + (high[off_use] - low[off_use]) * 0.3]

// Formats a reference-level label's text from the level's name and price, honoring the two
// "Show Level Name"/"Level Price" master toggles — used by every YDH/YDL/YDC/PMH/PML/ORB/Pivot label
// across the chart. show_name/show_price are passed in since a library can't read the main script's
// own input.bool globals directly.
export f_level_label_text(string level_name, float level_price, bool show_name, bool show_price) =>
    string result = ""
    if show_name and show_price
        result := level_name + " " + str.tostring(level_price, "#.##")
    else if show_name
        result := level_name
    else if show_price
        result := str.tostring(level_price, "#.##")
    result

// A+ Setup - Major Pivot Proximity: appends label to note (comma-joined) if val is within dist points
// of the current close. dist is passed in (was the main script's own aplus_pivot_dist top-level var).
export f_apn(string note, float val, string label, float dist) =>
    not na(val) and math.abs(close - val) <= dist ? note + (note != "" ? ", " : "") + label : note

// A+ Setup - Major Pivot Proximity: the effective proximity distance, in points — either the user's
// explicit override, or an auto default based on symbol root (50 for MNQ, 5 otherwise). override_val
// is passed in (was the main script's own aplus_pivot_dist_override input read directly).
export f_aplus_pivot_dist(float override_val) =>
    string root = syminfo.root
    float auto_pts = root == "MNQ" ? 50.0 : 5.0
    override_val > 0 ? override_val : auto_pts

// Chart-level label overlap handling (v7.72): groups a set of price values into clusters of mutually
// "close" (within dist points) entries and returns, for each index, the index of its group's leader
// (the lowest index in that group). An index that is its own leader (result[i] == i) is either a
// singleton or the representative of a multi-member group; every other member of a group points to
// that same leader index. Union-by-chaining via relaxation passes (n passes over all pairs guarantees
// full propagation for a chain of up to n entries) — cheap at the ~16-22 levels this is ever called
// with, so no more efficient union-find structure is worth the added complexity here.
export f_level_group_leader(float[] prices, float dist) =>
    int n = array.size(prices)
    int[] leader = array.new_int(n)
    for i = 0 to n - 1
        array.set(leader, i, i)
    for pass = 0 to n - 1
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                if math.abs(array.get(prices, i) - array.get(prices, j)) <= dist
                    int li = array.get(leader, i)
                    int lj = array.get(leader, j)
                    int min_l = math.min(li, lj)
                    if li != min_l
                        array.set(leader, i, min_l)
                    if lj != min_l
                        array.set(leader, j, min_l)
    leader

// Chart-level label overlap handling (v7.72): builds the combined text for a merged group of level
// labels (e.g. "PMH / LN ORB-H 4308.4"), honoring the same show_name/show_price toggles as the
// single-level f_level_label_text() above — names joined with " / " when shown, one shared price
// (the group leader's own y, already confirmed within dist of every member) appended when shown.
export f_level_merged_text(string[] names, float price, bool show_name, bool show_price) =>
    string result = ""
    if show_name
        result := array.join(names, " / ")
    if show_price
        result := result + (result != "" ? " " : "") + str.tostring(price, "#.##")
    result

// "Potential flop close to VWAP" warning: on a long setup, VWAP should sit comfortably ABOVE the
// flip price (nothing overhead to cap the move); on a short setup, VWAP should sit comfortably BELOW
// it. If VWAP is on the expected side but closer than min_dist points, returns a warning string —
// otherwise "". Does NOT warn when VWAP is on the "wrong" side entirely (dist <= 0); that's a
// different, more severe situation than "close," left for a future check if ever wanted.
export f_vwap_flip_warning(float vwap_val, float flip_price, bool is_long, float min_dist) =>
    string result = ""
    if not na(vwap_val) and not na(flip_price) and not na(min_dist)
        float dist = is_long ? vwap_val - flip_price : flip_price - vwap_val
        if dist > 0 and dist < min_dist
            result := "⚠ Potential flop - close to VWAP (" + str.tostring(dist, "#.##") + " pts)"
    result

// "Potential flop close to <pivot level>" warning — same idea as f_vwap_flip_warning above, but
// checks all 6 non-PP Pivot Points levels (R3/R2/R1/S1/S2/S3, packed in piv_vals/piv_lbls the same way
// the main script's Key Level Alert already loops over them) instead of VWAP. Whichever qualifying
// level is on the "overhead" side of the flip price for a long (or "underneath" for a short) AND
// nearest wins — checked by actual value/position relative to price, not by R-vs-S label, since a
// level can in principle sit on either side of price. Returns "" if no level qualifies (none on the
// expected side within min_dist) or PP is the only match (PP is deliberately skipped by label).
export f_pivot_flip_warning(float flip_price, float[] piv_vals, string[] piv_lbls, bool is_long, float min_dist) =>
    string result = ""
    if not na(flip_price) and not na(min_dist)
        float best_dist = 1e10
        string best_lbl = ""
        for i = 0 to array.size(piv_vals) - 1
            string lbl = array.get(piv_lbls, i)
            if lbl != "PP"
                float lvl = array.get(piv_vals, i)
                if not na(lvl)
                    float dist = is_long ? lvl - flip_price : flip_price - lvl
                    if dist > 0 and dist < best_dist
                        best_dist := dist
                        best_lbl := lbl
        if best_lbl != "" and best_dist < min_dist
            result := "⚠ Potential flop - close to " + best_lbl + " (" + str.tostring(best_dist, "#.##") + " pts)"
    result

// v6.44 CE10117 relief round: moved 7 more pure, parameter-only (or built-in-only) helpers out of the
// main script — same technique proven safe/effective at v6.18/v6.23/v6.40 (library code compiles
// separately and doesn't count against the main script's budget at all). None of these touch CBC's
// own internal request.security/CBC-state pipeline.

// Market session by New York time-of-day ("Asian"/"London"/"New York"). Hardcodes the "America/
// New_York" timezone string directly (was the main script's own ny_tz constant, always this exact
// literal, so no need to thread it through as a parameter).
export f_market_session_et() =>
    int hm = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    hm >= 20 * 60 or hm < 3 * 60 ? "Asian" : hm < 9 * 60 + 30 ? "London" : "New York"

// Asian OR anchor (8 PM ET open), same "America/New_York" literal as above.
export f_asia_or_open_ms() =>
    int cand = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 20, 0)
    hour(time, "America/New_York") < 3 and time < cand ? cand - 86400000 : cand

// Trailing-stop timeframe step-up: 3->15, 15->60, 60->240, else unchanged. Pure — reads only
// timeframe.period (a Pine built-in), no main-script state.
export f_stop_tf() =>
    string ctf = timeframe.period
    ctf == "3" or ctf == "15" ? "3" : ctf == "60" ? "15" : ctf == "240" ? "60" : ctf

// Breakeven + step-trail size, auto by symbol root (MES/MGC=5, MNQ=30, M2K=3, other=5) or the main
// script's own manual override if set (passed in — a library can't read the main script's input
// directly).
export f_be_trail_step(float override_val) =>
    string root = syminfo.root
    float auto_pts = root == "MES" or root == "MGC" ? 5.0 : root == "MNQ" ? 30.0 : root == "M2K" ? 3.0 : 5.0
    override_val > 0 ? override_val : auto_pts

// VWAP Bounce / flip-warning shared min-distance auto table (MES/MGC=6, M2K=4, MNQ=60, other=6) — pure,
// syminfo.root only.
export f_vwap_bounce_min_dist() =>
    string root = syminfo.root
    root == "MES" or root == "MGC" ? 6.0 : root == "M2K" ? 4.0 : root == "MNQ" ? 60.0 : 6.0

// Shared VWAP-near-flip / Pivot-Level-near-flip threshold: the main script's 3 per-symbol overrides
// (MGC/MES/MNQ) passed in, falling back to f_vwap_bounce_min_dist()'s auto table for M2K/other/unset.
export f_flip_warn_min_dist(float mgc_ovr, float mes_ovr, float mnq_ovr) =>
    string root = syminfo.root
    float ovr = root == "MGC" ? mgc_ovr : root == "MES" ? mes_ovr : root == "MNQ" ? mnq_ovr : 0.0
    ovr > 0 ? ovr : f_vwap_bounce_min_dist()

// LTF/HTF/MTF tier sort order by ascending timeframe (minutes) — chart_tf/htf_tf/mtf_tf passed in
// since a library can't read the main script's own htf_timeframe/mtf_timeframe inputs directly.
export f_ltf_htf_mtf_order(string htf_tf, string mtf_tf) =>
    array<int> minutes = array.from(int(timeframe.in_seconds() / 60), int(timeframe.in_seconds(htf_tf) / 60), int(timeframe.in_seconds(mtf_tf) / 60))
    array.sort_indices(minutes, order.ascending)

// Shared LTF/HTF/MTF status-table row helper (CBC/EMA cloud/Structure rows, both the Status table and
// the — currently commented-out — Historical Bar Panel). Already fully parameterized in the main
// script (no reliance on any of its own globals beyond what's passed in), so this is a pure move with
// no signature changes needed at any call site beyond the obLib. prefix.
export f_add_tf_row(table tbl, int start_row, string label_base,
             string ltf_msg, color ltf_bg,
             string htf_msg, color htf_bg,
             string mtf_msg, color mtf_bg,
             bool show_ltf, bool show_htf, bool show_mtf, bool show_mtf_field,
             string chart_tf, string htf_tf, string mtf_tf,
             color label_bg, color label_txt, color on_txt, string txt_sz,
             array<int> order,
             string ltf_tt = "", string htf_tt = "", string mtf_tt = "") =>
    int r = start_row
    for i = 0 to 2
        int tier = array.get(order, i)
        if tier == 0 and show_ltf
            table.cell(tbl, 0, r, label_base + " (" + chart_tf + ")", bgcolor=label_bg, text_color=label_txt, text_size=txt_sz, text_halign=text.align_left, tooltip=ltf_tt)
            table.cell(tbl, 1, r, ltf_msg, bgcolor=ltf_bg, text_color=on_txt, text_size=txt_sz, text_halign=text.align_right)
            r += 1
        else if tier == 1 and show_htf
            table.cell(tbl, 0, r, label_base + " (" + htf_tf + ")", bgcolor=label_bg, text_color=label_txt, text_size=txt_sz, text_halign=text.align_left, tooltip=htf_tt)
            table.cell(tbl, 1, r, htf_msg, bgcolor=htf_bg, text_color=on_txt, text_size=txt_sz, text_halign=text.align_right)
            r += 1
        else if tier == 2 and show_mtf and show_mtf_field
            table.cell(tbl, 0, r, label_base + " (" + mtf_tf + ")", bgcolor=label_bg, text_color=label_txt, text_size=txt_sz, text_halign=text.align_left, tooltip=mtf_tt)
            table.cell(tbl, 1, r, mtf_msg, bgcolor=mtf_bg, text_color=on_txt, text_size=txt_sz, text_halign=text.align_right)
            r += 1
    r

// v6 (09/13/2026): Price Action Structure marker label — creates ONE label per call (no array/
// mitigation management needed, unlike Order Blocks' boxes, since these are meant to persist as a
// historical record on the chart, not be deleted). _isHigh picks the label's pointer direction
// (down-pointing/placed-above for a high pivot, up-pointing/placed-below for a low pivot);
// color=color(na) hides the shape's own fill/border so only the colored text shows, matching a plain
// text-marker look rather than a filled callout box.
export f_paLabel(int _barIdx, float _y, string _txt, color _col, bool _isHigh, string _size) =>
    label.new(_barIdx, _y, _txt, style = _isHigh ? label.style_label_down : label.style_label_up, color = color(na), textcolor = _col, size = _size)

// v9 (09/13/2026): CE10117 trim pass — single-row status-table helper, same idiom as f_add_tf_row
// just above but for the ~19 single-row fields (Market, Price, Opening range, VWAP, EMA 200, Fib Zone,
// last-flip/flip-level/pivot rows per tier, Chart, Confluence Score, etc.) that were each writing out
// the identical two table.cell()+increment shape inline in the main script. Pure params only (table
// ref, row index, label/tooltip/value text, the 4 style values that stay constant across a whole
// render pass) — no CBC state read, same proven-safe category as f_obAdd/f_htfObAdd/f_paLabel above.
// Returns the incremented row index so call sites keep the same "r := obLib.f_...' idiom already used
// for f_add_tf_row.
export f_add_status_row(table tbl, int row, string label, string tooltip, string val, color valBg, color labelBg, color labelTxt, color valTxt, string txtSz) =>
    table.cell(tbl, 0, row, label, bgcolor=labelBg, text_color=labelTxt, text_size=txtSz, text_halign=text.align_left, tooltip=tooltip)
    table.cell(tbl, 1, row, val, bgcolor=valBg, text_color=valTxt, text_size=txtSz, text_halign=text.align_right)
    row + 1

// v11 (09/14/2026): CE10117 trim pass — reference-level label create-or-update helper. Collapses the
// ~15 near-identical "if na(lbl) -> label.new(...) else -> label.set_x/set_y/set_text/set_textcolor"
// blocks scattered across YDH/YDL/PMH/PML/YDC/LN-H/LN-L/AS-H/AS-L/the Pivot Points loop/the 3 ORB
// session H/L pairs (each already funneling its display TEXT through obLib.f_level_label_text) into
// one call per site. Takes the existing label ref in (na on the first call, already-created after
// that) and returns the label to reassign back to that same var — same "pass state in, mutate/create,
// return it" shape already used by f_obUpdateSwing, just for a single label instead of a swing-state
// tuple. use_bar_time selects xloc.bar_time (the YDH/YDL/PMH/PML/YDC/LN/AS/Pivot group, all anchored to
// a session-start time) vs the default xloc.bar_index (the 3 ORB session pairs, anchored to a bar
// offset) — the one structural difference between the two label groups in the main script. Always
// re-applies textcolor on the update branch even for the ORB group (whose color never actually changes
// bar to bar) — a harmless same-value re-set, done anyway so one function covers every call site
// instead of needing a second variant.
export f_levelLabel(label lbl, int x, float y, string txt, color textcol, string sz, bool use_bar_time) =>
    label result = lbl
    if na(result)
        result := use_bar_time ? label.new(x, y, txt, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=textcol, style=label.style_label_left, size=sz) : label.new(x, y, txt, color=color.new(color.white, 100), textcolor=textcol, style=label.style_label_left, size=sz)
    else
        label.set_x(result, x)
        label.set_y(result, y)
        label.set_text(result, txt)
        label.set_textcolor(result, textcol)
    result

// v12 (09/14/2026): Equal H&L connecting line — draws a plain dashed segment between the two matched
// pivots (x1/y1 = the earlier pivot, x2/y2 = the newer one) so it's visually clear WHICH prior swing a
// new EQH/EQL label is paired with, instead of just tagging the new pivot in isolation. One-shot,
// historical (no management/deletion), same category as f_paLabel — pure params, no CBC-state read.
export f_eqLine(int x1, float y1, int x2, float y2, color col) =>
    line.new(x1, y1, x2, y2, color=col, width=1, style=line.style_dashed)

// v13 (09/15/2026): ORB Retest marker helper — collapses the 6 near-identical box.new()+label.new()
// call sites (Pass/Flip/Fail-from, both directions) in the main script's ORB Retest marker-drawing
// block into one shared function. Each call site previously differed only in y (top/bottom offset),
// half (box half-height), border color, and tooltip text — all now plain parameters, same
// "pass state in, no CBC-internal state read" category as f_obAdd/f_paLabel/f_levelLabel above.
// bar_index is read directly (a Pine built-in, available from library scope the same way f_obAdd
// already reads it) rather than passed in, since it's always "this bar" at every call site.
export f_orbRetestMarker(float y, float half, color bcol, string tip) =>
    box.new(left=bar_index - 1, right=bar_index, top=y + half, bottom=y - half, border_color=bcol, border_width=2, bgcolor=color(na))
    label.new(x=bar_index, y=y, text="", tooltip=tip, color=color.new(color.black, 100), style=label.style_circle, size=size.tiny)

// v24 (09/19/2026): two new exports for the CBC main script's Pre-Trade Checklist items 3/4 (Stop/
// Target Structure Checklist) — f_checklist_scan() (12-type level proximity scan) and
// f_render_level_type_checklist() (its table renderer, called once per side). See each export's own
// comment further down for details.
//
// v23 (09/19/2026): new "Confluences Checklist" table export, f_render_confluence_checklist() — see
// its own comment right before the export below. Built directly in the library from the start (per
// this file's own convention #14 about first-time additions), not first added to the main script and
// moved later.
//
// v22 (09/19/2026): COMPILE FIX for a mistake in v21's own edit — the new f_render_confluence_cells()
// export got inserted in the middle of f_next_two_levels() (before its own final
// `[target_txt, stop_txt]` return line instead of after it), so f_next_two_levels() never returned
// and f_render_confluence_cells() ended with an orphaned, undeclared-identifier return line instead
// of its own `true`. Reported by the user as CE10272 "Undeclared identifier target_txt". Fixed by
// moving the `[target_txt, stop_txt]` line back to the end of f_next_two_levels()'s own body (right
// after `stop_txt := "—"`) and leaving f_render_confluence_cells() ending on its own `true`, exactly
// as each function had before this mistake. No other content changed from v21 — same 34-parameter
// f_render_confluence_cells() export.
//
// v21 (09/19/2026): moved f_render_confluence_cells()'s entire body here (see its own comment right
// before the export below) — a CE10117 token-budget trim requested directly by the user ("move stuff
// to library - reduce tokens") after v7.20 still reported 101582/100256.
//
// v20 (09/19/2026): "Next two levels" scan for the CBC main script's Next Target Levels / Next Stop
// Levels Status-table rows (Pre-Trade Checklist items 3/4). Given a pool of levels (price_arr) with
// matching labels (label_arr), the live trade-direction bool (dir_long: true favors levels above
// price, false favors levels below), and the current close (px), returns [target text, stop text] —
// each up to 2 "Label price (±N.N pts)" segments joined by " | ", nearest-first, or "—" if nothing
// qualifies (e.g. every level is na). Targets are the nearest 2 levels on the side dir_long favors;
// stops are the nearest 2 on the opposite side. Mirrors the sort_indices "closest N" pattern already
// used elsewhere in this file's Pivot Points logic. Fully parameterized, no CBC-internal state read —
// generalized to any pool size via array.size(price_arr) rather than a hardcoded count.
export f_next_two_levels(float[] price_arr, string[] label_arr, bool dir_long, float px) =>
    int n = array.size(price_arr)
    var float[] above_dist = array.new_float(n, na)
    var float[] below_dist = array.new_float(n, na)
    for i = 0 to n - 1
        float lvl = array.get(price_arr, i)
        array.set(above_dist, i, (na(lvl) or lvl <= px) ? 1e10 : lvl - px)
        array.set(below_dist, i, (na(lvl) or lvl >= px) ? 1e10 : px - lvl)
    array<int> above_order = array.sort_indices(above_dist, order.ascending)
    array<int> below_order = array.sort_indices(below_dist, order.ascending)
    array<int> target_order = dir_long ? above_order : below_order
    array<int> stop_order = dir_long ? below_order : above_order
    array<float> target_dist = dir_long ? above_dist : below_dist
    array<float> stop_dist = dir_long ? below_dist : above_dist
    // v7.28: distances now carry a sign relative to the live CBC direction, same convention as the
    // Status table's VWAP/EMA200 rows and the Structure Checklist tables -- target segments (the
    // favorable side, always) show "+N.N", stop segments (the opposite side) show "-N.N". Per direct
    // request ("all the points are positive they should be in relation to the direction of cbc").
    string target_txt = ""
    int target_found = 0
    for i = 0 to n - 1
        if target_found < 2
            int ti = array.get(target_order, i)
            float td = array.get(target_dist, ti)
            if td < 1e9
                target_txt := target_txt + (target_found > 0 ? "  |  " : "") + array.get(label_arr, ti) + " " + str.tostring(array.get(price_arr, ti), "#.##") + " (+" + str.tostring(td, "#.#") + " pts)"
                target_found += 1
    if target_found == 0
        target_txt := "—"
    string stop_txt = ""
    int stop_found = 0
    for i = 0 to n - 1
        if stop_found < 2
            int si = array.get(stop_order, i)
            float sd = array.get(stop_dist, si)
            if sd < 1e9
                stop_txt := stop_txt + (stop_found > 0 ? "  |  " : "") + array.get(label_arr, si) + " " + str.tostring(array.get(price_arr, si), "#.##") + " (-" + str.tostring(sd, "#.#") + " pts)"
                stop_found += 1
    if stop_found == 0
        stop_txt := "—"
    [target_txt, stop_txt]

// v21 (09/19/2026): the entire Confluence Factors cells table (`f_render_confluence_cells()` in the
// CBC main script) moved here as one export — table lifecycle (create/delete/recreate on
// position/row-count change), the 3 per-cell array.from() builds (text/color/tooltip, 10 factors),
// and the draw loop. Fully parameterized — 10 factor bools + 8 "touch" bools (2 of the 10 factors,
// HTF and Cloud, have no separate touch/amber state so only 8 touch params exist), the 4 status
// colors + text color, htf_timeframe/timeframe multiplier for the HTF cell's label, the live
// confluence score/max/threshold, the same-score-different-mix highlight flag, and the 3 display
// settings (use table at all, position string, row count) plus text size. No CBC-internal state read
// beyond what's passed in — same "pass state in as parameters" category as f_next_two_levels above.
// `var table`/`var string`/`var int` locals persist per-call-site across bars exactly as they did when
// this same code lived in the main script — moving a function to a library changes nothing about
// Pine's var/table persistence semantics, only which compiled-token budget the body counts against.
export f_render_confluence_cells(bool use_table, string position, int rows, string text_size,
     color border_col, color frame_col, color bull_col, color neutral_col, color amber_col, color highlight_col, color text_col,
     bool f_htf, bool f_cloud, bool f_zone, bool f_sweep, bool f_volume, bool f_fib, bool f_structure, bool f_level, bool f_flip, bool f_htf_flip,
     bool f_zone_touch, bool f_sweep_touch, bool f_volume_touch, bool f_fib_touch, bool f_structure_touch, bool f_level_touch, bool f_flip_touch, bool f_htf_flip_touch,
     string htf_tf, int ltf_mult, int score, int max_score, int alert_threshold, bool same_score_diff_mask) =>
    var table conf_tbl = na
    var string conf_pos_last = ""
    var int conf_rows_last = 0
    if not use_table
        table.delete(conf_tbl)
        conf_tbl := na
        conf_pos_last := ""
        conf_rows_last := 0
    else
        int conf_rows = math.min(11, math.max(1, rows))
        int conf_cols = int(math.ceil(11.0 / conf_rows))
        if not na(conf_tbl) and (conf_pos_last != position or conf_rows_last != conf_rows)
            table.delete(conf_tbl)
            conf_tbl := na
        if na(conf_tbl)
            conf_tbl := table.new(f_status_pos(position), conf_cols, conf_rows, bgcolor=color.new(#020617, 0), border_color=border_col, border_width=1, frame_color=frame_col, frame_width=2)
            conf_pos_last := position
            conf_rows_last := conf_rows
        array<string> conf_texts = array.from("[" + (f_htf ? "✓" : "✗") + "H" + htf_tf, (f_cloud ? "✓" : "✗") + "Cld", (f_zone ? "✓" : "✗") + "Zn", (f_sweep ? "✓" : "✗") + "Swp" + "]", (f_volume ? "✓" : "✗") + "Vol", (f_fib ? "✓" : "✗") + "Fib", (f_structure ? "✓" : "✗") + "Str", (f_level ? "✓" : "✗") + "Lvl", (f_flip ? "✓" : "✗") + "Flp" + str.tostring(ltf_mult), (f_htf_flip ? "✓" : "✗") + "HFV")
        array<color> conf_colors = array.from(f_htf ? bull_col : neutral_col, f_cloud ? bull_col : neutral_col, f_zone ? bull_col : (f_zone_touch ? amber_col : neutral_col), f_sweep ? bull_col : (f_sweep_touch ? amber_col : neutral_col), f_volume ? bull_col : (f_volume_touch ? amber_col : neutral_col), f_fib ? bull_col : (f_fib_touch ? amber_col : neutral_col), f_structure ? bull_col : (f_structure_touch ? amber_col : neutral_col), f_level ? bull_col : (f_level_touch ? amber_col : neutral_col), f_flip ? bull_col : (f_flip_touch ? amber_col : neutral_col), f_htf_flip ? bull_col : (f_htf_flip_touch ? amber_col : neutral_col))
        array<string> conf_tips = array.from("HTF — the HTF CBC direction agrees with the current LTF direction. Weight: 4.", "Cloud (LTF EMA) — the LTF EMA9/20 cloud agrees with the current direction. Weight: 1.", "Zone — BRSG zone or HTF Flip FVG touch. Amber = touched, but outside the recency window. Weight: 2.", "Sweep — liquidity sweep of the last confirmed HTF swing. Amber = touched, but outside the recency window. Weight: 1.", "Volume Spike on the HTF flip candle. Amber = touched, but its toggle is off. Weight: 1.", "Fib Golden Pocket (50%-61.8%) touch. Amber = touched, but outside the recency window or its toggle is off. Weight: 1.", "HTF Structure Break (BOS/CHoCH). Amber = touched, but its toggle is off. Weight: 1.", "Level — price is currently near a key level. Amber = touched, but its toggle is off (off by default). Weight: 1.", "Flip (LTF) — valid from the LTF's own flip until the next reverse flip. Amber = touched, but its toggle is off (off by default). Weight: 1.", "HTF Flip FVG — true while the current flip's Fair Value Gap remains unfilled; invalidated the instant price trades back into it. Amber = true, but its toggle is off (off by default). Weight: 1.")
        for i = 0 to 10
            table.cell(conf_tbl, i % conf_cols, i / conf_cols, i == 0 ? "S:" + str.tostring(score) + "/" + str.tostring(max_score) : array.get(conf_texts, i - 1), bgcolor=i == 0 ? same_score_diff_mask ? highlight_col : (score >= alert_threshold ? bull_col : neutral_col) : array.get(conf_colors, i - 1), text_color=text_col, text_size=f_table_text_size(text_size), text_halign=text.align_center, tooltip=i == 0 ? "Live Confluence Score — counted factors / max possible (the denominator shrinks if a toggleable factor is switched off above)." : array.get(conf_tips, i - 1))
    true

// v23 (09/19/2026): "Confluences Checklist" table for the CBC main script — a second, separate
// confluence display laid out to mirror the user's own Pre-Trade Checklist item 2 ("Confluences")
// exactly: one checkbox square + label per factor, 2 columns x 4 rows (CBC LTF/EMA Cloud LTF/VWAP/
// Structure HTF on the left, CBC HTF/EMA Cloud HTF/EMA20 on the right — the last cell, row 4 col 2,
// is left blank since there are only 7 items). Built as a library export from the start, same "pass
// state in as parameters, no CBC-internal state read" category as f_render_confluence_cells() above.
// 5 of the 7 items reuse existing confluence-factor booleans passed straight through (flip_ltf =
// CBC LTF, cbc_htf = CBC HTF, cloud_ltf = EMA Cloud LTF, cloud_htf = EMA Cloud HTF, structure_htf =
// Structure HTF); VWAP and EMA20 are brand-new checks, computed HERE from raw price/vwap/ema20
// values rather than in the main script, to keep the main-script call site's own token cost to a
// handful of parameter names rather than two extra top-level boolean declarations. "In the direction
// of the trade" means price is on the favorable side of that level for the live LTF CBC direction
// (dir_long): above VWAP/EMA20 when long, below when short. Each item is drawn as 2 cells — a
// checkbox cell (colored bull/neutral, holding a checkmark or nothing) and a plain label cell (fixed
// dark background, no color coding) — 4 columns x 4 rows total. `var table` persists per call site
// across bars exactly as it would in the main script; `var string cl_pos_last` handles delete+rebuild
// on a position change, same pattern as f_render_confluence_cells()'s conf_pos_last above (this
// table's own row/column COUNT never changes, so unlike that one there's no rows-changed branch
// needed here).
// v7.28 (this session's own count, actual published number to be confirmed): unchecked checkbox
// cells now show "✗" instead of a blank string, matching the ✓/✗ convention the compact Confluence
// Factors cells table already uses -- per direct request ("checkbox to left should show"), a blank
// cell gave no visual indication a checkbox was even there when unchecked.
// v7.30: cell colors now reflect each factor's own ACTUAL bull/bear reading (green when that specific
// signal is bullish, red when bearish) instead of a plain agree=green/disagree=gray scheme -- per
// direct request ("if cbc ltf is red bearish in status just make cbc ltf red in the confluence
// table"), matching the Status table's own red-for-bearish/green-for-bullish coloring on the matching
// rows. New params: `bear_col` (the missing 3rd status color -- this function only ever had bull/
// neutral before), `cbc_htf_bull` (the HTF CBC's own raw direction, separate from `cbc_htf`'s
// "agrees with LTF" meaning), `cloud_ltf_bull`/`cloud_htf_bull` (the LTF/HTF EMA cloud's own raw
// direction, separate from `cloud_ltf`/`cloud_htf`'s "agrees" meaning). CBC LTF reuses `dir_long`
// directly for its own color (dir_long IS the live LTF CBC direction). VWAP/EMA20 needed no new
// param -- `vwap_ok`/`ema20_ok` were already direction-relative ("favorable"/"against", same v7.28
// convention as the Status table's own VWAP/EMA200 rows), so their color simply swaps neutral_col for
// bear_col. The ✓/✗ checkmark and its underlying agree/disagree logic are UNCHANGED for every item --
// only the checkbox cell's background color changed; a cell can now show a green background with a
// ✗ (this factor is bullish, but doesn't happen to be the live trade direction) or a red background
// with a ✓ (this factor is bearish AND the live trade direction is short, so it's checked). Structure
// HTF is deliberately left on the old agree=bull_col/disagree=neutral_col scheme -- no clean
// independent "structure is bullish/bearish" boolean was available to pass in without a larger,
// separately-scoped change (see the open item this round's changelog adds).
export f_render_confluence_checklist(bool use_table, string position, string text_size,
     color border_col, color frame_col, color bull_col, color bear_col, color neutral_col, color text_col,
     bool flip_ltf, bool cbc_htf, bool cbc_htf_bull, bool cloud_ltf, bool cloud_ltf_bull, bool cloud_htf, bool cloud_htf_bull, bool structure_htf,
     bool dir_long, float px, float vwap_val, float ema20_val) =>
    var table cl_tbl = na
    var string cl_pos_last = ""
    if not use_table
        table.delete(cl_tbl)
        cl_tbl := na
        cl_pos_last := ""
    else
        if not na(cl_tbl) and cl_pos_last != position
            table.delete(cl_tbl)
            cl_tbl := na
        if na(cl_tbl)
            cl_tbl := table.new(f_status_pos(position), 4, 4, bgcolor=color.new(#020617, 0), border_color=border_col, border_width=1, frame_color=frame_col, frame_width=2)
            cl_pos_last := position
        bool vwap_ok = not na(vwap_val) and (dir_long ? px > vwap_val : px < vwap_val)
        bool ema20_ok = not na(ema20_val) and (dir_long ? px > ema20_val : px < ema20_val)
        string txt_sz = f_table_text_size(text_size)
        color lbl_bg = color.new(#020617, 0)
        table.cell(cl_tbl, 0, 0, flip_ltf ? "✓" : "✗", bgcolor=dir_long ? bull_col : bear_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 1, 0, "CBC LTF", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
        table.cell(cl_tbl, 2, 0, cbc_htf ? "✓" : "✗", bgcolor=cbc_htf_bull ? bull_col : bear_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 3, 0, "CBC HTF", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
        table.cell(cl_tbl, 0, 1, cloud_ltf ? "✓" : "✗", bgcolor=cloud_ltf_bull ? bull_col : bear_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 1, 1, "EMA Cloud LTF", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
        table.cell(cl_tbl, 2, 1, cloud_htf ? "✓" : "✗", bgcolor=cloud_htf_bull ? bull_col : bear_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 3, 1, "EMA Cloud HTF", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
        table.cell(cl_tbl, 0, 2, vwap_ok ? "✓" : "✗", bgcolor=vwap_ok ? bull_col : bear_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 1, 2, "VWAP", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
        table.cell(cl_tbl, 2, 2, ema20_ok ? "✓" : "✗", bgcolor=ema20_ok ? bull_col : bear_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 3, 2, "EMA20", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
        table.cell(cl_tbl, 0, 3, structure_htf ? "✓" : "✗", bgcolor=structure_htf ? bull_col : neutral_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
        table.cell(cl_tbl, 1, 3, "Structure HTF", bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
    true

// v24 (09/19/2026): Stop/Target Structure Checklist scan for the CBC main script's Pre-Trade
// Checklist items 3/4 ("Stop/Target is at a real structural level — which type?"). Given a pool of
// scalar levels (price_pool) each tagged with a type id 0-10 (type_pool — see the main script's own
// comment on chk_type_pool for exactly which type each id is), the current price (px), which side to
// look on (want_above: true = levels at/above px, false = at/below), a tolerance (tol), and the two
// HTF order block box arrays, returns an array<bool> of size n_types+1 — index i (0..n_types-1) true
// if ANY pool entry of type i is within tol of px on the requested side; the last index (n_types) is
// the Order Block result, computed separately since boxes aren't scalar prices. For Order Block: bear
// boxes are checked on the "want_above" side (bear OB = resistance, sits above price) and bull boxes
// on the "not want_above" side (bull OB = support, sits below) — a box counts as "near" if px is
// within tol of its top or bottom edge, or already inside it. Pure parameters in, no CBC-internal
// state read, same "pass state in" category as f_next_two_levels/f_render_confluence_cells above.
// v27 (09/20/2026): REWORKED -- v26 originally tried to return a 2nd array (`dist`, alongside the
// existing bool `result`) as a tuple, `[result, dist]`. **Pine does not allow exported library
// functions to return tuples** -- the main script hit CE10172 ("Cannot assign a variable to a
// tuple... the right side must be a function call... returning a tuple") the moment it tried to
// destructure the call, because the compiler treats an exported function as single-return only, even
// though its own body ends in a bracketed multi-value expression. **New standing lesson: never design
// an exported library function around a tuple return -- pick ONE return value (an array, if multiple
// numbers are needed) and derive anything else from it at the call site instead.**
// Fix: this function now returns ONLY `array<float> dist` (size n_types+1) -- the nearest distance in
// points to a level of that type on the requested side (or Order Block's nearest edge distance),
// `na` if no level of that type exists on that side. The `tol` parameter and the bool result are both
// GONE from this function -- whether a given distance counts as "at that level" is now a render-time
// decision (`d <= tol`) made in f_render_level_type_checklist() below, which already receives `tol`
// anyway. This also means the checkbox and the points readout can never disagree with each other --
// they're now computed from the exact same `dist` value at render time instead of two separately
// tracked results from the scan.
export f_checklist_scan(float[] price_pool, int[] type_pool, int n_types, float px, bool want_above, box[] bull_ob, box[] bear_ob) =>
    array<float> dist = array.new_float(n_types + 1, na)
    for i = 0 to array.size(price_pool) - 1
        float lvl = array.get(price_pool, i)
        if not na(lvl)
            bool on_side = want_above ? lvl >= px : lvl <= px
            if on_side
                float d = math.abs(lvl - px)
                int t = array.get(type_pool, i)
                float cur_d = array.get(dist, t)
                if na(cur_d) or d < cur_d
                    array.set(dist, t, d)
    box[] obs = want_above ? bear_ob : bull_ob
    float ob_dist = na
    // v31 (RE10045 fix): "for i = 0 to array.size(obs) - 1" blows up at runtime on any bar where obs
    // is still empty (no order block box formed yet, e.g. early chart history) -- array.size(obs) - 1
    // is -1, and Pine's for loop does NOT just skip when to < from: it infers a DESCENDING loop
    // instead and still executes once with i=0, which then hits array.get(obs, 0) on a 0-length
    // array ("Index 0 is out of bounds, array size is 0"). Guarding the loop behind an explicit
    // array.size(obs) > 0 check avoids the descending-loop inference entirely on the empty-array bar.
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            box b = array.get(obs, i)
            if not na(b)
                float top = box.get_top(b)
                float bot = box.get_bottom(b)
                float d = px >= bot and px <= top ? 0.0 : (px < bot ? bot - px : px - top)
                if na(ob_dist) or d < ob_dist
                    ob_dist := d
    array.set(dist, n_types, ob_dist)
    dist

// v24 (09/19/2026): renders one Stop/Target Structure Checklist table — 12 checkbox+label rows (2
// columns x 6 rows) for the CBC main script, called once per side (stop/target) with a different
// `states` array from f_checklist_scan() above. Labels are fixed (the same 12 types every call), so
// they're built once as a local `var` array rather than passed in as a parameter — this function is
// purpose-built for this one feature, not a generic table renderer. Same var-table position-change
// recreate pattern as f_render_confluence_checklist() above; each of this function's 2 call sites in
// the main script gets its own independent `var table` instance (a library function's persistent
// locals are scoped per lexical call site, same as any other Pine function — this is why the two
// tables don't collide with each other despite sharing one function body).
// v27 (09/20/2026): now takes `dist` (the reworked f_checklist_scan()'s single array<float> return,
// see that function's own v27 note above) plus `tol` directly, instead of a separately-scanned bool
// `states` array -- the checkbox state is now derived right here, at render time, as `not na(d) and d
// <= tol`, so the checkmark and the points readout can never disagree (they come from the same `d`).
// Label cell appends the nearest distance in points -- e.g. "Prior Day H/L  2.3pts" -- when a level of
// that type exists on the requested side at all; a type with no such level (`dist` is `na`) shows just
// its plain label, no points suffix, and its checkbox is naturally unchecked too (na(d) short-circuits
// the state check).
// v7.28: new `favorable` param -- true for the Target table call (this pool is already the favorable
// side, per f_checklist_scan()'s want_above=cbc), false for the Stop table call (the opposite side).
// The points suffix is now signed to match: "+N.Npts" on the Target table, "-N.Npts" on the Stop
// table -- same "positive = favorable, negative = against" convention used everywhere else this round
// (Status table VWAP/EMA200 rows, Next Target/Stop Levels). Per direct request ("all the points are
// positive they should be in relation to the direction of cbc").
// Also: unchecked checkbox cells now show "✗" instead of a blank string, same fix/reasoning as
// f_render_confluence_checklist() above ("checkbox to left should show").
export f_render_level_type_checklist(bool use_table, string position, string text_size, color border_col, color frame_col, color bull_col, color neutral_col, color text_col, float[] dist, float tol, bool favorable) =>
    var table lt_tbl = na
    var string lt_pos_last = ""
    var string[] lt_labels = array.from("Prior Day H/L", "Premarket", "NY ORB", "London ORB", "Asia ORB", "NY Session", "Asia Session", "London Session", "Pivot Point", "Swing H/L", "Equal H/L", "Order Block")
    if not use_table
        table.delete(lt_tbl)
        lt_tbl := na
        lt_pos_last := ""
    else
        if not na(lt_tbl) and lt_pos_last != position
            table.delete(lt_tbl)
            lt_tbl := na
        if na(lt_tbl)
            lt_tbl := table.new(f_status_pos(position), 4, 6, bgcolor=color.new(#020617, 0), border_color=border_col, border_width=1, frame_color=frame_col, frame_width=2)
            lt_pos_last := position
        string txt_sz = f_table_text_size(text_size)
        color lbl_bg = color.new(#020617, 0)
        for i = 0 to 11
            int col = (i % 2) * 2
            int row = i / 2
            float d = array.get(dist, i)
            string lbl_txt = array.get(lt_labels, i) + (na(d) ? "" : "  " + (favorable ? "+" : "-") + str.tostring(d, "#.#") + "pts")
            bool st = not na(d) and d <= tol
            table.cell(lt_tbl, col, row, st ? "✓" : "✗", bgcolor=st ? bull_col : neutral_col, text_color=text_col, text_size=txt_sz, text_halign=text.align_center)
            table.cell(lt_tbl, col + 1, row, lbl_txt, bgcolor=lbl_bg, text_color=text_col, text_size=txt_sz, text_halign=text.align_left)
    true

// v25 (09/20/2026): f_render_fib_zone_box() moved to the library — the last of the "next candidate"
// functions flagged back at v21. Its only main-script-only dependency was f_ref_line_style(), which
// takes the main-script-only RefLineStyle enum and returns a plain line.style_* string. Rather than
// exporting the enum type across the library boundary, the main script now precomputes that string
// ONCE (f_ref_line_style(fib_01_line_style)) and passes it in as `fib_01_style` — the enum itself
// never has to cross the import boundary, and the two line.new() calls that used to call
// f_ref_line_style() directly now just reuse the passed-in string. Otherwise a straight body-move,
// same pattern as f_render_confluence_cells()/f_render_confluence_checklist() above: all `var`
// box/line/label state stays inside the function so it's still per-call-site (this function only has
// one call site, so that doesn't matter here, but keeping the pattern consistent).
export f_render_fib_zone_box(bool fib_valid, bool show_fib_zone_box, int fib_zone_box_bars, float fib_zone_top, float fib_zone_bot, bool fib_price_in_zone, string htf_tf_disp_val, float fib_50, float fib_618, color st_bull, color st_neutral, color txt_on, string status_table_text_size, bool show_fib_01_lines, float fib_0, float fib_100, color col_fib_01_lines, string fib_01_style, color txt_fib_01_lines, bool fib_side, bool fib_lines) =>
    var box fib_zone_bx = na
    var box fib_side_bx = na
    var line fib_50_ln = na
    var line fib_618_ln = na
    var label fib_ln_lbl = na
    box.delete(fib_side_bx)
    fib_side_bx := na
    line.delete(fib_50_ln)
    fib_50_ln := na
    line.delete(fib_618_ln)
    fib_618_ln := na
    label.delete(fib_ln_lbl)
    fib_ln_lbl := na
    if fib_valid and (fib_side or fib_lines)
        color fc = fib_price_in_zone ? st_bull : st_neutral
        string ft = "Fib " + htf_tf_disp_val + "  " + str.tostring(fib_50, "#.#") + " / " + str.tostring(fib_618, "#.#") + (fib_price_in_zone ? "  IN" : "")
        if fib_side
            fib_side_bx := box.new(left=bar_index + 2, top=fib_zone_top, right=bar_index + 16, bottom=fib_zone_bot, border_color=fc, border_width=1, bgcolor=color.new(fc, 75), text=ft, text_color=txt_on, text_size=f_table_text_size(status_table_text_size), text_halign=text.align_left, text_valign=text.align_center)
        if fib_lines
            int lx = math.max(0, bar_index - fib_zone_box_bars)
            fib_50_ln := line.new(lx, fib_50, bar_index, fib_50, color=fc, width=1, style=line.style_dotted)
            fib_618_ln := line.new(lx, fib_618, bar_index, fib_618, color=fc, width=1, style=line.style_dotted)
            if not fib_side
                fib_ln_lbl := label.new(bar_index, fib_50, ft, color=color.new(color.white, 100), textcolor=fc, style=label.style_label_left, size=size.small)
    var line fib_0_ln = na
    var line fib_100_ln = na
    var label fib_0_lbl = na
    var label fib_100_lbl = na
    if not fib_valid
        box.delete(fib_zone_bx)
        fib_zone_bx := na
        line.delete(fib_0_ln)
        fib_0_ln := na
        line.delete(fib_100_ln)
        fib_100_ln := na
        label.delete(fib_0_lbl)
        fib_0_lbl := na
        label.delete(fib_100_lbl)
        fib_100_lbl := na
    else
        int fib_box_left = math.max(0, bar_index - fib_zone_box_bars)
        if not show_fib_zone_box
            box.delete(fib_zone_bx)
            fib_zone_bx := na
        else
            string fib_box_txt_sz = f_table_text_size(status_table_text_size)
            color fib_box_bg = fib_price_in_zone ? color.new(st_bull, 85) : color.new(st_neutral, 85) // rev34: was 55 (too opaque)
            color fib_box_bd = fib_price_in_zone ? st_bull : st_neutral
            string fib_box_txt = "Fib " + htf_tf_disp_val + "  " + str.tostring(fib_50, "#.#") + " / " + str.tostring(fib_618, "#.#") + (fib_price_in_zone ? "  IN" : "")
            if na(fib_zone_bx)
                fib_zone_bx := box.new(left=fib_box_left, top=fib_zone_top, right=bar_index, bottom=fib_zone_bot, border_color=fib_box_bd, border_width=2, bgcolor=fib_box_bg, extend=extend.none, text=fib_box_txt, text_color=txt_on, text_size=fib_box_txt_sz, text_halign=text.align_center, text_valign=text.align_center)
            else
                box.set_left(fib_zone_bx, fib_box_left)
                box.set_right(fib_zone_bx, bar_index)
                box.set_top(fib_zone_bx, fib_zone_top)
                box.set_bottom(fib_zone_bx, fib_zone_bot)
                box.set_bgcolor(fib_zone_bx, fib_box_bg)
                box.set_border_color(fib_zone_bx, fib_box_bd)
                box.set_text(fib_zone_bx, fib_box_txt)
                box.set_text_color(fib_zone_bx, txt_on)
                box.set_text_size(fib_zone_bx, fib_box_txt_sz)
        if not show_fib_01_lines
            line.delete(fib_0_ln)
            fib_0_ln := na
            line.delete(fib_100_ln)
            fib_100_ln := na
            label.delete(fib_0_lbl)
            fib_0_lbl := na
            label.delete(fib_100_lbl)
            fib_100_lbl := na
        else
            if na(fib_0_ln)
                fib_0_ln := line.new(fib_box_left, fib_0, bar_index, fib_0, color=col_fib_01_lines, width=1, style=fib_01_style, extend=extend.none)
                fib_0_lbl := label.new(bar_index, fib_0, "FIB 0", color=color.new(color.white, 100), textcolor=txt_fib_01_lines, style=label.style_label_left, size=size.normal)
            else
                line.set_xy1(fib_0_ln, fib_box_left, fib_0)
                line.set_xy2(fib_0_ln, bar_index, fib_0)
                label.set_xy(fib_0_lbl, bar_index, fib_0)
            if na(fib_100_ln)
                fib_100_ln := line.new(fib_box_left, fib_100, bar_index, fib_100, color=col_fib_01_lines, width=1, style=fib_01_style, extend=extend.none)
                fib_100_lbl := label.new(bar_index, fib_100, "FIB 1", color=color.new(color.white, 100), textcolor=txt_fib_01_lines, style=label.style_label_left, size=size.normal)
            else
                line.set_xy1(fib_100_ln, fib_box_left, fib_100)
                line.set_xy2(fib_100_ln, bar_index, fib_100)
                label.set_xy(fib_100_lbl, bar_index, fib_100)
    true

// v7.35 (main script): f_render_pivot_table()'s entire body moved here from the main script for
// CE10117 relief -- it was the largest remaining un-offloaded render function (every other major
// table-render function in this file -- confluence cells, confluence checklist, structure
// checklists, fib zone box -- was already moved in earlier rounds; this one grew significantly at
// v7.33/v7.34, first with the closest-8/PRICE-row/direction-ordering rework then with the 4-
// above/4-below selection split and the new signed-distance middle row). Same proven-safe "pass
// state in as parameters, no CBC-internal state read" category as every prior render-function
// offload -- the persistent `var table piv_tbl` moves into this function along with the body,
// same as f_render_confluence_cells/f_render_fib_zone_box before it. `px`/`htf_bull`/`ltf_bull`
// are the plain values the main script's `close`/`cf_f2_htf_bull`/`cbc` resolve to at the call
// site -- see convention #20 in the project handoff doc for why direction needs BOTH htf_bull
// (column ordering) and ltf_bull (the new row's signed distance) rather than just one.
// v7.37: pool expanded from 9 to 17 slots per direct request ("as orb H ln orb h as orb l ny orb
// l pp pml etc"), made against a screenshot circling the chart's own Reference Levels column
// (PMH/PML, the 3 session Opening Range highs/lows, PP, YDL, etc.). Clarified via AskUserQuestion:
// add these as MORE always-shown candidates (table can grow past 9 columns), not a distance-based
// closest-N pick. New slots 9-16: PMH/PML (premarket high/low) and the 3 sessions' Opening Range
// H/L (NY/London/Asia) -- same values already tracked elsewhere in this file (Reference Levels,
// f_next_two_levels()'s pool), no new computation. Each new slot gets its own dedicated
// table-scoped enable toggle (show_pivot_pmh/pml/ny_orh/ny_orl/ln_orh/ln_orl/as_orh/as_orl),
// deliberately separate from the shared line-visibility toggles (show_pmh/show_ln_orb_hl/etc) --
// same "keep this table's own local pool independently toggleable" reasoning already used for
// YD-H/YD-L at v7.32. PP is no longer guaranteed to be the table's exact middle column once the
// pool grows past the original fixed 3-above/3-below classic-pivot shape (a session ORB level can
// sort anywhere relative to PP) -- this is the accepted, explicitly chosen tradeoff from the
// AskUserQuestion answer ("add them, keep showing everything enabled").
// v7.39: pool expanded from 17 to 21 slots per direct request ("include bsrg if within 4 bars htf
// and htf pivots as seen in image"), made against a screenshot of the BRSG Zone (High/Low
// multiplier) and HTF swing-pivot line settings. New slots 17-20: BRSG-H/BRSG-L (the BRSG zone's
// own high/low price edges, brsg_zone_top/brsg_zone_bot -- same values the on-chart BRSG zone
// shading already uses) and HTF Piv-H/HTF Piv-L (the HTF swing pivot high/low, h_last_hi/h_last_lo
// -- same values the Status table's "Pivot (HTF)" row and f_next_two_levels()'s pool already use).
// BRSG-H/BRSG-L are gated by a single combined enable flag (brsg_show) rather than two separate
// toggles -- the pair is one zone, not two independently meaningful levels, and reads as such on
// the chart's own BRSG Zone setting. Per the literal request ("if within 4 bars htf"), that flag
// is computed in the main script as the existing table-scoped master toggle AND
// htf_bars_since_flip <= 4 -- the exact same recency window this file already uses for the HTF
// Flip confluence factor (v7.31, confluence_use_htf_flip/cf_f9_htf_flip_touch), reused here rather
// than inventing a new threshold. HTF Piv-H/HTF Piv-L get their own separate toggles
// (show_pivot_htf_piv_hi/lo) with no recency condition, matching how every other pool addition in
// this table works (R1-R3/S1-S3/PP/YD-H/YD-L/PMH/PML/session-ORB) -- the request named them
// alongside BRSG but didn't ask for the same 4-bar gating, so they're always-on-when-toggled like
// everything else in the pool.
// v7.40: pool expanded from 21 to 23 slots per direct request ("can the pine script idenify equal
// highs and lows from htf to include i table of pivots"). New slots 21-22: HTF EQH/HTF EQL -- the
// most recent HTF Equal High/Low match price (htf_eqh/htf_eql, computed in the main script from the
// same HTF pivot stream htf_piv_hi/htf_piv_lo above already come from, using the ATR-scaled
// tolerance mechanism the LTF Equal Highs/Lows feature already uses, per the AskUserQuestion answer
// choosing "Same ATR-scaled tolerance as the existing EQH/EQL feature"). Each gets its own dedicated
// toggle (show_pivot_htf_eqh/show_pivot_htf_eql), matching how every other pool addition in this
// table works -- no shared/combined flag, since unlike BRSG-H/BRSG-L these are two independently
// meaningful levels, not one zone's two edges.
// v7.41: pool expanded from 23 to 27 slots per direct follow-up ("show all pivots in table... also
// include LTF pivots and ema200 and vwap"), scoped via AskUserQuestion. New slots 23-26: LTF Piv-H/
// LTF Piv-L (ltf_piv_hi/ltf_piv_lo -- the same LTF swing pivot values the Structure HH/HL/LH/LL
// classifier and the Status table's "Pivot (LTF)" row already use), EMA 200 (ema200_val), and VWAP
// (vwap_val) -- no new computation, same reuse pattern as every prior pool addition. Each gets its
// own dedicated toggle, default true. Also: R2/R3/S2/S3 (pool indices 1/0/5/6) now additionally OR
// in 4 new table-only toggles (show_tbl_r2/r3/s2/s3, default true) alongside their existing
// chart-line toggle and the v7.38 price-based auto-escalation -- any of the three now being true
// shows that level in the table, so "show all pivots" no longer depends on price having moved past
// R1/S1/R2/S2 first. Also: PRICE's own label is now "Price-L"/"Price-S" (was the fixed "PRICE")
// depending on the live LTF CBC direction (ltf_bull), and its own price-row cell (the bottom of the
// 3 rows) now colors st_bull/st_bear by that same direction instead of the shared gold highlight --
// the label/diff rows for that column keep the gold highlight unchanged, only the price-value cell
// changed, per the direct request ("color the price in row 3 under price green if long and red if
// short").
// v7.42: no signature change -- pure render-logic tweak inside the function body (PRICE column's
// row 1 text now "Long"/"Short" instead of "+0.00", both row 1 and row 2 use their own distinct
// vivid green/red instead of the shared st_bull/st_bear). See the render loop's own comment below.
export f_render_pivot_table(bool show_pivot_table, float[] piv_price_arr, string[] piv_labels, bool[] piv_enabled, float ydh, float ydl, bool show_pivot_ydh, bool show_pivot_ydl, float pmh, float pml, bool show_pivot_pmh, bool show_pivot_pml, float ny_orh, float ny_orl, bool show_pivot_ny_orh, bool show_pivot_ny_orl, float ln_orh, float ln_orl, bool show_pivot_ln_orh, bool show_pivot_ln_orl, float as_orh, float as_orl, bool show_pivot_as_orh, bool show_pivot_as_orl, float brsg_top, float brsg_bot, bool brsg_show, float htf_piv_hi, float htf_piv_lo, bool show_pivot_htf_piv_hi, bool show_pivot_htf_piv_lo, float htf_eqh, float htf_eql, bool show_pivot_htf_eqh, bool show_pivot_htf_eql, bool show_tbl_r2, bool show_tbl_r3, bool show_tbl_s2, bool show_tbl_s3, float ltf_piv_hi, float ltf_piv_lo, bool show_pivot_ltf_piv_hi, bool show_pivot_ltf_piv_lo, float ema200_val, float vwap_val, bool show_pivot_ema200, bool show_pivot_vwap, float px, bool htf_bull, int htf_last_flip_t_open, int htf_last_flip_t_close, color col_piv_pp, color col_piv_r, color col_piv_s, color st_highlight, color st_bull, color st_bear, string position, color border_col, color frame_col, string text_size, color txt_on, int max_each_side) =>
    var table piv_tbl = na
    if show_pivot_table
        var float[] pivT_price_arr = array.new_float(27, na)
        var string[] pivT_labels = array.new_string(27, "")
        var bool[] pivT_enabled = array.new_bool(27, false)
        var color[] pivT_lblcol = array.new<color>(27, na)
        for pj = 0 to 6
            array.set(pivT_price_arr, pj, array.get(piv_price_arr, pj))
            array.set(pivT_labels, pj, array.get(piv_labels, pj))
            array.set(pivT_enabled, pj, array.get(piv_enabled, pj))
            array.set(pivT_lblcol, pj, pj == 3 ? col_piv_pp : pj < 3 ? col_piv_r : col_piv_s)
        float piv_r1_val = array.get(piv_price_arr, 2)
        float piv_r2_val = array.get(piv_price_arr, 1)
        float piv_s1_val = array.get(piv_price_arr, 4)
        float piv_s2_val = array.get(piv_price_arr, 5)
        bool r2_auto = not na(piv_r1_val) and px > piv_r1_val
        bool r3_auto = not na(piv_r2_val) and px > piv_r2_val
        bool s2_auto = not na(piv_s1_val) and px < piv_s1_val
        bool s3_auto = not na(piv_s2_val) and px < piv_s2_val
        array.set(pivT_enabled, 1, array.get(pivT_enabled, 1) or r2_auto or show_tbl_r2)
        array.set(pivT_enabled, 0, array.get(pivT_enabled, 0) or r3_auto or show_tbl_r3)
        array.set(pivT_enabled, 5, array.get(pivT_enabled, 5) or s2_auto or show_tbl_s2)
        array.set(pivT_enabled, 6, array.get(pivT_enabled, 6) or s3_auto or show_tbl_s3)
        array.set(pivT_price_arr, 7, ydh)
        array.set(pivT_labels, 7, "YD-H")
        array.set(pivT_enabled, 7, show_pivot_ydh)
        array.set(pivT_lblcol, 7, col_piv_r)
        array.set(pivT_price_arr, 8, ydl)
        array.set(pivT_labels, 8, "YD-L")
        array.set(pivT_enabled, 8, show_pivot_ydl)
        array.set(pivT_lblcol, 8, col_piv_s)
        array.set(pivT_price_arr, 9, pmh)
        array.set(pivT_labels, 9, "PMH")
        array.set(pivT_enabled, 9, show_pivot_pmh)
        array.set(pivT_lblcol, 9, col_piv_r)
        array.set(pivT_price_arr, 10, pml)
        array.set(pivT_labels, 10, "PML")
        array.set(pivT_enabled, 10, show_pivot_pml)
        array.set(pivT_lblcol, 10, col_piv_s)
        array.set(pivT_price_arr, 11, ny_orh)
        array.set(pivT_labels, 11, "NY OR-H")
        array.set(pivT_enabled, 11, show_pivot_ny_orh)
        array.set(pivT_lblcol, 11, col_piv_r)
        array.set(pivT_price_arr, 12, ny_orl)
        array.set(pivT_labels, 12, "NY OR-L")
        array.set(pivT_enabled, 12, show_pivot_ny_orl)
        array.set(pivT_lblcol, 12, col_piv_s)
        array.set(pivT_price_arr, 13, ln_orh)
        array.set(pivT_labels, 13, "LN OR-H")
        array.set(pivT_enabled, 13, show_pivot_ln_orh)
        array.set(pivT_lblcol, 13, col_piv_r)
        array.set(pivT_price_arr, 14, ln_orl)
        array.set(pivT_labels, 14, "LN OR-L")
        array.set(pivT_enabled, 14, show_pivot_ln_orl)
        array.set(pivT_lblcol, 14, col_piv_s)
        array.set(pivT_price_arr, 15, as_orh)
        array.set(pivT_labels, 15, "AS OR-H")
        array.set(pivT_enabled, 15, show_pivot_as_orh)
        array.set(pivT_lblcol, 15, col_piv_r)
        array.set(pivT_price_arr, 16, as_orl)
        array.set(pivT_labels, 16, "AS OR-L")
        array.set(pivT_enabled, 16, show_pivot_as_orl)
        array.set(pivT_lblcol, 16, col_piv_s)
        array.set(pivT_price_arr, 17, brsg_top)
        array.set(pivT_labels, 17, "BRSG-H")
        array.set(pivT_enabled, 17, brsg_show)
        array.set(pivT_lblcol, 17, col_piv_r)
        array.set(pivT_price_arr, 18, brsg_bot)
        array.set(pivT_labels, 18, "BRSG-L")
        array.set(pivT_enabled, 18, brsg_show)
        array.set(pivT_lblcol, 18, col_piv_s)
        array.set(pivT_price_arr, 19, htf_piv_hi)
        array.set(pivT_labels, 19, "HTF Piv-H")
        array.set(pivT_enabled, 19, show_pivot_htf_piv_hi)
        array.set(pivT_lblcol, 19, col_piv_r)
        array.set(pivT_price_arr, 20, htf_piv_lo)
        array.set(pivT_labels, 20, "HTF Piv-L")
        array.set(pivT_enabled, 20, show_pivot_htf_piv_lo)
        array.set(pivT_lblcol, 20, col_piv_s)
        array.set(pivT_price_arr, 21, htf_eqh)
        array.set(pivT_labels, 21, "HTF EQH")
        array.set(pivT_enabled, 21, show_pivot_htf_eqh)
        array.set(pivT_lblcol, 21, col_piv_r)
        array.set(pivT_price_arr, 22, htf_eql)
        array.set(pivT_labels, 22, "HTF EQL")
        array.set(pivT_enabled, 22, show_pivot_htf_eql)
        array.set(pivT_lblcol, 22, col_piv_s)
        array.set(pivT_price_arr, 23, ltf_piv_hi)
        array.set(pivT_labels, 23, "LTF Piv-H")
        array.set(pivT_enabled, 23, show_pivot_ltf_piv_hi)
        array.set(pivT_lblcol, 23, col_piv_r)
        array.set(pivT_price_arr, 24, ltf_piv_lo)
        array.set(pivT_labels, 24, "LTF Piv-L")
        array.set(pivT_enabled, 24, show_pivot_ltf_piv_lo)
        array.set(pivT_lblcol, 24, col_piv_s)
        array.set(pivT_price_arr, 25, ema200_val)
        array.set(pivT_labels, 25, "EMA200")
        array.set(pivT_enabled, 25, show_pivot_ema200)
        array.set(pivT_lblcol, 25, px > ema200_val ? col_piv_r : col_piv_s)
        array.set(pivT_price_arr, 26, vwap_val)
        array.set(pivT_labels, 26, "VWAP")
        array.set(pivT_enabled, 26, show_pivot_vwap)
        array.set(pivT_lblcol, 26, px > vwap_val ? col_piv_r : col_piv_s)

        var bool[] piv_show_final = array.new_bool(27, false)
        for si = 0 to 26
            array.set(piv_show_final, si, array.get(pivT_enabled, si) and not na(array.get(pivT_price_arr, si)))

        var float[] piv_final_price = array.new_float(28, na)
        var string[] piv_final_label = array.new_string(28, "")
        var color[] piv_final_lblcol = array.new<color>(28, na)
        int piv_final_n = 0
        for pi = 0 to 26
            if array.get(piv_show_final, pi)
                array.set(piv_final_price, piv_final_n, array.get(pivT_price_arr, pi))
                array.set(piv_final_label, piv_final_n, array.get(pivT_labels, pi))
                array.set(piv_final_lblcol, piv_final_n, array.get(pivT_lblcol, pi))
                piv_final_n := piv_final_n + 1
        string price_lbl_txt = htf_bull ? "Price-L" : "Price-S"
        array.set(piv_final_price, piv_final_n, px)
        array.set(piv_final_label, piv_final_n, price_lbl_txt)
        array.set(piv_final_lblcol, piv_final_n, st_highlight)
        piv_final_n := piv_final_n + 1

        float[] piv_sorted_price = array.slice(piv_final_price, 0, piv_final_n)
        array<int> piv_sort_order = array.sort_indices(piv_sorted_price, order.ascending)
        if not htf_bull
            array.reverse(piv_sort_order)

        if na(piv_tbl)
            piv_tbl := table.new(f_status_pos(position), 28, 3, bgcolor=color.new(#020617, 0), border_color=border_col, border_width=3, frame_color=frame_col, frame_width=2)
        string piv_txt_sz = text_size == "Tiny" ? size.tiny : text_size == "Small" ? size.small : text_size == "Normal" ? size.normal : text_size == "Large" ? size.large : size.huge
        int p_price_pos = 0
        for pk = 0 to piv_final_n - 1
            string pk_lbl = array.get(piv_final_label, array.get(piv_sort_order, pk))
            if pk_lbl == "Price-L" or pk_lbl == "Price-S"
                p_price_pos := pk
        int p_from = max_each_side > 0 ? math.max(0, p_price_pos - max_each_side) : 0
        int p_to = max_each_side > 0 ? math.min(piv_final_n - 1, p_price_pos + max_each_side) : piv_final_n - 1
        table.clear(piv_tbl, 0, 0, 27, 2)
        for pq = p_from to p_to
            int pc = pq - p_from
            int p_idx = array.get(piv_sort_order, pq)
            float p_val = array.get(piv_sorted_price, p_idx)
            string p_lbl = array.get(piv_final_label, p_idx)
            bool p_is_price = p_lbl == "Price-L" or p_lbl == "Price-S"
            float p_diff = htf_bull ? (p_val - px) : (px - p_val)
            color p_row_bg = p_is_price ? st_highlight : px > p_val ? st_bull : st_bear
            color p_price_col_bg = htf_bull ? color.new(#22C55E, 0) : color.new(#EF4444, 0)
            color p_price_row1_bg = p_is_price ? p_price_col_bg : p_row_bg
            color p_price_row2_bg = p_is_price ? p_price_col_bg : p_row_bg
            string p_row1_txt = p_is_price ? (htf_bull ? "L " : "S ") + f_fmt_ny_time_range(htf_last_flip_t_open, htf_last_flip_t_close) : (p_diff >= 0 ? "+" : "") + str.tostring(p_diff, "#.##")
            table.cell(piv_tbl, pc, 0, p_lbl, bgcolor=array.get(piv_final_lblcol, p_idx), text_color=txt_on, text_size=piv_txt_sz, text_halign=text.align_center)
            table.cell(piv_tbl, pc, 1, p_row1_txt, bgcolor=p_price_row1_bg, text_color=txt_on, text_size=piv_txt_sz, text_halign=text.align_center)
            table.cell(piv_tbl, pc, 2, str.tostring(p_val, "#.##"), bgcolor=p_price_row2_bg, text_color=txt_on, text_size=piv_txt_sz, text_halign=text.align_center)
    true

// v41: Auto Trade Setup helpers, moved here from the main script's v7.44 feature at v7.45 purely to
// relieve main-script CE10117 token pressure (reported 103065/100256) -- same "pure-parameter, no-CBC-
// state helper moved to the library" technique already used throughout this file. f_ats_build_candidates
// builds the stop/target candidate pool from the same live pivot values/toggles the Pivot Points table
// itself draws from (BRSG is never one of the parameters, so it can never end up in the returned pool).
// v53: added NY/London/Asia Opening Range High/Low as candidates, per user request -- OR-H/OR-L had
// been absent from this pool since the function was first written (BRSG stays excluded by design).
// f_ats_nearest_above/f_ats_nearest_below scan that pool for the closest qualifying price on either
// side of a given price. All three are pure array/scalar-in, single-value-out (no tuples, per this
// project's standing CE10172 lesson) and carry no CBC state of their own.
export f_ats_build_candidates(float[] piv_price, bool[] piv_enabled, float ydh, bool sh_ydh, float ydl, bool sh_ydl, float pmh, bool sh_pmh, float pml, bool sh_pml, float htf_hi, bool sh_htf_hi, float htf_lo, bool sh_htf_lo, float htf_eqh, bool sh_htf_eqh, float htf_eql, bool sh_htf_eql, float ltf_hi, bool sh_ltf_hi, float ltf_lo, bool sh_ltf_lo, float ema200_val, bool sh_ema200, float vwap_val, bool sh_vwap, float ny_orh, bool sh_ny_orh, float ny_orl, bool sh_ny_orl, float ln_orh, bool sh_ln_orh, float ln_orl, bool sh_ln_orl, float as_orh, bool sh_as_orh, float as_orl, bool sh_as_orl, bool tbl_r3, bool tbl_r2, bool tbl_s2, bool tbl_s3, string[] names_out) =>
    float[] out = array.new_float(0)
    array.clear(names_out)
    string[] piv_nm = array.from("R3", "R2", "R1", "PP", "S1", "S2", "S3")
    for pk = 0 to array.size(piv_enabled) - 1
        if array.get(piv_enabled, pk) or (pk == 0 and tbl_r3) or (pk == 1 and tbl_r2) or (pk == 5 and tbl_s2) or (pk == 6 and tbl_s3)
            array.push(out, array.get(piv_price, pk))
            array.push(names_out, pk < array.size(piv_nm) ? array.get(piv_nm, pk) : "Pivot")
    if sh_ydh and not na(ydh)
        array.push(out, ydh)
        array.push(names_out, "YD-H")
    if sh_ydl and not na(ydl)
        array.push(out, ydl)
        array.push(names_out, "YD-L")
    if sh_pmh and not na(pmh)
        array.push(out, pmh)
        array.push(names_out, "PMH")
    if sh_pml and not na(pml)
        array.push(out, pml)
        array.push(names_out, "PML")
    if sh_htf_hi and not na(htf_hi)
        array.push(out, htf_hi)
        array.push(names_out, "HTF Piv-H")
    if sh_htf_lo and not na(htf_lo)
        array.push(out, htf_lo)
        array.push(names_out, "HTF Piv-L")
    if sh_htf_eqh and not na(htf_eqh)
        array.push(out, htf_eqh)
        array.push(names_out, "HTF EQH")
    if sh_htf_eql and not na(htf_eql)
        array.push(out, htf_eql)
        array.push(names_out, "HTF EQL")
    if sh_ltf_hi and not na(ltf_hi)
        array.push(out, ltf_hi)
        array.push(names_out, "LTF Piv-H")
    if sh_ltf_lo and not na(ltf_lo)
        array.push(out, ltf_lo)
        array.push(names_out, "LTF Piv-L")
    if sh_ema200 and not na(ema200_val)
        array.push(out, ema200_val)
        array.push(names_out, "EMA200")
    if sh_vwap and not na(vwap_val)
        array.push(out, vwap_val)
        array.push(names_out, "VWAP")
    if sh_ny_orh and not na(ny_orh)
        array.push(out, ny_orh)
        array.push(names_out, "NY OR-H")
    if sh_ny_orl and not na(ny_orl)
        array.push(out, ny_orl)
        array.push(names_out, "NY OR-L")
    if sh_ln_orh and not na(ln_orh)
        array.push(out, ln_orh)
        array.push(names_out, "LN OR-H")
    if sh_ln_orl and not na(ln_orl)
        array.push(out, ln_orl)
        array.push(names_out, "LN OR-L")
    if sh_as_orh and not na(as_orh)
        array.push(out, as_orh)
        array.push(names_out, "AS OR-H")
    if sh_as_orl and not na(as_orl)
        array.push(out, as_orl)
        array.push(names_out, "AS OR-L")
    out

export f_ats_nearest_above(float px, float[] arr) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float v = array.get(arr, i)
            if not na(v) and v > px and (na(best) or v < best)
                best := v
    best

export f_ats_nearest_below(float px, float[] arr) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float v = array.get(arr, i)
            if not na(v) and v < px and (na(best) or v > best)
                best := v
    best

export f_ats_handle_sane(float handle, float current) =>
    not na(current) and current > 0 and handle > current * 0.2 and handle < current * 5.0

export f_ats_handle_is_step(float handle) =>
    handle != 0.0 and handle == math.round(handle) and math.abs(handle) <= 20

export f_ats_handle_step(float base_ref, float current, float[] cand, bool want_above, int n) =>
    float result = current
    if n != 0 and not na(current) and array.size(cand) > 0
        float[] seq = array.new_float(0)
        bool skipped_self = false
        for i = 0 to array.size(cand) - 1
            float v = array.get(cand, i)
            if not na(v)
                if v == current and not skipped_self
                    skipped_self := true
                else
                    bool farther = want_above ? v >= current : v <= current
                    bool closer = want_above ? (v <= current and (na(base_ref) or v > base_ref)) : (v >= current and (na(base_ref) or v < base_ref))
                    if (n > 0 and farther) or (n < 0 and closer)
                        array.push(seq, v)
        if array.size(seq) > 0
            array.sort(seq, (n > 0) == want_above ? order.ascending : order.descending)
            result := array.get(seq, math.min(math.abs(n), array.size(seq)) - 1)
    result

export f_ats_handle_snap(float handle, float current, float tol, bool want_above, float[] cand, float base_ref) =>
    float result = current
    if handle != 0.0 and not na(current)
        if f_ats_handle_is_step(handle)
            result := f_ats_handle_step(base_ref, current, cand, want_above, int(handle))
        else if f_ats_handle_sane(handle, current) and math.abs(handle - current) > tol
            float snap = want_above ? f_ats_nearest_above(handle, cand) : f_ats_nearest_below(handle, cand)
            if not na(snap)
                result := snap
    result

f_ats_live_snap(float handle, float current, float tol, bool want_above, float[] cand, float base_ref) =>
    f_ats_handle_is_step(handle) ? current : f_ats_handle_snap(handle, current, tol, want_above, cand, base_ref)

export f_ats_level_name(float v, float[] cand, string[] names) =>
    string result = ""
    if not na(v) and array.size(cand) > 0 and array.size(names) == array.size(cand)
        for i = 0 to array.size(cand) - 1
            if array.get(cand, i) == v
                string nm = array.get(names, i)
                if not str.contains(result, nm)
                    result := result + (result != "" ? "/" : "") + nm
    result

export f_ats_level_name_top(float v, float[] cand, string[] names) =>
    string[] prio = array.from("S1", "S2", "S3", "PP", "R1", "R2", "R3", "HTF EQH", "HTF EQL", "YD-H", "YD-L")
    string best = ""
    int best_rank = 999
    if not na(v) and array.size(cand) > 0 and array.size(names) == array.size(cand)
        for i = 0 to array.size(cand) - 1
            if array.get(cand, i) == v
                string nm = array.get(names, i)
                int rk = array.indexof(prio, nm)
                int rank = rk >= 0 ? rk : 100 + i
                if rank < best_rank
                    best_rank := rank
                    best := nm
    best


// v42: Auto Trade Setup drawing, moved here from the main script at v7.46 for a further CE10117
// reduction (reported 102238/100256 after v7.45's first offload). Same persistent-`var`-inside-an-
// exported-function pattern already proven safe in this file (see f_render_fib_zone_box's
// `var box fib_zone_bx`/etc. above, and f_render_pivot_table's `var table piv_tbl`) — the box/line/
// label refs live INSIDE this function's own persistent state instead of being passed in and back out,
// which sidesteps the "exported functions can't return a tuple" restriction (convention #19) entirely:
// this function only ever needs to return one value, never the 6 drawing-object refs the old inline
// version had to juggle in the main script. Delete-and-recreate-on-every-call lifecycle (one active
// setup at a time) is identical to the old inline version, just relocated.
// v47: restyled per direct request to look closer to TradingView's native "Long/Short position"
// Forecasting drawing tool (a split green/red box with the entry line through the middle, stop at one
// edge, target at the other — screenshot referenced the tool directly). Pine has no API to create that
// native drawing-tool object type itself (confirmed — it's a manual chart tool with no scripting
// access), so this is the closest achievable approximation using box.new()/line.new(): unchanged
// reward_box (green, Entry→Target) + risk_box (red, Entry→Stop) already form the same split-box look
// with entry price running through the middle, target at the far edge, stop at the other. Per direct
// answer ("Closest box/line approximation"), the only change is dropping the old text-info label
// (rr_label, "LONG setup / Entry.. / Stop.. / Target.. / R:R..") entirely so the setup reads as a clean
// drawn shape instead of "a red box with info in it".
// v48: TradingView flagged the now-unused `txt_size` parameter left in the v47 signature (CE10237
// "Unused argument 'txt_size'... Ensure that it utilizes all arguments"). Removed the parameter
// entirely rather than leaving it in place — this function's signature is now 6 params, down from 7.
// The main script's call site and its `trade_setup_txt_size` input (which had nothing left to feed
// once the label was removed at v47) were both removed in the same round; see the v7.57 changelog
// block in the main script.
// v49: same CE10237 warning, now on `is_long` — v47's label removal also left THIS parameter with
// nothing left to consume it (it used to pick "LONG"/"SHORT" text and the label's color; both gone
// since v47). Missed in the v48 pass because only `txt_size` had been reported at that point. Removed
// `is_long` too — signature is now 5 params, down from 6. The main script's `ats_long` local variable
// is still used elsewhere in that call's `if` block (for the stop/target nearest-pivot direction), so
// it stays — only the now-unnecessary 6th argument to this specific call was dropped. Audited every
// remaining parameter (`entry`/`stop`/`target`/`reward_col`/`risk_col`) against the function body below
// this time — all 5 are read by at least one `box.new()`/`line.new()` call, none are dead.
// v59: TP1/SL1/TP2/SL2 line labels, per direct request ("I would like this option when it draws a new
// setup box but not when you load the indicator mark tp1 and tp2 and sl1 and sl2 on the lines"). Four
// new persistent labels (target_lbl/stop_lbl/target2_lbl/stop2_lbl), delete-and-recreate on the SAME
// call as the box/lines they tag -- this function only ever runs when a genuinely new setup is drawn
// (the main script's cooldown-gated trigger `if` block is the only caller), so a label can never appear
// on its own without a fresh box/line draw alongside it; there is no separate "on load" code path to
// guard against. No parameters added -- entry/stop/target/stop2/target2 were already available. This is
// a deliberately minimal per-line tag ("TP1"/"SL1"/"TP2"/"SL2" only), NOT a return of the old v7.56-
// removed `rr_label` (which packed Entry/Stop/Target/R:R text into one combined label) -- different,
// smaller design, per this round's explicit request.
// v60: `new_setup` gate + per-bar TP2/SL2 breach freeze, per direct request ("stop trade setup
// extending to the right when the price breaks tp2 or sl2"). This function now has to run EVERY bar
// (not just on a trigger bar) so it can check the ACTIVE setup's TP2/SL2 against the current bar's
// high/low even on bars where nothing new is firing -- `new_setup` tells it whether THIS call is a
// fresh trigger (draw everything from scratch, same as before) or a routine per-bar check (just look
// for a breach of the ALREADY-drawn setup's TP2/SL2 and, if found, freeze every object's right edge in
// place). The entry/stop/target/stop2/target2 of the currently active setup are now latched into their
// own persistent `var float`s so the freeze check on a non-trigger bar doesn't need them re-passed in
// (the main script passes na for all 5 level params on a non-trigger call). Breach direction is derived
// generically from each level's position relative to entry (no explicit long/short flag needed): a
// target-side level (above entry) breaches on `high >= level`, a stop-side level (below entry) breaches
// on `low <= level`. TP1/SL1 themselves are untouched by this -- only TP2/SL2 gate the freeze, per the
// literal request; if TP2/SL2 aren't shown for a given setup, that setup keeps extending indefinitely,
// same as before this round (no fallback to TP1/SL1 breach was asked for).
// v7.89: TWO changes, per direct follow-up after the v7.86 handle-sanity fix went live and the user
// confirmed the cyan handle label finally rendered: (1) "i moved it but it did not snap" -- until now,
// a drag handle only ever fed into the NEXT new trigger's initial TP1/SL1/TP2/SL2 computation
// (f_ats_compute_trigger); it had zero effect on a setup that was already drawn and sitting on the
// chart. Per direct confirmation ("Live-update the active setup"), this function now re-applies
// f_ats_handle_snap() every bar (not just at new_setup) against whichever handle is active, and if the
// result differs from what's currently drawn, moves that level's line/label and reshapes the matching
// zone box to match -- satisfying both "make it snap" and the separate ask for the reward zone to
// visually shade/stretch as TP1 moves. (2) each level's on-chart label now shows its live numeric price
// in the text itself (e.g. "TP1 7810.25"), not just the level name -- since Pine has no way for a
// script to write a value back into an input.price() field (asked about directly this round and
// confirmed impossible), reading the exact live price straight off these labels is the closest
// available substitute for "feed the computed values into the handle inputs."
// v66: compile fix (CE10173), per direct report -- `var bool active_long = na` fails because a bare
// `na` literal can't be assigned directly to a variable with an explicit `bool` type; Pine needs an
// explicit cast. Fixed to `var bool active_long = bool(na)`. No other change.
// v68: confirmed-HTF-flip-against-active-setup handling, per direct request ("WHY SHORT ENTY SETUP
// SINCE CBC FLIIPPED LONG BEFORE THIS TIME? iF CBC FLIPS THE SETUP RESETS FOR THAT DIRECTION AND ANY
// OLD SETUP IS CANCELLED") followed by the clarifying answer "#3 BUT DRAW A NEW SETUP FOR THE REVERSE
// DIRECTION WHEN IT IS VALID". Root cause confirmed: nothing previously re-checked an already-drawn
// setup against the CONFIRMED HTF direction after the fact -- it only ever changed when a brand new
// trigger condition fired on its own, so a stale opposite-direction setup could sit on the chart
// indefinitely (extending right every bar) after HTF had already confirmed-flipped against it, right
// up until whatever future bar happened to satisfy a fresh trigger. Two new trailing params,
// `htf_dir_bull_now`/`htf_dir_bear_now` (the main script's own confirmed-direction booleans, same ones
// that already gate the trigger conditions themselves -- see fire_ltf_ema20_pierce_long/short) let this
// function compare the ACTIVE setup's own `active_long` against the CURRENT confirmed HTF direction on
// EVERY bar, not just on a new trigger. The moment they disagree, the active setup gets the exact same
// freeze treatment the TP2/SL2 breach path already applies (extend.none + right/x2 pinned to the
// current bar, `ats_frozen := true`) -- per the direct answer choosing option 3 (freeze, don't delete)
// over outright deletion, so the stale setup stays on the chart as a historical record instead of
// vanishing. This freeze check runs BEFORE the `new_setup` branch so it also covers the common case
// where the flip and a fresh same-bar trigger land together: if a new setup is now being drawn on a
// bar where the old one just got frozen (by this check, or already frozen earlier by a TP2/SL2 breach),
// the old objects are left alone (not deleted) and fresh objects are created for the new setup --
// satisfying "draw a new setup for the reverse direction when it is valid" without disturbing the just-
// frozen record. When the new trigger is instead a same-direction re-fire (old setup never froze because
// direction still agrees), behavior is UNCHANGED from before: delete-and-redraw in place, same as ever
// -- no duplicate same-direction setups pile up. `f_ats_compute_trigger()` already only signals a new
// setup once stop/target both resolve to real, non-na, non-entry-equal values (see its own v62 comment
// block above), which is what makes the reverse-direction redraw already conditional on validity with
// no further change needed here -- this round's fix is specifically the missing freeze-on-flip half.
// v89 (10/01/2026): minimum SL distance. A stop nearer to entry than m points is pushed out to exactly
// m points (m <= 0 = off). Exported so the main script applies the same rule to its alert levels.
export f_ats_min_sl(float v, float en, bool lg, float m) =>
    (m <= 0 or na(v) or na(en) or math.abs(v - en) >= m) ? v : (lg ? en - m : en + m)
// pivot-name cell for a stop sitting exactly at the minimum distance with no pool level there
f_ats_min_sl_name(string nm, float v, float en, float m) =>
    (nm == "" and m > 0 and not na(v) and not na(en) and math.abs(math.abs(v - en) - m) < 1e-6) ? "Min " + str.tostring(m) : nm
// v97 (10/02/2026): HTF CBC Flip "wait for pullback", two steps. (1) Within win candles after a qualifying
// flip, a candle's range touches the flip's BRSG entry zone (zt/zb) or the chart EMA20 (e20). (2) Within win
// candles of that touch (the touch candle included), a candle closes back on the trade side of the touched
// level and in the trade direction (long: close above the level and above its open; short mirrored).
// HTF direction unchanged and no setup drawn since the flip. Returns +age (long) / -age (short) in bars after
// the flip on the confirming candle, else 0.
// v98: two_step = false -> the v96 behavior (touch and close-back on the SAME candle, within win of the flip).
export f_ats_flip_pb(bool flip_l, bool flip_s, int win, float zt, float zb, float e20, bool dir_bull, bool dir_bear, int last_draw, bool two_step) =>
    var int arm = na
    var bool arm_l = false
    var int t_bar = na
    var bool t_ema = false
    if flip_l or flip_s
        arm := bar_index
        arm_l := flip_l
        t_bar := na
    int age = na(arm) ? -1 : bar_index - arm
    int res = 0
    bool ok_state = age >= 1 and (na(last_draw) or last_draw < arm) and (arm_l ? dir_bull : dir_bear)
    float zhi = na(zt) or na(zb) ? na : math.max(zt, zb)
    float zlo = na(zt) or na(zb) ? na : math.min(zt, zb)
    if ok_state and na(t_bar) and age <= win
        bool t_zone = not na(zhi) and low <= zhi and high >= zlo
        bool t_e20 = not na(e20) and low <= e20 and high >= e20
        if t_zone or t_e20
            t_bar := bar_index
            t_ema := t_e20
    if ok_state and not na(t_bar) and bar_index - t_bar <= win and (two_step or t_bar == bar_index)
        float lvl = t_ema ? e20 : arm_l ? zlo : zhi
        if not na(lvl) and (arm_l ? close > lvl and close > open : close < lvl and close < open)
            res := arm_l ? age : -age
            arm := na
            t_bar := na
    if not two_step
        t_bar := na
    if not na(arm) and ((na(t_bar) and age > win) or (not na(t_bar) and bar_index - t_bar > win) or not ok_state and age >= 1)
        arm := na
        t_bar := na
    res
// v96: "Setup ..." status lines for alerts (moved from the main script's f_ats_state_msg). st = the
// f_ats_draw_setup state [entry, TP1, SL1, TP2, SL2, long, live]. Only a VALID setup is sent: live, same
// direction as the confirmed HTF CBC, price still on the right side of SL1.
f_ats_st_val(string nm, float v, string piv) =>
    na(v) ? "" : "\nSetup " + nm + ": " + str.tostring(v, "#.##") + " | " + piv + " | " + (v - close >= 0 ? "+" : "") + str.tostring(v - close, "#.##")
f_ats_st_lvl(string nm, float v, float[] cand, string[] names) =>
    string pv = na(v) ? "" : f_ats_level_name_top(v, cand, names)
    f_ats_st_val(nm, v, pv == "" ? "-" : pv)
f_ats_beyond(float v, bool up, float[] cand) =>
    na(v) ? float(na) : up ? f_ats_nearest_above(v, cand) : f_ats_nearest_below(v, cand)
export f_ats_state_msg(float[] st, float[] cand, string[] names, bool on, bool dir_bull, bool dir_bear) =>
    bool lg = array.get(st, 5) == 1.0
    float sl1 = array.get(st, 2)
    bool live = on and array.size(st) == 7 and array.get(st, 6) == 1.0 and (lg ? dir_bull : dir_bear) and not na(sl1) and (lg ? close > sl1 : close < sl1)
    float tp3 = f_ats_beyond(array.get(st, 3), lg, cand)
    float sl3 = f_ats_beyond(array.get(st, 4), not lg, cand)
    live ? "\nSetup: " + (lg ? "LONG" : "SHORT") + f_ats_st_lvl("TP4", f_ats_beyond(tp3, lg, cand), cand, names) + f_ats_st_lvl("TP3", tp3, cand, names) + f_ats_st_lvl("TP2", array.get(st, 3), cand, names) + f_ats_st_lvl("TP1", array.get(st, 1), cand, names) + f_ats_st_val("Entry", array.get(st, 0), lg ? "Long" : "Short") + f_ats_st_lvl("SL1", sl1, cand, names) + f_ats_st_lvl("SL2", array.get(st, 4), cand, names) + f_ats_st_lvl("SL3", sl3, cand, names) + f_ats_st_lvl("SL4", f_ats_beyond(sl3, not lg, cand), cand, names) : ""
// v96: pierce label -- "Entry: LONG/SHORT", or "Option 2: Reverse ..." when the candle closed through the line
// against the trend (moved here from the main script, v8.51).
export f_pierce_word(bool lg, float lvl) =>
    lg ? (close >= lvl ? "Entry: LONG" : "Option 2: Reverse LONG→SHORT") : (close <= lvl ? "Entry: SHORT" : "Option 2: Reverse SHORT→LONG")
// v90 (10/01/2026): reward:risk text for the setup table: (TP - ref) / (ref - SL) in the trade direction,
// e.g. "1.8"; "—" when a level is missing or price is already past the stop, "0" once past the target.
f_ats_rr(float ref, float tp, float sl, bool lg) =>
    float rew = na(tp) or na(ref) ? na : (lg ? tp - ref : ref - tp)
    float rsk = na(sl) or na(ref) ? na : (lg ? ref - sl : sl - ref)
    na(rew) or na(rsk) or rsk <= 0 ? "—" : rew <= 0 ? "0" : str.tostring(rew / rsk, "0.0")
// v89: applies the minimum SL distance to the main script's setup-call array [entry, SL1, TP1, SL2, TP2].
export f_ats_min_sl_call(float[] c, float m) =>
    bool lg = array.get(c, 2) > array.get(c, 0)
    array.set(c, 1, f_ats_min_sl(array.get(c, 1), array.get(c, 0), lg, m))
    array.set(c, 3, f_ats_min_sl(array.get(c, 3), array.get(c, 0), lg, m))
    true
// v99 (10/02/2026): pivot vs ATR levels side by side. c = the setup call [entry, SL1, TP1, SL2, TP2] with the
// pool-level (pivot) levels. ATR levels = entry -/+ multiplier x atr (stops s1/s2, targets t1/t2).
// sl_on / tp_on = true: the ATR stops / targets become the active ones (written into c). Returns the OTHER
// method's [SL1, SL2, TP1, TP2] for the Trade Levels info rows, followed by the 4 ATR multipliers
// [s1, s2, t1, t2], the ATR value (shown as "1.5×ATR (2.9)") and the 4 stops BEFORE the min-SL push-out
// [active SL1, active SL2, other SL1, other SL2]. msl = min SL distance.
export f_ats_atr_lv(float[] c, float atr, float s1_in, float s2, float t1, float t2, bool sl_on, bool tp_on, float msl, float cap) =>
    // rev11: per-symbol cap -- ATR SL1 never farther than cap pts from Entry (the multiplier shown drops to cap / ATR)
    float s1 = not na(cap) and atr > 0 and s1_in * atr > cap ? cap / atr : s1_in
    float en = array.get(c, 0)
    bool lg = array.get(c, 2) > en
    float d = lg ? atr : -atr
    float a1 = f_ats_min_sl(en - d * s1, en, lg, msl)
    float a2 = f_ats_min_sl(en - d * s2, en, lg, msl)
    float p1 = f_ats_min_sl(array.get(c, 1), en, lg, msl)
    float p2 = f_ats_min_sl(array.get(c, 3), en, lg, msl)
    float at1 = en + d * t1
    float at2 = en + d * t2
    float pt1 = array.get(c, 2)
    float pt2 = array.get(c, 4)
    float rp1 = array.get(c, 1)
    float rp2 = array.get(c, 3)
    bool us = sl_on and not na(atr)
    bool ut = tp_on and not na(atr)
    if us
        array.set(c, 1, a1)
        array.set(c, 3, a2)
    if ut
        array.set(c, 2, at1)
        array.set(c, 4, at2)
    array.from(us ? p1 : a1, us ? p2 : a2, ut ? pt1 : at1, ut ? pt2 : at2, s1, s2, t1, t2, atr, us ? en - d * s1 : rp1, us ? en - d * s2 : rp2, us ? rp1 : en - d * s1, us ? rp2 : en - d * s2)
// rev11: SL cap (pts) for the chart symbol from a text list like "MGC 12, MES 8, MNQ 30, M2K 5, MCL 0.3, BTC 500"
// ("MGC=12" / "MGC: 12" also work). Full size uses the micro's entry (GC=MGC, ES=MES, NQ=MNQ, RTY=M2K, CL=MCL), BTC = MBT / any
// BTC root. na = off, symbol not listed, or 0.
export f_sl_cap(bool on, string txt) =>
    string r = syminfo.root
    string k = r == "GC" ? "MGC" : r == "ES" ? "MES" : r == "NQ" ? "MNQ" : r == "RTY" ? "M2K" : r == "CL" ? "MCL" : r == "MBT" or str.contains(r, "BTC") ? "BTC" : r
    float v = na
    if on
        for p in str.split(txt, ",")
            string[] kv = str.split(str.trim(str.replace_all(str.replace_all(p, "=", " "), ":", " ")), " ")
            if array.size(kv) >= 2 and str.upper(array.get(kv, 0)) == k
                v := str.tonumber(array.get(kv, array.size(kv) - 1))
    v > 0 ? v : na
// v89: pivot text for an alert level line ("-" when no pool level, "Min N" at the minimum SL distance).
export f_ats_pv_txt(string pv, float v, float en, float m) =>
    string nm = f_ats_min_sl_name(pv, v, en, m)
    nm == "" ? "-" : nm
// v99: ATR pivot text, e.g. "1.5×ATR (2.9)" = 1.5 x the 3m ATR of 2.9 pts on the setup candle.
f_ats_atr_txt(float m, float atr) =>
    str.tostring(m, "0.0") + "×ATR (" + str.tostring(atr, "0.0#") + ")"
// v99 rev6 (10/03/2026): momentum continuation trigger (no pullback needed). +1 = long: a candle closes above the
// last confirmed LTF swing high (the previous close was not above it), closes green, HTF CBC confirmed long.
// -1 = short, mirrored on the last swing low. Each swing level triggers once; 0 = nothing.
export f_ats_momo(bool on, float swh, float swl, bool dir_bull, bool dir_bear) =>
    var float used_h = na
    var float used_l = na
    bool lg = on and dir_bull and not na(swh) and swh != used_h and close > swh and close[1] <= swh and close > open
    bool sh = on and dir_bear and not na(swl) and swl != used_l and close < swl and close[1] >= swl and close < open
    if lg
        used_h := swh
    if sh
        used_l := swl
    lg ? 1 : sh ? -1 : 0
// v99 rev5 (10/03/2026): Trade Setup filters. Returns [long ok (1/0), short ok (1/0), Choppiness Index,
// close-vs-VWAP distance in ATR (+ = above), HTF CBC flips in the last fwin HTF candles].
// CHOP = 100 x log10(sum TR(n) / (highest(n) - lowest(n))) / log10(n): > ~61.8 sideways, < ~38.2 trending.
// v99 rev25 (10/11/2026): six more chop filters, computed by f_ats_chop2 and passed in as c2 (c2[0] = 1 ok / 0 blocked).
// Returned array: [0..4] as before, then c2: [5] ok, [6] ADX, [7] Efficiency Ratio, [8] EMA20/VWAP crosses,
// [9] HTF EMA20 slope (x ATR), [10] n-bar range (x ATR), [11] mixed structure (1/0).
export f_ats_chop2(float atr, simple int n, float e20, float vw, float h20, string hs, string ls, bool adx_on, float adx_max, bool er_on, float er_min, bool x_on, int x_n, bool sl_on, float sl_min, bool rg_on, float rg_min, bool st_on) =>
    [dp, dm, adx] = ta.dmi(n, n)
    float er_d = math.sum(math.abs(close - close[1]), n)
    float er = er_d > 0 ? math.abs(close - close[n]) / er_d : na
    bool xe = not na(e20[1]) and (close > e20) != (close[1] > e20[1])
    bool xv = not na(vw) and not na(vw[1]) and (close > vw) != (close[1] > vw[1])
    int xs = int(math.sum(xe or xv ? 1 : 0, n))
    float slp = atr > 0 ? math.abs(h20 - h20[n]) / atr : na
    float rg = atr > 0 ? (ta.highest(n) - ta.lowest(n)) / atr : na
    bool mix = (hs == "Lower High" and ls == "Higher Low") or (hs == "Higher High" and ls == "Lower Low")
    bool blk = (adx_on and adx < adx_max) or (er_on and er < er_min) or (x_on and xs >= x_n) or (sl_on and slp < sl_min) or (rg_on and rg < rg_min) or (st_on and mix)
    array.from(blk ? 0.0 : 1.0, adx, er, float(xs), slp, rg, mix ? 1.0 : 0.0)
export f_ats_filters(float vw, float atr, bool chop_on, float chop_max, simple int chop_len, bool ext_on, float ext_max, bool flip, bool flip_on, int fn, int fwin, simple string htf, float[] c2) =>
    float rng = ta.highest(chop_len) - ta.lowest(chop_len)
    float chop = rng > 0 ? 100 * math.log10(math.sum(ta.tr(true), chop_len) / rng) / math.log10(chop_len) : na
    float ext = na(atr) or atr <= 0 or na(vw) ? na : (close - vw) / atr
    int bars = math.max(1, fwin * math.max(1, int(timeframe.in_seconds(htf) / timeframe.in_seconds())))
    int flips = int(math.sum(flip ? 1 : 0, bars))
    bool ok = not (chop_on and not na(chop) and chop > chop_max) and not (flip_on and flips >= fn) and array.get(c2, 0) > 0
    bool ok_l = ok and not (ext_on and not na(ext) and ext > ext_max)
    bool ok_s = ok and not (ext_on and not na(ext) and -ext > ext_max)
    array.concat(array.from(ok_l ? 1.0 : 0.0, ok_s ? 1.0 : 0.0, chop, ext, float(flips)), c2)
// v99 rev5: "Filters: CHOP 58.3 | VWAP ext +1.2 ATR | HTF flips 1/8" line for the Trade Setup alert (ext signed for
// the trade direction: + = stretched in the trade's favour).
export f_ats_flt_txt(float[] f, bool lg, int fwin) =>
    float ext = array.get(f, 3) * (lg ? 1 : -1)
    "\nFilters: CHOP " + str.tostring(array.get(f, 2), "#.#") + " | VWAP ext " + (ext >= 0 ? "+" : "") + str.tostring(ext, "#.#") + " ATR | HTF flips " + str.tostring(array.get(f, 4), "#") + "/" + str.tostring(fwin) + (array.size(f) > 11 ? " | ADX " + str.tostring(array.get(f, 6), "#.#") + " | ER " + str.tostring(array.get(f, 7), "0.00") + " | X " + str.tostring(array.get(f, 8), "#") + " | Slope " + str.tostring(array.get(f, 9), "0.0#") + " ATR | Range " + str.tostring(array.get(f, 10), "0.0") + " ATR" + (array.get(f, 11) > 0 ? " | Struct mixed" : "") : "")
// v99: one Trade Setup alert level line "NAME: price | pivot | +pts". am > 0 = an ATR level: with no pool level
// at that price its pivot text is "<am> ATR" (e.g. "1.5 ATR").
// v99: when a stop was pushed out to the min SL distance, the name of the level it came from ("" if not pushed).
f_ats_raw_nm(float raw, float v, float en, float msl, float[] cand, string[] names, float am, float atr) =>
    bool cl = msl > 0 and not na(raw) and not na(v) and not na(en) and math.abs(raw - en) < msl - 1e-9 and math.abs(math.abs(v - en) - msl) < 1e-6
    string rn = cl ? f_ats_level_name_top(raw, cand, names) : ""
    cl ? (rn != "" ? rn : am > 0 ? f_ats_atr_txt(am, atr) : "level") : ""
f_ats_sgn(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "#.##")
// raw = the stop before the min-SL push-out (na for targets): a pushed stop reads
// "SL2: 7775 | Min 4 (VWAP) | +4 (+1.53)" -- the original level and its distance from Entry in brackets.
f_ats_lv1(string nm, float v, float en, float[] cand, string[] names, float msl, float am, float atr, float raw) =>
    string pt = f_ats_pv_txt(f_ats_level_name_top(v, cand, names), v, en, msl)
    string rn = f_ats_raw_nm(raw, v, en, msl, cand, names, am, atr)
    nm + ": " + (na(v) ? "—" : str.tostring(v, "#.##") + " | " + (rn != "" ? "Min " + str.tostring(msl) + " (" + rn + ")" : am > 0 and pt == "-" ? f_ats_atr_txt(am, atr) : pt) + " | " + f_ats_sgn(v - en) + (rn != "" ? " (" + f_ats_sgn(raw - en) + ")" : "")) + "\n"
// v99: all Trade Setup alert level lines, TP4..SL4, including the other method's TP1/TP2 and SL1/SL2
// ("TP1 ATR"... or "TP1 Piv"... when ATR is the active method). c = [entry, SL1, TP1, SL2, TP2] (active),
// alt = f_ats_atr_lv's 8 values.
export f_ats_lv_lines(float[] c, float[] alt, float[] cand, string[] names, float msl, bool sl_on, bool tp_on) =>
    float en = array.get(c, 0)
    bool lg = array.get(c, 2) > en
    float tp3 = f_ats_beyond(array.get(c, 4), lg, cand)
    float sl3 = f_ats_beyond(array.get(c, 3), not lg, cand)
    string ta = tp_on ? " Piv" : " ATR"
    string sa = sl_on ? " Piv" : " ATR"
    float m4 = array.get(alt, 4)
    float m5 = array.get(alt, 5)
    float m6 = array.get(alt, 6)
    float m7 = array.get(alt, 7)
    float atr = array.size(alt) > 8 ? array.get(alt, 8) : na
    bool hr = array.size(alt) > 12
    f_ats_lv1("TP4", f_ats_beyond(tp3, lg, cand), en, cand, names, msl, 0, atr, float(na)) + f_ats_lv1("TP3", tp3, en, cand, names, msl, 0, atr, float(na)) + f_ats_lv1("TP2" + ta, array.get(alt, 3), en, cand, names, msl, tp_on ? 0 : m7, atr, float(na)) + f_ats_lv1("TP1" + ta, array.get(alt, 2), en, cand, names, msl, tp_on ? 0 : m6, atr, float(na)) + f_ats_lv1("TP2", array.get(c, 4), en, cand, names, msl, tp_on ? m7 : 0, atr, float(na)) + f_ats_lv1("TP1", array.get(c, 2), en, cand, names, msl, tp_on ? m6 : 0, atr, float(na)) + "Entry: " + str.tostring(en, "#.##") + "\n" + f_ats_lv1("SL1", array.get(c, 1), en, cand, names, msl, sl_on ? m4 : 0, atr, (hr ? array.get(alt, 9) : na)) + f_ats_lv1("SL2", array.get(c, 3), en, cand, names, msl, sl_on ? m5 : 0, atr, (hr ? array.get(alt, 10) : na)) + f_ats_lv1("SL1" + sa, array.get(alt, 0), en, cand, names, msl, sl_on ? 0 : m4, atr, (hr ? array.get(alt, 11) : na)) + f_ats_lv1("SL2" + sa, array.get(alt, 1), en, cand, names, msl, sl_on ? 0 : m5, atr, (hr ? array.get(alt, 12) : na)) + f_ats_lv1("SL3", sl3, en, cand, names, msl, 0, atr, float(na)) + f_ats_lv1("SL4", f_ats_beyond(sl3, not lg, cand), en, cand, names, msl, 0, atr, float(na))
// rev22: remove the fill of a finished setup's boxes (border and labels stay).
// rev23: fill = c at (100 - op)% transparency (op = opacity %, 0 = no fill).
f_ats_hollow(box[] bs, color c, int op) =>
    for b in bs
        if not na(b)
            box.set_bgcolor(b, color.new(c, 100 - math.max(0, math.min(100, op))))
// rev29: exit marker for a setup that ends without hitting SL1 (HTF flip, 17:00, replaced, TP2, SL2) -- same style as
// the Ⓢ marker: profit side = TP side of the candle, loss side = SL side; returns [connector line or na, label].
// rev30: "\nEntry 09:45 @ 4206.5 → Exit 10:12 @ 4209.8 ET" (tm = the Entry part, px = exit price, exit = this candle's close time)
// rev32: how the stop-exit price came about (stop marker tooltip). tp1 = TP1 was hit (trail / BE phase); ref / d / tm = the
// candle price, distance and time of the last trail move (na = never moved by the trail -> breakeven or original SL1).
f_ats_trail_why(bool tp1, bool lg, float stp, float en, float t1, float ref, float d, int tm, float trail, float m, float part, bool be) =>
    string s = ""
    if tp1
        string sg = lg ? " − " : " + "
        float lk = lg ? stp - en : en - stp
        s := na(ref) ? (be ? "\nSL1 at breakeven: Entry " + str.tostring(en, "#.##") : "\nSL1 not moved by the trail") : "\nTrail: " + (trail < 0 ? (lg ? "high " : "low ") : "close ") + str.tostring(ref, "#.##") + " (" + str.format_time(tm, "HH:mm", "America/New_York") + ")" + sg + str.tostring(d, "#.##") + (na(m) or m <= 0 ? "" : " (" + str.tostring(m, "#.##") + " × ATR " + str.tostring(d / m, "#.##") + ")") + " = " + str.tostring(stp, "#.##") + "\nLocked " + (lk >= 0 ? "+" : "") + str.tostring(lk, "#.##") + " pts vs Entry " + str.tostring(en, "#.##")
        float p = math.max(0.0, math.min(100.0, part)) / 100.0
        if p > 0
            float p1 = lg ? t1 - en : en - t1
            float rn = lg ? stp - en : en - stp
            s += "\nResult: " + str.tostring(p * 100, "#") + "% × " + (p1 >= 0 ? "+" : "") + str.tostring(p1, "#.##") + " (TP1) + " + str.tostring((1 - p) * 100, "#") + "% × " + (rn >= 0 ? "+" : "") + str.tostring(rn, "#.##") + (na(ref) ? (be ? " (BE)" : " (SL1)") : " (trail)") + " = " + (p * p1 + (1 - p) * rn >= 0 ? "+" : "") + str.tostring(p * p1 + (1 - p) * rn, "#.##")
    s
f_ats_tx(string tm, float px) =>
    tm == "" ? "" : tm + " → Exit " + str.format_time(time_close, "HH:mm", "America/New_York") + " @ " + str.tostring(px, "#.##") + " ET"
// rev36: tooltip result lines for an exit at px -- the runner's points, the TP1 part (when TP1 was hit) and the total.
f_ats_res(bool tp1, bool lg, float px, float en, float t1, float part, float t2) =>
    float rn = (lg ? 1 : -1) * (px - en)
    float p = tp1 ? math.max(0.0, math.min(100.0, part)) / 100.0 : 0.0
    float p1 = na(t1) ? 0.0 : (lg ? 1 : -1) * (t1 - en)
    string sg = (rn >= 0 ? "+" : "") + str.tostring(rn, "#.##")
    float pp = math.max(0.0, math.min(100.0, part)) / 100.0
    float p2 = na(t2) ? na : (lg ? 1 : -1) * (t2 - en)
    string hy = na(p2) or na(t1) ? "" : "\nIf the runner had reached TP2 " + str.tostring(t2, "#.##") + " (" + (p2 >= 0 ? "+" : "") + str.tostring(p2, "#.##") + "): " + str.tostring(pp * 100, "#") + "% × " + (p1 >= 0 ? "+" : "") + str.tostring(p1, "#.##") + " + " + str.tostring((1 - pp) * 100, "#") + "% × " + (p2 >= 0 ? "+" : "") + str.tostring(p2, "#.##") + " = " + (pp * p1 + (1 - pp) * p2 >= 0 ? "+" : "") + str.tostring(pp * p1 + (1 - pp) * p2, "#.##") + " pts"
    (p > 0 ? "\nRunner (" + str.tostring((1 - p) * 100, "#") + "%): " + sg + " pts\nTP1 (" + str.tostring(p * 100, "#") + "%) @ " + str.tostring(t1, "#.##") + ": " + (p1 >= 0 ? "+" : "") + str.tostring(p1, "#.##") + " pts\nResult: " + str.tostring(p * 100, "#") + "% × " + (p1 >= 0 ? "+" : "") + str.tostring(p1, "#.##") + " + " + str.tostring((1 - p) * 100, "#") + "% × " + sg + " = " + (p * p1 + (1 - p) * rn >= 0 ? "+" : "") + str.tostring(p * p1 + (1 - p) * rn, "#.##") + " pts" : "\nTP1 not reached -- whole position: " + sg + " pts") + hy
f_ats_xm(bool lg, float px, float en, string tag, bool tiny, int tr, float xo, string tm, string rt) =>
    float xr = (lg ? 1 : -1) * (px - en)
    bool up = lg == (xr > 0.0001)
    float y = tiny ? (up ? math.max(high, px) + xo : math.min(low, px) - xo) : px
    color c = xr > 0.0001 ? #16A34A : #DC2626
    string t = tag + " " + (xr > 0 ? "+" : "") + str.tostring(xr, "#.##")
    line l = tiny ? line.new(bar_index, px, bar_index, y, color=c, style=line.style_dashed, width=2) : na
    label b = label.new(bar_index, y, tiny ? (tag == "HTF flip" ? "F" : tag == "16:00" ? "E" : tag == "Replaced" ? "R" : tag == "TP2" ? "T2" : tag == "Time stop" ? "TS" : "S") : t, color=color.new(c, tiny ? 0 : tr), textcolor=color.white, style=tiny ? label.style_label_center : up ? label.style_label_down : label.style_label_up, size=size.small, tooltip=t + " -- setup exit @ " + str.tostring(px, "#.##") + " (pts on the runner)" + f_ats_tx(tm, px) + rt)
    [l, b]
export f_ats_draw_setup(bool new_setup, float entry, float stop, float target, color reward_col, color risk_col, bool show_lvl2, float stop2, float target2, color reward2_col, color risk2_col, float tp1_handle, float sl1_handle, float tp2_handle, float sl2_handle, float tol, float[] cand, bool show_tbl, string tbl_pos, string tbl_size, string[] cand_names, bool htf_dir_bull_now, bool htf_dir_bear_now, bool auto_t1, bool auto_s1, bool auto_t2, bool auto_s2, bool keep_old, string flip_txt, bool flip_long, float min_sl, string rr_pos, float[] alt_sl, bool atr_on, bool atr_tp_on, float trail, float part, bool be, int done_op, int keep_n, bool sl_lbl, bool ex_tiny, int ex_tr, float trail_m, bool tstop) =>
    var box reward_box = na
    var box risk_box = na
    var box reward_box2 = na
    var box risk_box2 = na
    var line entry_line = na
    var line stop_line = na
    var line target_line = na
    var line stop2_line = na
    var line target2_line = na
    var label target_lbl = na
    var label stop_lbl = na
    var label target2_lbl = na
    var label stop2_lbl = na
    var float active_entry = na
    var float active_target = na
    var float active_stop = na
    var float tr_ref = na // rev32: price (close / high / low) that last moved the trailing SL1
    var float tr_d = na // rev32: trail distance (pts) used for that move
    var int tr_tm = na // rev32: close time of that candle
    var float active_target2 = na
    var float active_stop2 = na
    var bool active_long = bool(na)
    var int active_bar = na
    var int active_t = na // rev20: time (candle close) the active setup was drawn
    var bool ats_frozen = false
    var bool ats_touched = false
    var bool tp1_hit = false // rev11: trailing SL1 armed (TP1 reached, trail on)
    var box trail_box = na // rev16: shading Entry..trailed SL1 for the current trail step
    var box run_box = na // rev19: Entry..best close since TP1 (profit area grows at each candle close)
    var float run_top = na
    var box[] sub_boxes = array.new_box() // rev22: running-profit / trail step boxes of the active setup (green)
    var box[] sub_boxes_r = array.new_box() // rev23: trail step boxes still on the losing side (red)
    var bool tp1_mark = false // rev21: "50% @ TP1" marker drawn for this setup
    var box[] all_b = array.new_box() // rev24: every setup drawing + its setup number (rolling erase, keep_n)
    var line[] all_l = array.new_line()
    var label[] all_lb = array.new_label()
    var int[] id_b = array.new_int()
    var int[] id_l = array.new_int()
    var int[] id_lb = array.new_int()
    var int sid = 0
    // v99: the other SL method's SL1/SL2 (info rows in the Trade Levels table), latched per setup.
    var float[] altv = array.new_float(13, na)
    // v74: pivot names for the Trade Levels box, latched when a level is set or moves.
    var string nm_t1 = ""
    var string nm_s1 = ""
    var string nm_t2 = ""
    var string nm_s2 = ""
    var string tip_t1 = ""
    var string tip_s1 = ""
    var string tip_t2 = ""
    var string tip_s2 = ""
    // v68: confirmed-HTF-flip-against-active-setup freeze check -- runs on EVERY call (new_setup or
    // not), before anything else, so a stale setup gets frozen the instant the confirmed HTF direction
    // disagrees with it, even on a bar where no fresh trigger happens to fire. See the v68 comment block
    // above this function for the full explanation.
    // rev29: exit-marker offset past the candle = 1.5 x candle range, capped at 1 x ATR(14) so a huge candle never throws the marker far away
    float xo = nz(math.min(1.5 * (high - low), ta.atr(14)), high - low)
    // rev30: setup / exit times (ET) for the exit marker tooltips
    string tmx = na(active_t) ? "" : "\nEntry " + str.format_time(active_t, "HH:mm", "America/New_York") + " @ " + str.tostring(active_entry, "#.##")
    bool htf_dir_known = htf_dir_bull_now or htf_dir_bear_now
    bool dir_flip_x = htf_dir_known and ((active_long and htf_dir_bear_now) or (not active_long and htf_dir_bull_now))
    // rev33: time stop (before TP1 only) ends the setup like an HTF flip, at the close
    bool ts_x = tstop and not tp1_hit and not dir_flip_x
    bool dir_flipped_against_active = not na(active_entry) and not ats_frozen and not na(reward_box) and (dir_flip_x or ts_x)
    if dir_flipped_against_active
        if sl_lbl
            [xl, xb] = f_ats_xm(active_long, close, active_entry, ts_x ? "Time stop" : htf_dir_bull_now and htf_dir_bear_now ? "16:00" : "HTF flip", ex_tiny, ex_tr, xo, tmx, f_ats_res(tp1_hit, active_long, close, active_entry, active_target, part, active_target2))
            if not na(xl)
                array.push(all_l, xl)
                array.push(id_l, sid)
            array.push(all_lb, xb)
            array.push(id_lb, sid)
        if not tp1_hit // rev19: a trailing setup's TP1 box already ended at TP1; the running-profit box ends instead
            box.set_extend(reward_box, extend.none)
            box.set_right(reward_box, bar_index)
        if not na(run_box)
            box.set_extend(run_box, extend.none)
            box.set_right(run_box, bar_index)
        if not tp1_hit // rev15: a trailing setup's risk box already ended at TP1
            box.set_extend(risk_box, extend.none)
            box.set_right(risk_box, bar_index)
        line.set_extend(entry_line, extend.none)
        line.set_x2(entry_line, bar_index)
        line.set_extend(stop_line, extend.none)
        line.set_x2(stop_line, bar_index)
        if not na(trail_box)
            box.set_extend(trail_box, extend.none)
            box.set_right(trail_box, bar_index)
        line.set_extend(target_line, extend.none)
        line.set_x2(target_line, bar_index)
        if not na(reward_box2)
            box.set_extend(reward_box2, extend.none)
            box.set_right(reward_box2, bar_index)
            line.set_extend(target2_line, extend.none)
            line.set_x2(target2_line, bar_index)
        if not na(risk_box2)
            box.set_extend(risk_box2, extend.none)
            if not tp1_hit
                box.set_right(risk_box2, bar_index)
            line.set_extend(stop2_line, extend.none)
            line.set_x2(stop2_line, bar_index)
        f_ats_hollow(array.from(reward_box, reward_box2), reward_col, done_op) // rev22/23: finished setup -> outline + light fill
        f_ats_hollow(array.from(risk_box, risk_box2), risk_col, done_op)
        f_ats_hollow(sub_boxes, reward_col, done_op)
        f_ats_hollow(sub_boxes_r, risk_col, done_op)
        ats_frozen := true
    // v81: remember whether price has touched ANY level (TP1/SL1/TP2/SL2) of the active setup.
    if not ats_touched and not ats_frozen and not na(active_entry)
        bool hit_t = (not na(active_target) and (active_long ? high >= active_target : low <= active_target)) or (not na(active_target2) and (active_long ? high >= active_target2 : low <= active_target2))
        bool hit_s = (not na(active_stop) and (active_long ? low <= active_stop : high >= active_stop)) or (not na(active_stop2) and (active_long ? low <= active_stop2 : high >= active_stop2))
        ats_touched := hit_t or hit_s
    if new_setup
        // v81: a touched setup is KEPT (frozen at this bar) when a new setup fires; only an untouched,
        // still-live setup is replaced by a same-direction re-fire.
        // rev24: keep_n >= 0 -> rolling erase: keep the new setup + keep_n earlier ones, delete every drawing of older setups
        sid += 1
        if keep_n >= 0
            int cut = sid - 1 - keep_n
            while array.size(id_b) > 0 and array.first(id_b) <= cut
                box.delete(array.shift(all_b))
                array.shift(id_b)
            while array.size(id_l) > 0 and array.first(id_l) <= cut
                line.delete(array.shift(all_l))
                array.shift(id_l)
            while array.size(id_lb) > 0 and array.first(id_lb) <= cut
                label.delete(array.shift(all_lb))
                array.shift(id_lb)
        if keep_n != 0 and not ats_frozen and (ats_touched or keep_old or keep_n > 0) and not na(reward_box)
            if sl_lbl
                [xl, xb] = f_ats_xm(active_long, close, active_entry, "Replaced", ex_tiny, ex_tr, xo, tmx, f_ats_res(tp1_hit, active_long, close, active_entry, active_target, part, active_target2))
                if not na(xl)
                    array.push(all_l, xl)
                    array.push(id_l, sid - 1)
                array.push(all_lb, xb)
                array.push(id_lb, sid - 1)
            f_ats_hollow(array.from(reward_box, reward_box2), reward_col, done_op) // rev22/23: finished setup -> outline + light fill
            f_ats_hollow(array.from(risk_box, risk_box2), risk_col, done_op)
            f_ats_hollow(sub_boxes, reward_col, done_op)
            f_ats_hollow(sub_boxes_r, risk_col, done_op)
            if not tp1_hit // rev19: a trailing setup's TP1 box already ended at TP1; the running-profit box ends instead
                box.set_extend(reward_box, extend.none)
                box.set_right(reward_box, bar_index)
            if not na(run_box)
                box.set_extend(run_box, extend.none)
                box.set_right(run_box, bar_index)
            if not tp1_hit // rev15: a trailing setup's risk box already ended at TP1
                box.set_extend(risk_box, extend.none)
                box.set_right(risk_box, bar_index)
            line.set_extend(entry_line, extend.none)
            line.set_x2(entry_line, bar_index)
            line.set_extend(stop_line, extend.none)
            line.set_x2(stop_line, bar_index)
            if not na(trail_box)
                box.set_extend(trail_box, extend.none)
                box.set_right(trail_box, bar_index)
            line.set_extend(target_line, extend.none)
            line.set_x2(target_line, bar_index)
            if not na(reward_box2)
                box.set_extend(reward_box2, extend.none)
                box.set_right(reward_box2, bar_index)
                line.set_extend(target2_line, extend.none)
                line.set_x2(target2_line, bar_index)
            if not na(risk_box2)
                box.set_extend(risk_box2, extend.none)
                if not tp1_hit
                    box.set_right(risk_box2, bar_index)
                line.set_extend(stop2_line, extend.none)
                line.set_x2(stop2_line, bar_index)
        else if not ats_frozen
            box.delete(reward_box)
            box.delete(risk_box)
            box.delete(reward_box2)
            box.delete(risk_box2)
            line.delete(entry_line)
            line.delete(stop_line)
            line.delete(target_line)
            line.delete(stop2_line)
            line.delete(target2_line)
            label.delete(target_lbl)
            label.delete(stop_lbl)
            label.delete(target2_lbl)
            label.delete(stop2_lbl)
        reward_box := box.new(bar_index, math.max(entry, target), bar_index, math.min(entry, target), border_color=color.new(#22C55E, 40), bgcolor=reward_col, extend=extend.right)
        risk_box := box.new(bar_index, math.max(entry, stop), bar_index, math.min(entry, stop), border_color=color.new(#EF4444, 40), bgcolor=risk_col, extend=extend.right)
        entry_line := line.new(bar_index, entry, bar_index, entry, color=color.new(color.white, 20), width=1, style=line.style_dashed, extend=extend.right)
        stop_line := line.new(bar_index, stop, bar_index, stop, color=color.new(#EF4444, 0), width=1, style=line.style_dotted, extend=extend.right)
        target_line := line.new(bar_index, target, bar_index, target, color=color.new(#22C55E, 0), width=1, style=line.style_dotted, extend=extend.right)
        target_lbl := label.new(bar_index, target, "TP1 " + str.tostring(target, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#22C55E, 0), style=label.style_label_left, size=size.small)
        stop_lbl := label.new(bar_index, stop, "SL1 " + str.tostring(stop, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#EF4444, 0), style=label.style_label_left, size=size.small)
        array.push(all_b, reward_box)
        array.push(id_b, sid)
        array.push(all_b, risk_box)
        array.push(id_b, sid)
        array.push(all_l, entry_line)
        array.push(id_l, sid)
        array.push(all_l, stop_line)
        array.push(id_l, sid)
        array.push(all_l, target_line)
        array.push(id_l, sid)
        array.push(all_lb, target_lbl)
        array.push(id_lb, sid)
        array.push(all_lb, stop_lbl)
        array.push(id_lb, sid)
        if show_lvl2 and not na(target2)
            reward_box2 := box.new(bar_index, math.max(target, target2), bar_index, math.min(target, target2), border_color=color.new(#22C55E, 55), bgcolor=reward2_col, extend=extend.right)
            target2_line := line.new(bar_index, target2, bar_index, target2, color=color.new(#22C55E, 25), width=1, style=line.style_dotted, extend=extend.right)
            target2_lbl := label.new(bar_index, target2, "TP2 " + str.tostring(target2, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#22C55E, 25), style=label.style_label_left, size=size.small)
            array.push(all_b, reward_box2)
            array.push(id_b, sid)
            array.push(all_l, target2_line)
            array.push(id_l, sid)
            array.push(all_lb, target2_lbl)
            array.push(id_lb, sid)
        if show_lvl2 and not na(stop2)
            risk_box2 := box.new(bar_index, math.max(stop, stop2), bar_index, math.min(stop, stop2), border_color=color.new(#EF4444, 55), bgcolor=risk2_col, extend=extend.right)
            stop2_line := line.new(bar_index, stop2, bar_index, stop2, color=color.new(#EF4444, 25), width=1, style=line.style_dotted, extend=extend.right)
            stop2_lbl := label.new(bar_index, stop2, "SL2 " + str.tostring(stop2, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#EF4444, 25), style=label.style_label_left, size=size.small)
            array.push(all_b, risk_box2)
            array.push(id_b, sid)
            array.push(all_l, stop2_line)
            array.push(id_l, sid)
            array.push(all_lb, stop2_lbl)
            array.push(id_lb, sid)
        active_entry := entry
        active_target := target
        active_stop := stop
        tr_ref := na
        tr_d := na
        tr_tm := na
        active_target2 := show_lvl2 ? target2 : na
        active_stop2 := show_lvl2 ? stop2 : na
        active_long := target > entry
        active_bar := bar_index
        active_t := time_close
        ats_frozen := false
        ats_touched := false
        tp1_hit := false
        trail_box := na
        run_box := na
        array.clear(sub_boxes)
        array.clear(sub_boxes_r)
        run_top := na
        tp1_mark := false
        if array.size(alt_sl) >= 8
            altv := array.copy(alt_sl)
        nm_t1 := f_ats_level_name_top(active_target, cand, cand_names)
        tip_t1 := f_ats_level_name(active_target, cand, cand_names)
        nm_s1 := f_ats_min_sl_name(f_ats_level_name_top(active_stop, cand, cand_names), active_stop, active_entry, min_sl)
        tip_s1 := f_ats_level_name(active_stop, cand, cand_names)
        nm_t2 := f_ats_level_name_top(active_target2, cand, cand_names)
        tip_t2 := f_ats_level_name(active_target2, cand, cand_names)
        nm_s2 := f_ats_min_sl_name(f_ats_level_name_top(active_stop2, cand, cand_names), active_stop2, active_entry, min_sl)
        tip_s2 := f_ats_level_name(active_stop2, cand, cand_names)
    else if not ats_frozen and not na(reward_box)
        // rev14: SL1 (or the trailed SL1, as set at the previous candle) crossed -> the drawn setup ends on this candle,
        // same rule and same stop value as the Setup Ended alert (f_ats_track).
        bool sl1_hit = not na(active_stop) and (active_long ? low <= active_stop : high >= active_stop)
        // Live handle-follow: f_ats_handle_snap() already returns its `current` argument UNCHANGED
        // whenever a handle is 0.0, na, or fails the v7.86 sanity check -- so passing each level's own
        // currently-active price as `current` makes every one of these 4 calls a natural no-op until its
        // handle is both active and meaningfully different from where that level already sits.
        float new_target = f_ats_live_snap(tp1_handle, active_target, tol, active_long, cand, active_entry)
        float new_stop = f_ats_live_snap(sl1_handle, active_stop, tol, not active_long, cand, active_entry)
        float new_target2 = na(active_target2) ? na : f_ats_live_snap(tp2_handle, active_target2, tol, active_long, cand, active_target)
        float new_stop2 = na(active_stop2) ? na : f_ats_live_snap(sl2_handle, active_stop2, tol, not active_long, cand, active_stop)
        // v80: auto re-pick -- a pool level that appeared after the trigger (e.g. a newly confirmed HTF/LTF
        // pivot) replaces an Automatic level whenever it sits nearer to entry on that level's side.
        if auto_t1 and not atr_tp_on and tp1_handle == 0.0
            float nt1 = active_long ? f_ats_nearest_above(active_entry, cand) : f_ats_nearest_below(active_entry, cand)
            if not na(nt1) and math.abs(nt1 - active_entry) < math.abs(new_target - active_entry)
                new_target := nt1
        if auto_s1 and not atr_on and sl1_handle == 0.0
            float ns1 = active_long ? f_ats_nearest_below(active_entry, cand) : f_ats_nearest_above(active_entry, cand)
            if not na(ns1) and math.abs(ns1 - active_entry) < math.abs(new_stop - active_entry)
                new_stop := ns1
        if auto_t2 and not atr_tp_on and tp2_handle == 0.0 and not na(new_target2)
            float nt2 = active_long ? f_ats_nearest_above(new_target, cand) : f_ats_nearest_below(new_target, cand)
            if not na(nt2) and math.abs(nt2 - active_entry) < math.abs(new_target2 - active_entry)
                new_target2 := nt2
        if auto_s2 and not atr_on and sl2_handle == 0.0 and not na(new_stop2)
            float ns2 = active_long ? f_ats_nearest_below(new_stop, cand) : f_ats_nearest_above(new_stop, cand)
            if not na(ns2) and math.abs(ns2 - active_entry) < math.abs(new_stop2 - active_entry)
                new_stop2 := ns2
        // v89: minimum SL distance -- a re-pick / handle snap can never pull SL1/SL2 nearer than min_sl.
        new_stop := f_ats_min_sl(new_stop, active_entry, active_long, min_sl)
        new_stop2 := f_ats_min_sl(new_stop2, active_entry, active_long, min_sl)
        // rev18: once trailing has started, SL1 only moves by the trail -- the min-SL distance / auto re-pick must not pull a
        // trailed SL1 (near or past Entry) back to Entry -/+ min SL on candles where the trail itself does not move
        if tp1_hit
            new_stop := active_stop
        // rev11: trailing SL1 -- once TP1 is reached, SL1 follows close -/+ trail (never loosens); overrides re-picks / min SL.
        // rev17: from-close trail (trail > 0) only moves on a confirmed candle close; from-high/low (< 0) stays live
        // rev21: partial-close marker on the candle that first reaches TP1
        if part > 0 and not tp1_mark and not sl1_hit and not na(active_target) and (active_long ? high >= active_target : low <= active_target)
            tp1_mark := true
            // rev28: symbol offset past the candle on the TP side + dotted connector back to the TP price
            float ty = ex_tiny ? (active_long ? math.max(high, active_target) + xo : math.min(low, active_target) - xo) : active_target
            if ex_tiny
                array.push(all_l, line.new(bar_index, active_target, bar_index, ty, color=#16A34A, style=line.style_dashed, width=2))
                array.push(id_l, sid)
            array.push(all_lb, label.new(bar_index, ty, ex_tiny ? "T1" : str.tostring(part, "#") + "% @ TP1", color=color.new(#16A34A, ex_tiny ? 0 : ex_tr), textcolor=color.white, style=ex_tiny ? label.style_label_center : active_long ? label.style_label_down : label.style_label_up, size=size.small, tooltip="TP1 partial: close " + str.tostring(part, "#") + "% @ " + str.tostring(active_target, "#.##") + f_ats_tx(tmx, active_target)))
            array.push(id_lb, sid)
        if not sl1_hit and (not na(trail) or be) and (trail < 0 or barstate.isconfirmed) and not na(active_target) and (tp1_hit or (active_long ? high >= active_target : low <= active_target))
            bool first_tp1 = not tp1_hit
            if first_tp1
                // rev15: TP1 reached with trailing on -> the original risk zone (Entry..SL1, SL1..SL2) ends here
                box.set_extend(risk_box, extend.none)
                box.set_right(risk_box, bar_index)
                if not na(risk_box2)
                    box.set_extend(risk_box2, extend.none)
                    box.set_right(risk_box2, bar_index)
                // rev19: the fixed TP1 box ends too; a running-profit box (Entry..best close) takes over
                box.set_extend(reward_box, extend.none)
                box.set_right(reward_box, bar_index)
                run_top := active_long ? math.max(active_target, close) : math.min(active_target, close)
                run_box := box.new(bar_index, math.max(active_entry, run_top), bar_index, math.min(active_entry, run_top), border_color=color.new(#22C55E, 50), bgcolor=reward_col, extend=extend.right)
                array.push(sub_boxes, run_box)
                array.push(all_b, run_box)
                array.push(id_b, sid)
            else if barstate.isconfirmed and (active_long ? close > run_top : close < run_top)
                // rev19: a new best close -> the profit area steps up (long) / down (short) from this candle
                box.set_extend(run_box, extend.none)
                box.set_right(run_box, bar_index)
                run_top := close
                run_box := box.new(bar_index, math.max(active_entry, run_top), bar_index, math.min(active_entry, run_top), border_color=color.new(#22C55E, 50), bgcolor=reward_col, extend=extend.right)
                array.push(sub_boxes, run_box)
                array.push(all_b, run_box)
                array.push(id_b, sid)
            tp1_hit := true
            // rev21: breakeven for the remainder at TP1 (option), then the trail
            float ns = active_stop
            if be
                ns := active_long ? math.max(ns, active_entry) : math.min(ns, active_entry)
            // rev13: trail < 0 = trail from the high (long) / low (short), moves live; > 0 = from the close
            if not na(trail)
                float tref = active_long ? (trail < 0 ? high : close) : (trail < 0 ? low : close)
                float tc = active_long ? tref - math.abs(trail) : tref + math.abs(trail)
                if active_long ? tc > ns : tc < ns
                    ns := tc
                    tr_ref := tref
                    tr_d := math.abs(trail)
                    tr_tm := time_close
            new_stop := ns
        if sl1_hit
            new_stop := active_stop
        bool tp1_moved = new_target != active_target
        bool sl1_moved = new_stop != active_stop
        bool tp2_moved = not na(new_target2) and new_target2 != active_target2
        bool sl2_moved = not na(new_stop2) and new_stop2 != active_stop2
        if tp1_moved
            active_target := new_target
            nm_t1 := f_ats_level_name_top(active_target, cand, cand_names)
            tip_t1 := f_ats_level_name(active_target, cand, cand_names)
            box.set_top(reward_box, math.max(active_entry, active_target))
            box.set_bottom(reward_box, math.min(active_entry, active_target))
            line.set_y1(target_line, active_target)
            line.set_y2(target_line, active_target)
            label.set_xy(target_lbl, active_bar, active_target)
            label.set_text(target_lbl, "TP1 " + str.tostring(active_target, "#.##"))
        if sl1_moved
            float old_stop = active_stop
            active_stop := new_stop
            nm_s1 := f_ats_min_sl_name(f_ats_level_name_top(active_stop, cand, cand_names), active_stop, active_entry, min_sl)
            tip_s1 := f_ats_level_name(active_stop, cand, cand_names)
            if tp1_hit
                // rev12: trailing SL1 is drawn as steps from this bar on -- the earlier SL1 line and the risk box keep their level
                nm_s1 := na(trail) ? "BE" : "Trail"
                line.set_extend(stop_line, extend.none)
                line.set_x2(stop_line, bar_index)
                // rev19: trail steps drawn solid, 2 px, strong red so they stand out on the green shading
                array.push(all_l, line.new(bar_index, old_stop, bar_index, active_stop, color=#D50000, width=2))
                array.push(id_l, sid)
                stop_line := line.new(bar_index, active_stop, bar_index, active_stop, color=#D50000, width=2, extend=extend.right)
                array.push(all_l, stop_line)
                array.push(id_l, sid)
                // rev16: shade Entry..trailed SL1 per step -- reward colour once SL1 is past Entry (profit locked), risk colour before
                if not na(trail_box)
                    box.set_extend(trail_box, extend.none)
                    box.set_right(trail_box, bar_index)
                bool locked = active_long ? active_stop >= active_entry : active_stop <= active_entry
                trail_box := box.new(bar_index, math.max(active_entry, active_stop), bar_index, math.min(active_entry, active_stop), border_color=color.new(locked ? #22C55E : #EF4444, 60), bgcolor=locked ? reward_col : risk_col, extend=extend.right)
                array.push(locked ? sub_boxes : sub_boxes_r, trail_box)
                array.push(all_b, trail_box)
                array.push(id_b, sid)
                label.set_xy(stop_lbl, bar_index, active_stop)
                label.set_text(stop_lbl, (na(trail) ? "SL1 BE " : "SL1 trail ") + str.tostring(active_stop, "#.##"))
            else
                box.set_top(risk_box, math.max(active_entry, active_stop))
                box.set_bottom(risk_box, math.min(active_entry, active_stop))
                line.set_y1(stop_line, active_stop)
                line.set_y2(stop_line, active_stop)
                label.set_xy(stop_lbl, active_bar, active_stop)
                label.set_text(stop_lbl, "SL1 " + str.tostring(active_stop, "#.##"))
        if tp2_moved
            active_target2 := new_target2
            nm_t2 := f_ats_level_name_top(active_target2, cand, cand_names)
            tip_t2 := f_ats_level_name(active_target2, cand, cand_names)
        if sl2_moved
            active_stop2 := new_stop2
            nm_s2 := f_ats_min_sl_name(f_ats_level_name_top(active_stop2, cand, cand_names), active_stop2, active_entry, min_sl)
            tip_s2 := f_ats_level_name(active_stop2, cand, cand_names)
        if (tp1_moved or tp2_moved) and not na(reward_box2)
            box.set_top(reward_box2, math.max(active_target, active_target2))
            box.set_bottom(reward_box2, math.min(active_target, active_target2))
            line.set_y1(target2_line, active_target2)
            line.set_y2(target2_line, active_target2)
            label.set_xy(target2_lbl, active_bar, active_target2)
            label.set_text(target2_lbl, "TP2 " + str.tostring(active_target2, "#.##"))
        if (sl1_moved and not tp1_hit or sl2_moved) and not na(risk_box2)
            box.set_top(risk_box2, math.max(active_stop, active_stop2))
            box.set_bottom(risk_box2, math.min(active_stop, active_stop2))
            line.set_y1(stop2_line, active_stop2)
            line.set_y2(stop2_line, active_stop2)
            label.set_xy(stop2_lbl, active_bar, active_stop2)
            label.set_text(stop2_lbl, "SL2 " + str.tostring(active_stop2, "#.##"))
        bool breach = sl1_hit
        // rev37: tiny letter S = SL1 before TP1, TR = trail after TP1, BE = breakeven after TP1
        // rev26: SL exit marker (like "80% @ TP1"): "SL1 -4.3" / "BE 0" / "Trail +5.1" at the stop price, red = loss, green = profit
        if sl_lbl and sl1_hit
            float xr = (active_long ? 1 : -1) * (active_stop - active_entry)
            string xt = (tp1_hit ? (xr > 0.0001 ? "Trail " : "BE ") : "SL1 ") + (xr > 0 ? "+" : "") + str.tostring(xr, "#.##")
            // rev28: symbol offset past the candle on the SL side + dotted connector back to the exit price
            float sy = ex_tiny ? (active_long ? math.min(low, active_stop) - xo : math.max(high, active_stop) + xo) : active_stop
            if ex_tiny
                array.push(all_l, line.new(bar_index, active_stop, bar_index, sy, color=xr > 0.0001 ? #16A34A : #DC2626, style=line.style_dashed, width=2))
                array.push(id_l, sid)
            array.push(all_lb, label.new(bar_index, sy, ex_tiny ? (tp1_hit ? (math.abs(xr) <= 0.0001 ? "BE" : "TR") : "S") : xt, color=color.new(xr > 0.0001 ? #16A34A : #DC2626, ex_tiny ? 0 : ex_tr), textcolor=color.white, style=ex_tiny ? label.style_label_center : active_long ? label.style_label_up : label.style_label_down, size=size.small, tooltip=xt + " -- setup exit @ " + str.tostring(active_stop, "#.##") + " (pts on the runner)" + f_ats_tx(tmx, active_stop) + (tp1_hit ? "" : f_ats_res(false, active_long, active_stop, active_entry, active_target, part, active_target2)) + f_ats_trail_why(tp1_hit, active_long, active_stop, active_entry, active_target, tr_ref, tr_d, tr_tm, trail, trail_m, part, be)))
            array.push(id_lb, sid)
        if not breach and not na(active_target2)
            breach := active_target2 > active_entry ? high >= active_target2 : low <= active_target2
        if not breach and not na(active_stop2)
            breach := active_stop2 < active_entry ? low <= active_stop2 : high >= active_stop2
        if sl_lbl and breach and not sl1_hit
            bool t2 = not na(active_target2) and (active_target2 > active_entry ? high >= active_target2 : low <= active_target2)
            [xl, xb] = f_ats_xm(active_long, t2 ? active_target2 : active_stop2, active_entry, t2 ? "TP2" : "SL2", ex_tiny, ex_tr, xo, tmx, f_ats_res(tp1_hit, active_long, t2 ? active_target2 : active_stop2, active_entry, active_target, part, active_target2))
            if not na(xl)
                array.push(all_l, xl)
                array.push(id_l, sid)
            array.push(all_lb, xb)
            array.push(id_lb, sid)
        if breach
            if not tp1_hit // rev19: a trailing setup's TP1 box already ended at TP1; the running-profit box ends instead
                box.set_extend(reward_box, extend.none)
                box.set_right(reward_box, bar_index)
            if not na(run_box)
                box.set_extend(run_box, extend.none)
                box.set_right(run_box, bar_index)
            if not tp1_hit // rev15: a trailing setup's risk box already ended at TP1
                box.set_extend(risk_box, extend.none)
                box.set_right(risk_box, bar_index)
            line.set_extend(entry_line, extend.none)
            line.set_x2(entry_line, bar_index)
            line.set_extend(stop_line, extend.none)
            line.set_x2(stop_line, bar_index)
            if not na(trail_box)
                box.set_extend(trail_box, extend.none)
                box.set_right(trail_box, bar_index)
            line.set_extend(target_line, extend.none)
            line.set_x2(target_line, bar_index)
            if not na(reward_box2)
                box.set_extend(reward_box2, extend.none)
                box.set_right(reward_box2, bar_index)
                line.set_extend(target2_line, extend.none)
                line.set_x2(target2_line, bar_index)
            if not na(risk_box2)
                box.set_extend(risk_box2, extend.none)
                if not tp1_hit
                    box.set_right(risk_box2, bar_index)
                line.set_extend(stop2_line, extend.none)
                line.set_x2(stop2_line, bar_index)
            f_ats_hollow(array.from(reward_box, reward_box2), reward_col, done_op) // rev22/23: finished setup -> outline + light fill
            f_ats_hollow(array.from(risk_box, risk_box2), risk_col, done_op)
            f_ats_hollow(sub_boxes, reward_col, done_op)
            f_ats_hollow(sub_boxes_r, risk_col, done_op)
            ats_frozen := true
    // v73: small "Trade Levels" box -- TP2/TP1/Entry/Price/SL1/SL2 with points from live price, per direct
    // request. Reads this function's own live active_* state, so it always matches the drawn setup.
    // Rows run top-to-bottom in chart order (targets on top for a long, stops on top for a short).
    var table lvl_tbl = na
    var string lvl_pos_last = ""
    if not na(lvl_tbl) and (not show_tbl or lvl_pos_last != tbl_pos)
        table.delete(lvl_tbl)
        lvl_tbl := na
    if show_tbl and barstate.islast
        if na(lvl_tbl)
            lvl_tbl := table.new(f_status_pos(tbl_pos), 4, 12, bgcolor=color.new(#020617, 0), border_color=color.new(#334155, 0), border_width=1, frame_color=color.new(#475569, 0), frame_width=1)
            table.merge_cells(lvl_tbl, 0, 11, 2, 11) // rev20: last column = time the setup was drawn
            lvl_pos_last := tbl_pos
        string tsz = f_table_text_size(tbl_size)
        color hdr = color.new(#0C1222, 0)
        table.cell(lvl_tbl, 0, 0, "Level", bgcolor=hdr, text_color=color.white, text_size=tsz)
        table.cell(lvl_tbl, 1, 0, "Price", bgcolor=hdr, text_color=color.white, text_size=tsz)
        table.cell(lvl_tbl, 2, 0, "Pts", bgcolor=hdr, text_color=color.white, text_size=tsz)
        table.cell(lvl_tbl, 3, 0, "Pivot", bgcolor=hdr, text_color=color.white, text_size=tsz)
        // v83: row order follows the CONFIRMED HTF CBC direction (falls back to the setup's own direction
        // when that is unknown or ambiguous). Once the setup has ended (frozen) or none exists, the Price/
        // Pts/Pivot cells are left EMPTY; only the live Price row keeps showing the current close.
        bool is_short = htf_dir_bear_now and not htf_dir_bull_now ? true : htf_dir_bull_now and not htf_dir_bear_now ? false : not na(active_entry) and not active_long
        bool live_setup = not na(active_entry) and not ats_frozen
        // v99: 4 target rows and 4 stop rows -- the active TP1/TP2 and SL1/SL2 plus the other method's (info,
        // darker colour), each group sorted by distance from Entry so the table reads in price order. Pivot
        // levels are named TP1/TP2/SL1/SL2, ATR levels TP1/TP2/SL1/SL2 ATR.
        float[] lv = array.from(active_target, active_target2, array.get(altv, 2), array.get(altv, 3), active_stop, active_stop2, array.get(altv, 0), array.get(altv, 1))
        float[] ld = array.new_float(8, 0.0)
        for j = 0 to 7
            float vj = array.get(lv, j)
            array.set(ld, j, live_setup and not na(vj) ? math.abs(vj - active_entry) + (j % 4) * 1e-9 : 1e9 + j % 4)
        int[] tso = array.sort_indices(array.slice(ld, 0, 4), order.ascending)
        int[] sso = array.sort_indices(array.slice(ld, 4, 8), order.ascending)
        for r = 0 to 9
            int k = is_short ? 9 - r : r
            // k 0..3 = targets farthest first, 4 = Entry, 5 = Price, 6..9 = stops nearest first
            int j = k <= 3 ? array.get(tso, math.max(3 - k, 0)) : k >= 6 ? 4 + array.get(sso, math.max(k - 6, 0)) : -1
            int jj = math.max(j, 0)
            bool alt = j >= 0 and j % 4 >= 2
            bool is_tp = j >= 0 and j < 4
            bool is_atr = j >= 0 and alt != (is_tp ? atr_tp_on : atr_on)
            string nm = k == 4 ? "Entry" : k == 5 ? "Price" : (is_tp ? "TP" : "SL") + str.tostring(j % 2 + 1) + (is_atr ? " ATR" : "")
            float v = k == 5 ? close : not live_setup ? na : k == 4 ? active_entry : array.get(lv, jj)
            color bg = k == 4 ? color.new(#334155, 0) : k == 5 ? color.new(#B45309, 0) : is_tp ? (alt ? color.new(#14532D, 0) : color.new(#15803D, 0)) : alt ? color.new(#7F1D1D, 0) : color.new(#B91C1C, 0)
            float d = na(v) ? na : v - close
            string dtxt = na(v) or k == 5 ? "" : (d >= 0 ? "+" : "") + str.tostring(d, "#.##")
            table.cell(lvl_tbl, 0, r + 1, nm, bgcolor=bg, text_color=color.white, text_size=tsz, text_halign=text.align_left)
            table.cell(lvl_tbl, 1, r + 1, na(v) ? (live_setup ? "-" : "") : str.tostring(v, "#.##"), bgcolor=bg, text_color=color.white, text_size=tsz, text_halign=text.align_right)
            table.cell(lvl_tbl, 2, r + 1, dtxt, bgcolor=bg, text_color=color.white, text_size=tsz, text_halign=text.align_right)
            string pnm0 = j == 0 ? nm_t1 : j == 1 ? nm_t2 : j == 4 ? nm_s1 : j == 5 ? nm_s2 : is_atr or j < 0 ? "" : is_tp ? f_ats_level_name_top(v, cand, cand_names) : f_ats_min_sl_name(f_ats_level_name_top(v, cand, cand_names), v, active_entry, min_sl)
            float am_r = is_atr ? array.get(altv, (is_tp ? 6 : 4) + j % 2) : 0.0
            float atr_r = array.size(altv) > 8 ? array.get(altv, 8) : na
            string rn = j >= 4 and array.size(altv) > 12 ? f_ats_raw_nm(array.get(altv, 5 + j), v, active_entry, min_sl, cand, cand_names, am_r, atr_r) : ""
            string pnm = rn != "" ? "Min " + str.tostring(min_sl) + " (" + rn + ")" : is_atr and pnm0 == "" ? f_ats_atr_txt(am_r, atr_r) : pnm0
            string ptip = j == 0 ? tip_t1 : j == 1 ? tip_t2 : j == 4 ? tip_s1 : j == 5 ? tip_s2 : ""
            bool dir_cell = k == 4 and live_setup
            table.cell(lvl_tbl, 3, r + 1, dir_cell ? (active_long ? "Long" : "Short") : k == 4 or k == 5 or not live_setup ? "" : pnm == "" or na(v) ? "-" : pnm, bgcolor=dir_cell ? (active_long ? color.new(#16A34A, 0) : color.new(#DC2626, 0)) : bg, text_color=color.white, text_size=tsz, text_halign=text.align_left, tooltip=not live_setup ? "" : alt ? "Info only: the other method (Trade Setup > \"SL/TP method: 3m ATR\"). Not the active level." : str.contains(ptip, "/") ? str.replace_all(ptip, "/", " / ") : "")
        // v85: last row -- HTF CBC last flip (direction, time, HTF candles ago), always shown.
        if show_tbl and barstate.islast and not na(lvl_tbl)
            table.cell(lvl_tbl, 0, 11, flip_txt, bgcolor=flip_txt == "" ? hdr : flip_long ? color.new(#16A34A, 0) : color.new(#DC2626, 0), text_color=color.white, text_size=tsz, text_halign=text.align_left)
            table.cell(lvl_tbl, 3, 11, na(active_t) ? "" : "Setup " + str.format_time(active_t, "HH:mm", "America/New_York"), bgcolor=active_long ? color.new(#16A34A, 0) : color.new(#DC2626, 0), text_color=color.white, text_size=tsz, text_halign=text.align_right, tooltip="Time (ET) the current setup was drawn")
    // v94: mini reward:risk table, 2 columns, no header: TP2/SL1, TP1/SL1, TP1/SL2, TP2/SL2, measured from
    // Entry. v95: blank once the setup has ended, same as the Trade Levels table.
    var table rr_tbl = na
    var string rr_pos_last = ""
    if not na(rr_tbl) and (not show_tbl or rr_pos_last != rr_pos)
        table.delete(rr_tbl)
        rr_tbl := na
    if show_tbl and barstate.islast
        if na(rr_tbl)
            rr_tbl := table.new(f_status_pos(rr_pos), 2, 4, bgcolor=color.new(#020617, 0), border_color=color.new(#334155, 0), border_width=1, frame_color=color.new(#475569, 0), frame_width=1)
            rr_pos_last := rr_pos
        string rsz = f_table_text_size(tbl_size)
        for rr = 0 to 3
            float rtp = rr == 0 or rr == 3 ? active_target2 : active_target
            float rsl = rr <= 1 ? active_stop : active_stop2
            string rnm = rr == 0 ? "TP2/SL1" : rr == 1 ? "TP1/SL1" : rr == 2 ? "TP1/SL2" : "TP2/SL2"
            table.cell(rr_tbl, 0, rr, rnm, bgcolor=color.new(#15803D, 0), text_color=color.white, text_size=rsz, text_halign=text.align_left, tooltip="Reward : risk from Entry = distance to the TP / distance to the SL, in the trade direction.")
            table.cell(rr_tbl, 1, rr, na(active_entry) or ats_frozen ? "" : f_ats_rr(active_entry, rtp, rsl, active_long), bgcolor=color.new(#1E293B, 0), text_color=color.white, text_size=rsz, text_halign=text.align_right)
    // v84: returns the active setup's live state so the main script can put it in alerts:
    // [entry, TP1, SL1, TP2, SL2, long(1/0), live(1 = active and not frozen, else 0)]
    array.from(active_entry, active_target, active_stop, active_target2, active_stop2, active_long ? 1.0 : 0.0, not na(active_entry) and not ats_frozen ? 1.0 : 0.0)

export f_ats_draw_handles(float tp1_h, float sl1_h, float tp2_h, float sl2_h, bool show_tp2, bool show_sl2) =>
    var label tp1_lbl = na
    var label sl1_lbl = na
    var label tp2_lbl = na
    var label sl2_lbl = na
    // v64: each handle's own on-chart label is now gated on f_ats_handle_sane(handle, close) as well as
    // != 0.0 -- `close` is a Pine built-in, read directly here with no new parameter needed (same
    // convention already used throughout this file). An insane handle (e.g. a stray literal price of 1
    // on an instrument trading near 7800) is treated exactly like the inactive 0.0 default: no label is
    // drawn, so it can no longer force the chart's autoscale to crush the real price range flat.
    // v67: this same gate is what keeps a STEP-MODE handle (e.g. 2 or -1, per f_ats_handle_is_step()
    // in f_ats_handle_snap above) from ever reaching label.new()/label.set_xy() here -- a small whole
    // number always fails f_ats_handle_sane() against a real instrument price, so it's silently treated
    // as "no identifier label" (nothing to drag at that value anyway), while f_ats_handle_snap() still
    // independently recognizes and resolves it to a real pivot price. No code change needed for this.
    bool tp1_active = tp1_h != 0.0 and f_ats_handle_sane(tp1_h, close)
    bool sl1_active = sl1_h != 0.0 and f_ats_handle_sane(sl1_h, close)
    bool tp2_active = show_tp2 and tp2_h != 0.0 and f_ats_handle_sane(tp2_h, close)
    bool sl2_active = show_sl2 and sl2_h != 0.0 and f_ats_handle_sane(sl2_h, close)
    if tp1_active
        if na(tp1_lbl)
            tp1_lbl := label.new(bar_index, tp1_h, "◆ TP1 HANDLE " + str.tostring(tp1_h, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#22D3EE, 0), style=label.style_label_right, size=size.small)
        else
            label.set_xy(tp1_lbl, bar_index, tp1_h)
            label.set_text(tp1_lbl, "◆ TP1 HANDLE " + str.tostring(tp1_h, "#.##"))
    else if not na(tp1_lbl)
        label.delete(tp1_lbl)
        tp1_lbl := na
    if sl1_active
        if na(sl1_lbl)
            sl1_lbl := label.new(bar_index, sl1_h, "◆ SL1 HANDLE " + str.tostring(sl1_h, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#FB923C, 0), style=label.style_label_right, size=size.small)
        else
            label.set_xy(sl1_lbl, bar_index, sl1_h)
            label.set_text(sl1_lbl, "◆ SL1 HANDLE " + str.tostring(sl1_h, "#.##"))
    else if not na(sl1_lbl)
        label.delete(sl1_lbl)
        sl1_lbl := na
    if tp2_active
        if na(tp2_lbl)
            tp2_lbl := label.new(bar_index, tp2_h, "◆ TP2 HANDLE " + str.tostring(tp2_h, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#C084FC, 0), style=label.style_label_right, size=size.small)
        else
            label.set_xy(tp2_lbl, bar_index, tp2_h)
            label.set_text(tp2_lbl, "◆ TP2 HANDLE " + str.tostring(tp2_h, "#.##"))
    else if not na(tp2_lbl)
        label.delete(tp2_lbl)
        tp2_lbl := na
    if sl2_active
        if na(sl2_lbl)
            sl2_lbl := label.new(bar_index, sl2_h, "◆ SL2 HANDLE " + str.tostring(sl2_h, "#.##"), color=color.new(color.white, 100), textcolor=color.new(#FACC15, 0), style=label.style_label_right, size=size.small)
        else
            label.set_xy(sl2_lbl, bar_index, sl2_h)
            label.set_text(sl2_lbl, "◆ SL2 HANDLE " + str.tostring(sl2_h, "#.##"))
    else if not na(sl2_lbl)
        label.delete(sl2_lbl)
        sl2_lbl := na
    true


// v43: f_render_status_table() moved from the main script (CE10117 relief round 5) -- the single
// largest remaining local function, ~175 lines / 132 external reads, none of it CBC-internal state
// beyond plain parameters. Keeps its own var table/string/bool state internally (same pattern as
// f_render_pivot_table/f_render_fib_zone_box/f_ats_draw_setup) so it needs no tuple return.
export f_render_status_table(array<string> field_order, float ORHigh_AS, float ORHigh_LN, float ORHigh_NY, float ORLow_AS, float ORLow_LN, float ORLow_NY, float PMH, float PML, float YDH, float YDL, int as_or_open, int ln_or_open, int ny_or_open, float brsg_zone_bot, float brsg_zone_top, bool cbc, string chart_tf_disp_val, string htf_tf_disp_val, string mtf_tf_disp_val, color col_orb_as_lbl, color col_orb_ln_lbl, color col_orb_ny_lbl, int confluence_alert_threshold, int confluence_max_score, int confluence_score, bool confluence_same_score_diff_mask, bool eff_show_chart_info_tbl, bool eff_show_fld_buysell, bool eff_show_fld_conf_summary, bool eff_show_fld_confluence, bool eff_show_fld_flip_level, bool eff_show_fld_last_flip, bool eff_show_fld_next_levels, bool eff_show_fld_stop, bool eff_show_htf_pivots_tbl, bool eff_show_ltf_pivots_tbl, bool eff_show_mtf_pivots_tbl, float ema200, bool ema_bullish, float fib_50, float fib_618, bool fib_price_in_zone, bool fib_valid, float h_last_hi, float h_last_lo, float l_last_hi, float l_last_lo, float m_last_hi, float m_last_lo, int htf_bars_since_flip, int ltf_bars_since_flip, int mtf_bars_since_flip, bool htf_cbc, bool mtf_cbc, float htf_cbc_labels_f, float mtf_cbc_labels_f, bool htf_ema_bullish, bool mtf_ema_bullish, bool htf_enabled, bool mtf_enabled, float htf_flip_price, float ltf_flip_price, float mtf_flip_price, float htf_fvg_bot, float htf_fvg_top, bool htf_fvg_exists, bool htf_in_flip_fvg, string htf_hi_struct, string htf_lo_struct, string ltf_hi_struct, string ltf_lo_struct, string mtf_hi_struct, string mtf_lo_struct, bool htf_last_flip_bull, bool ltf_last_flip_bull, bool mtf_last_flip_bull, int htf_last_flip_t, int ltf_last_flip_t, int mtf_last_flip_t, string htf_stop_method, string htf_timeframe, string mtf_timeframe, float htf_trail_stop, bool ltf_cbc_confirmed, array<string> nl_label, bool or_asian, bool or_london, bool or_ny, float piv_pp, float piv_r1, float piv_r2, float piv_r3, float piv_s1, float piv_s2, float piv_s3, bool show_any_or, bool show_fld_cbc, bool show_fld_ema200, bool show_fld_ema_cloud, bool show_fld_fib_zone, bool show_fld_market, bool show_fld_opening_range, bool show_fld_price, bool show_fld_structure, bool show_fld_vwap, bool show_htf_in_tables, bool show_ltf_in_tables, bool show_mtf_in_tables, bool show_mtf_cbc, bool show_mtf_cloud, bool show_mtf_fliplevel, bool show_mtf_lastflip, bool show_mtf_structure, bool show_status_table, color st_bear, color st_bull, color st_highlight, color st_neutral, string status_field_set, int status_table_header_newlines, string status_table_position, string status_table_text_size, bool status_tbl_collapsed, color tbl_border, color tbl_frame, color tbl_header_bg, color tbl_label_bg, color txt_head, color txt_label, color txt_on, float vwap_value) =>
    var table status_tbl = na
    var string status_tbl_pos_last = ""
    var bool status_tbl_collapsed_last = false
    var string status_field_set_last = ""
    if not show_status_table
        table.delete(status_tbl)
        status_tbl := na
        status_tbl_pos_last := ""
    else
        if not na(status_tbl) and (status_tbl_pos_last != status_table_position or status_tbl_collapsed_last != status_tbl_collapsed or status_field_set_last != status_field_set)
            table.delete(status_tbl)
            status_tbl := na
        if na(status_tbl)
            int fld_grp = (show_ltf_in_tables ? 1 : 0) + (show_htf_in_tables ? 1 : 0) + (show_mtf_in_tables ? 1 : 0)
            status_tbl := table.new(f_status_pos(status_table_position), 2, status_tbl_collapsed ? 1 : math.max(1, (show_fld_market ? 1 : 0) + (show_fld_price ? 1 : 0) + (show_fld_cbc ? fld_grp : 0) + (show_fld_opening_range ? 1 : 0) + (show_fld_ema_cloud ? fld_grp : 0) + (show_fld_vwap ? 1 : 0) + (show_fld_ema200 ? 1 : 0) + (show_fld_structure ? fld_grp : 0) + (eff_show_fld_last_flip ? fld_grp : 0) + (eff_show_fld_stop ? 1 : 0) + (eff_show_fld_buysell ? 1 : 0) + (eff_show_chart_info_tbl ? 1 : 0) + (eff_show_ltf_pivots_tbl ? 1 : 0) + (eff_show_htf_pivots_tbl ? 1 : 0) + (eff_show_mtf_pivots_tbl ? 1 : 0) + (eff_show_fld_flip_level ? fld_grp : 0) + (eff_show_fld_confluence ? 1 : 0) + (show_fld_fib_zone ? 1 : 0) + (eff_show_fld_conf_summary ? 1 : 0) + (eff_show_fld_next_levels ? 2 : 0)), bgcolor=color.new(#020617, 0), border_color=tbl_border, border_width=1, frame_color=tbl_frame, frame_width=2)
            if status_tbl_collapsed
                table.merge_cells(status_tbl, 0, 0, 1, 0)
            status_tbl_collapsed_last := status_tbl_collapsed
            status_tbl_pos_last := status_table_position
            status_field_set_last := status_field_set
        [nl_target_txt, nl_stop_txt] = f_next_two_levels((array.from(YDH, YDL, PMH, PML, ORHigh_NY, ORLow_NY, ORHigh_LN, ORLow_LN, ORHigh_AS, ORLow_AS, l_last_hi, l_last_lo, h_last_hi, h_last_lo, m_last_hi, m_last_lo, ema200, piv_r3, piv_r2, piv_r1, piv_pp, piv_s1, piv_s2, piv_s3)), nl_label, cbc, close)
        cloud_bull = ema_bullish
        // v7.28: vwap_bull/ema200_bull now mean "favorable for the live CBC direction" (cbc ? above :
        // below) instead of a raw, direction-blind "is price above" check -- per direct request
        // ("all the points are positive they should be in relation to the direction of cbc"), made
        // against a screenshot of a bearish setup where these rows still read "Above" with a positive
        // number, which read as bullish-leaning even though the trade context was short.
        vwap_bull = not na(vwap_value) and (cbc ? close > vwap_value : close < vwap_value)
        ema200_bull = not na(ema200) and (cbc ? close > ema200 : close < ema200)
        string mkt_tbl = f_market_session_et()
        float or_f_hi = mkt_tbl == "Asian" ? ORHigh_AS : mkt_tbl == "London" ? ORHigh_LN : ORHigh_NY
        float or_f_lo = mkt_tbl == "Asian" ? ORLow_AS : mkt_tbl == "London" ? ORLow_LN : ORLow_NY
        or_right = st_neutral
        or_msg = "—"
        if not show_any_or
            or_msg := "Off"
        else if not ((mkt_tbl == "Asian" and or_asian) or (mkt_tbl == "London" and or_london) or (mkt_tbl == "New York" and or_ny))
            or_msg := "—"
        else if time < (mkt_tbl == "Asian" ? as_or_open : mkt_tbl == "London" ? ln_or_open : ny_or_open)
            or_msg := "Before open"
        else if na(or_f_hi) or na(or_f_lo)
            or_msg := "Pending"
        else if close > or_f_hi
            or_msg := str.tostring(or_f_hi, "#.##") + "  " + ((close - or_f_hi) >= 0 ? "+" : "") + str.tostring(close - or_f_hi, "#.#") + " pts"
            or_right := st_bull
        else if close < or_f_lo
            or_msg := str.tostring(or_f_lo, "#.##") + "  " + ((close - or_f_lo) >= 0 ? "+" : "") + str.tostring(close - or_f_lo, "#.#") + " pts"
            or_right := st_bear
        else
            or_msg := "In Range"
            or_right := color.new(#000000, 10)
        // v7.28: v_diff/e200_diff are now SIGNED relative to the live CBC direction (positive =
        // favorable, negative = against), not a raw close-vwap/close-ema200 difference. Since
        // vwap_bull/ema200_bull (above) already mean "favorable," they now agree with the sign of
        // v_diff/e200_diff by construction (favorable <=> diff >= 0) -- "Favorable"/"Against" and the
        // +/- sign can never disagree.
        float v_diff = not na(vwap_value) ? (cbc ? close - vwap_value : vwap_value - close) : na
        float e200_diff = not na(ema200) ? (cbc ? close - ema200 : ema200 - close) : na
        tbl_txt_sz = f_table_text_size(status_table_text_size)
        if status_tbl_collapsed
            table.cell(status_tbl, 0, 0, (str.repeat("\n", status_table_header_newlines) + "MapleStax CBC  ·  " + syminfo.ticker), bgcolor=tbl_header_bg, text_color=txt_head, text_size=tbl_txt_sz, text_halign=text.align_center)
        int r = 0
        array<int> tf_order = f_ltf_htf_mtf_order(htf_timeframe, mtf_timeframe)
        for i = 0 to (status_tbl_collapsed ? -1 : array.size(field_order) - 1)
            string fid = array.get(field_order, i)
            if fid == "market" and show_fld_market
                r := f_add_status_row(status_tbl, r, "Market", "Which trading session is currently", mkt_tbl, mkt_tbl == "Asian" ? col_orb_as_lbl : mkt_tbl == "London" ? col_orb_ln_lbl : color.new(col_orb_ny_lbl, 35), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            // v4.61: Price — new Essential-level row per follow-up ("add price to the essential below
            // market"), default order slot 2 so it sits directly under Market. Colored by simple tick
            // direction vs the prior bar's close (green up, red down, gray unchanged) — same st_bull/
            // st_bear/st_neutral used everywhere else in this table, not tied to CBC/HTF direction.
            else if fid == "price" and show_fld_price
                r := f_add_status_row(status_tbl, r, "Price", "Current close. Green/red on an up/down tick vs the prior bar's close, gray when unchanged.", str.tostring(close, "#.##"), close > close[1] ? st_bull : close < close[1] ? st_bear : st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "cbc" and show_fld_cbc
                r := f_add_tf_row(status_tbl, r, "CBC",
                                   ((ltf_cbc_confirmed ? "Bullish" : "Bearish") + (ltf_cbc_confirmed != cbc ? "  ⚠ live " + (cbc ? "Bull" : "Bear") : "")), (cbc ? st_bull : st_bear),
                                   (not htf_enabled ? "Off" : na(htf_cbc_labels_f) ? "—" : (htf_cbc_labels_f == 1.0 ? "Bullish" : "Bearish") + (htf_enabled and not na(htf_cbc_labels_f) and ((htf_cbc_labels_f == 1.0) != htf_cbc) ? "  ⚠ live " + (htf_cbc ? "Bull" : "Bear") : "")), (not htf_enabled ? st_neutral : na(htf_cbc_labels_f) ? st_neutral : (htf_cbc_labels_f == 1.0 ? st_bull : st_bear)),
                                   not mtf_enabled ? "Off" : na(mtf_cbc_labels_f) ? "—" : (mtf_cbc_labels_f == 1.0 ? "Bullish" : "Bearish"), not mtf_enabled ? st_neutral : na(mtf_cbc_labels_f) ? st_neutral : (mtf_cbc_labels_f == 1.0 ? st_bull : st_bear),
                                   show_ltf_in_tables, show_htf_in_tables, show_mtf_in_tables, show_mtf_cbc,
                                   chart_tf_disp_val, htf_tf_disp_val, mtf_tf_disp_val,
                                   color.new(#0A1628, 0), color.new(#93C5FD, 0), txt_on, tbl_txt_sz, tf_order,
                                   "Close-Break-Confirmation direction on the", "Same CBC logic, computed on the HTF.", "Same Close-Break-Confirmation logic as")
            else if fid == "or" and show_fld_opening_range
                r := f_add_status_row(status_tbl, r, "Opening range", "Price vs. the current session's Opening", or_msg, or_right, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "cloud" and show_fld_ema_cloud
                r := f_add_tf_row(status_tbl, r, "EMA cloud",
                                   (cloud_bull ? "Bullish" : "Bearish"), (cloud_bull ? st_bull : st_bear),
                                   htf_ema_bullish ? "Bullish" : "Bearish", htf_ema_bullish ? st_bull : st_bear,
                                   mtf_ema_bullish ? "Bullish" : "Bearish", mtf_ema_bullish ? st_bull : st_bear,
                                   show_ltf_in_tables, show_htf_in_tables, show_mtf_in_tables, show_mtf_cloud,
                                   chart_tf_disp_val, htf_tf_disp_val, mtf_tf_disp_val,
                                   tbl_label_bg, txt_label, txt_on, tbl_txt_sz, tf_order,
                                   "Direction of the EMA9/EMA20 cloud on the", "Same EMA9/EMA20 cloud logic as the LTF", "Same EMA9/EMA20 cloud logic as the")
            else if fid == "vwap" and show_fld_vwap
                r := f_add_status_row(status_tbl, r, "VWAP", "Whether price is currently Favorable or Against the live CBC direction, relative to", (not na(vwap_value) ? (vwap_bull ? "Favorable " : "Against ") + (v_diff >= 0 ? "+" : "") + str.tostring(v_diff, "#.#") : "—"), (not na(vwap_value) ? (vwap_bull ? st_bull : st_bear) : st_neutral), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "ema200" and show_fld_ema200
                r := f_add_status_row(status_tbl, r, "EMA 200", "Whether price is currently Favorable or Against the live CBC direction, relative to", (not na(ema200) ? (ema200_bull ? "Favorable " : "Against ") + (e200_diff >= 0 ? "+" : "") + str.tostring(e200_diff, "#.#") : "—"), (not na(ema200) ? (ema200_bull ? st_bull : st_bear) : st_neutral), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            // v4.54: Fib Zone — Essential-level row (own checkbox, not Full-gated, per follow-up),
            // reusing fib_50/fib_618/fib_valid already computed above alongside the Fib confluence
            // factor. v4.61 changed the green/neutral rule to fib_price_in_zone (see below) — no
            // longer tied to the Confluence Score's recency window.
            else if fid == "fibzone" and show_fld_fib_zone
                // v4.61: dropped the "50%"/"61.8%" prefixes and tightened to 1 decimal per follow-up
                // ("shorten to one decimal and get rid of 50 and 61.8 before the values"); color now
                // driven by fib_price_in_zone (simple geometric in-zone check, no recency gate) instead
                // of cf_f10_fib_touch, per follow-up ("should change to green if price is in fib zone").
                r := f_add_status_row(status_tbl, r, "Fib Zone (" + htf_tf_disp_val + ")", "50%-61.8% retracement zone of the last confirmed HTF swing high/low (same swing Liquidity Sweep uses). Green + \"IN\" whenever price is currently between the two levels (unlike the Confluence Score's own Fib factor, this row's color ignores the recency window).", not fib_valid ? "—" : str.tostring(fib_50, "#.#") + " / " + str.tostring(fib_618, "#.#") + (fib_price_in_zone ? "  IN" : ""), fib_price_in_zone ? st_bull : st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "structure" and show_fld_structure
                r := f_add_tf_row(status_tbl, r, "Structure",
                                   f_struct_abbrev(ltf_hi_struct) + " / " + f_struct_abbrev(ltf_lo_struct), (ltf_hi_struct == "Higher High" and ltf_lo_struct == "Higher Low") ? st_bull : (ltf_hi_struct == "Lower High" and ltf_lo_struct == "Lower Low") ? st_bear : st_neutral,
                                   f_struct_abbrev(htf_hi_struct) + " / " + f_struct_abbrev(htf_lo_struct), (htf_hi_struct == "Higher High" and htf_lo_struct == "Higher Low") ? st_bull : (htf_hi_struct == "Lower High" and htf_lo_struct == "Lower Low") ? st_bear : st_neutral,
                                   f_struct_abbrev(mtf_hi_struct) + " / " + f_struct_abbrev(mtf_lo_struct), (mtf_hi_struct == "Higher High" and mtf_lo_struct == "Higher Low") ? st_bull : (mtf_hi_struct == "Lower High" and mtf_lo_struct == "Lower Low") ? st_bear : st_neutral,
                                   show_ltf_in_tables, show_htf_in_tables, show_mtf_in_tables, show_mtf_structure,
                                   chart_tf_disp_val, htf_tf_disp_val, mtf_tf_disp_val,
                                   tbl_label_bg, txt_label, txt_on, tbl_txt_sz, tf_order,
                                   "Market structure on the chart's own", "Same Higher High/Lower High/Higher", "Same Higher High/Lower High/Higher")
            // v7.17: compact Confluence Summary row, grouped with Structure (item 2 / Confluences).
            // Same underlying confluence_score/confluence_max_score/confluence_alert_threshold as the
            // full "Confluence Score" row below (item 6 group) — this is just a shorter, earlier-
            // placed duplicate for quick reference while checking item 2, not a separate calculation.
            else if fid == "confsummary" and eff_show_fld_conf_summary
                r := f_add_status_row(status_tbl, r, "Confluence Summary", "Quick-reference copy of the Confluence Score, grouped here with Structure for item 2 of the Pre-Trade Checklist. See the Confluence Score row (and the separate Confluence Factors table) for the full per-factor breakdown.", "S:" + str.tostring(confluence_score) + "/" + str.tostring(confluence_max_score), confluence_score >= confluence_alert_threshold ? st_bull : st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "lastflip" and eff_show_fld_last_flip
                if show_ltf_in_tables
                    r := f_add_status_row(status_tbl, r, "CBC (" + chart_tf_disp_val + ") last flip", "Direction and NY timestamp of the last", (na(ltf_last_flip_t) ? "" : (ltf_last_flip_bull ? "LONG  " : "SHORT  ")) + f_fmt_ny_time(ltf_last_flip_t) + "  #" + str.tostring(ltf_bars_since_flip), na(ltf_last_flip_t) ? st_neutral : (ltf_last_flip_bull ? st_bull : st_bear), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
                if show_htf_in_tables
                    r := f_add_status_row(status_tbl, r, "CBC (" + htf_tf_disp_val + ") last flip", "Same as the LTF last-flip row (direction,", (na(htf_last_flip_t) ? "" : (htf_last_flip_bull ? "LONG  " : "SHORT  ")) + f_fmt_ny_time(htf_last_flip_t) + "  #" + str.tostring(htf_bars_since_flip), na(htf_last_flip_t) ? st_neutral : (htf_last_flip_bull ? st_bull : st_bear), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
                if show_mtf_in_tables and show_mtf_lastflip
                    r := f_add_status_row(status_tbl, r, "CBC (" + mtf_tf_disp_val + ") last flip", "Same as the LTF/HTF last-flip rows", (na(mtf_last_flip_t) ? "" : (mtf_last_flip_bull ? "LONG  " : "SHORT  ")) + f_fmt_ny_time(mtf_last_flip_t) + "  #" + str.tostring(mtf_bars_since_flip), na(mtf_last_flip_t) ? st_neutral : (mtf_last_flip_bull ? st_bull : st_bear), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "stop" and eff_show_fld_stop
                r := f_add_status_row(status_tbl, r, "LTF Trailing Stop", "'CBC': prior closed LTF candle's low/high", na(htf_trail_stop) ? "—" : str.tostring(htf_trail_stop, "#.##") + "  " + htf_stop_method, na(htf_trail_stop) ? st_neutral : (cbc ? st_bull : st_bear), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "fliplevel" and eff_show_fld_flip_level
                if show_ltf_in_tables
                    r := f_add_status_row(status_tbl, r, "Flip Level (" + chart_tf_disp_val + ")", "The exact price that would trigger the", na(ltf_flip_price) ? "—" : str.tostring(ltf_flip_price, "#.##") + "  " + (cbc[1] ? "below" : "above"), na(ltf_flip_price) ? st_neutral : (cbc[1] ? st_bear : st_bull), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
                if show_htf_in_tables
                    r := f_add_status_row(status_tbl, r, "Flip Level (" + htf_tf_disp_val + ")", "Same as the LTF Flip Level row, computed", na(htf_flip_price) ? "—" : str.tostring(htf_flip_price, "#.##") + "  " + (htf_cbc[1] ? "below" : "above"), na(htf_flip_price) ? st_neutral : (htf_cbc[1] ? st_bear : st_bull), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
                if show_mtf_in_tables and show_mtf_fliplevel
                    r := f_add_status_row(status_tbl, r, "Flip Level (" + mtf_tf_disp_val + ")", "Same as the LTF/HTF Flip Level rows,", na(mtf_flip_price) ? "—" : str.tostring(mtf_flip_price, "#.##") + "  " + (mtf_cbc[1] ? "below" : "above"), na(mtf_flip_price) ? st_neutral : (mtf_cbc[1] ? st_bear : st_bull), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "entryzone" and eff_show_fld_buysell
                // v4.40: appended the HTF Flip FVG range (htf_fvg_top/bot, same freeze block that
                // feeds the new chart zone) plus an "IN" tag when price is currently trading back
                // inside it (htf_in_flip_fvg) — folded into this existing row rather than a new one.
                r := f_add_status_row(status_tbl, r, "Entry Zone / FVG", "BRSG retracement zone anchored to the", na(brsg_zone_top) ? "—" : (htf_last_flip_bull ? "LONG  " : "SHORT  ") + str.tostring(na(brsg_zone_top) ? na : math.min(brsg_zone_top, brsg_zone_bot), "#.##") + " – " + str.tostring(na(brsg_zone_top) ? na : math.max(brsg_zone_top, brsg_zone_bot), "#.##") + (htf_fvg_exists ? ("  |  FVG " + str.tostring(htf_fvg_bot, "#.##") + "–" + str.tostring(htf_fvg_top, "#.##") + (htf_in_flip_fvg ? " IN" : "")) : ""), na(brsg_zone_top) ? st_neutral : (htf_last_flip_bull ? st_bull : st_bear), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            // v7.17: Next Target/Stop Levels rows, grouped with Entry Zone (items 3/4). Direction
            // comes from the live LTF CBC state (cbc) via f_next_two_levels() above — targets are the
            // nearest 2 levels on the side CBC favors, stops the nearest 2 on the opposite side, each
            // shown with distance in points. Pool is 24 core static levels (see f_next_two_levels
            // comment) — Order Blocks/EQH-EQL deliberately excluded this round.
            else if fid == "next3" and eff_show_fld_next_levels
                r := f_add_status_row(status_tbl, r, "Next Target Levels", "Nearest 2 levels in the direction the live CBC currently favors (item 3 — Entry/Target), with distance in points. Pool: YDH/YDL, PMH/PML, Opening Range sessions, LTF/HTF/MTF swing pivots, EMA 200, classic Pivot Points.", nl_target_txt, cbc ? st_bull : st_bear, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "next4" and eff_show_fld_next_levels
                r := f_add_status_row(status_tbl, r, "Next Stop Levels", "Nearest 2 levels against the direction the live CBC currently favors (item 4 — Risk limit/stop structure), with distance in points. Same level pool as Next Target Levels.", nl_stop_txt, cbc ? st_bear : st_bull, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "chart" and eff_show_chart_info_tbl
                r := f_add_status_row(status_tbl, r, "Chart", "The symbol/ticker this chart is on, plus", syminfo.ticker + "  " + chart_tf_disp_val, st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "pivltf" and eff_show_ltf_pivots_tbl
                r := f_add_status_row(status_tbl, r, "Pivot (" + chart_tf_disp_val + ")", "Most recent LTF (chart-timeframe) pivot", (na(l_last_hi) and na(l_last_lo)) ? "—" : "H " + (na(l_last_hi) ? "—" : str.tostring(l_last_hi, "#.##")) + "  /  L " + (na(l_last_lo) ? "—" : str.tostring(l_last_lo, "#.##")), st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "pivhtf" and eff_show_htf_pivots_tbl
                r := f_add_status_row(status_tbl, r, "Pivot (" + htf_tf_disp_val + ")", "Most recent HTF pivot high and pivot low", (na(h_last_hi) and na(h_last_lo)) ? "—" : "H " + (na(h_last_hi) ? "—" : str.tostring(h_last_hi, "#.##")) + "  /  L " + (na(h_last_lo) ? "—" : str.tostring(h_last_lo, "#.##")), st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            else if fid == "pivmtf" and eff_show_mtf_pivots_tbl
                r := f_add_status_row(status_tbl, r, "Pivot (" + mtf_tf_disp_val + ")", "Most recent MTF pivot high and pivot low", (na(m_last_hi) and na(m_last_lo)) ? "—" : "H " + (na(m_last_hi) ? "—" : str.tostring(m_last_hi, "#.##")) + "  /  L " + (na(m_last_lo) ? "—" : str.tostring(m_last_lo, "#.##")), st_neutral, tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
            // v4.48: combined row for all Confluence Score factors — reuses
            // confluence_score/confluence_max_score/confluence_alert_threshold, already computed
            // above. v4.55: collapsed back down to ONE simple row per follow-up ("Info seems
            // redundant... distinguish the counted ones") — the packed-string breakdown (rows 1-2) and
            // the Info row are both gone. The full per-factor breakdown, now with real per-factor
            // color instead of packed text, lives in the new dedicated Confluence Factors cells table
            // (f_render_confluence_cells() below) — see confluence_use_cells_table. This row just
            // shows the number.
            else if fid == "confluence" and eff_show_fld_confluence
                // v4.101 — same gold "box" flash as f_render_confluence_cells()'s Score cell, for the
                // one bar confluence_same_score_diff_mask is true (score unchanged from the last
                // firing, but a different combination of factors produced it this time).
                r := f_add_status_row(status_tbl, r, "Confluence Score", "Live score across all enabled confluence factors. Green when at/above the alert threshold. See the separate Confluence Factors table for the per-factor breakdown.", "S:" + str.tostring(confluence_score) + "/" + str.tostring(confluence_max_score), confluence_same_score_diff_mask ? st_highlight : (confluence_score >= confluence_alert_threshold ? st_bull : st_neutral), tbl_label_bg, txt_label, txt_on, tbl_txt_sz)
    true

// v44: bug fix inside f_ats_draw_setup() (RE10056 runtime error, "Invalid value of the 'size'
// argument ('Small')") -- its label.new() call was passing the raw text_size STRING parameter
// (e.g. "Small") directly as size=, instead of routing it through f_table_text_size() to get the real
// size.* enum value first, same as every other size-taking export in this file already does. One-line
// fix: size=txt_size -> size=f_table_text_size(txt_size). Pre-existing since v7.46 (this function's
// own creation); simply never reached runtime until the main script's token count finally landed under
// budget (v7.49) and the script actually ran far enough to draw this label.

// v45: new export for the Auto Trade Setup manual Stop/Target level picker -- per direct follow-up
// ("i wanted the red box to be drawn as a trade setup take profit and stop loss ... as long as I can
// pick from the table"). Maps one of the Pivot Points table's level NAMES (as picked from a settings
// dropdown, e.g. "S2", "HTF EQH") to that level's current price -- pure switch on a string, no
// CBC-internal state, all 18 candidate values passed in as plain float parameters (same pool
// f_ats_build_candidates already draws from). "Automatic (nearest)" is handled at the main-script call
// site (na is returned there without ever reaching this function) so this function's own switch only
// needs to cover the 18 real level names, falling back to na for anything unrecognized.
export f_ats_level_by_name(string name, float r3, float r2, float r1, float pp, float s1, float s2, float s3, float ydh, float ydl, float pmh, float pml, float htfPivH, float htfPivL, float htfEqh, float htfEql, float ltfPivH, float ltfPivL, float ema200v, float vwapv) =>
    switch name
        "R3" => r3
        "R2" => r2
        "R1" => r1
        "PP" => pp
        "S1" => s1
        "S2" => s2
        "S3" => s3
        "YD-H" => ydh
        "YD-L" => ydl
        "PMH" => pmh
        "PML" => pml
        "HTF Piv-H" => htfPivH
        "HTF Piv-L" => htfPivL
        "HTF EQH" => htfEqh
        "HTF EQL" => htfEql
        "LTF Piv-H" => ltfPivH
        "LTF Piv-L" => ltfPivL
        "EMA 200" => ema200v
        "VWAP" => vwapv
        => na

// v62: f_ats_compute_trigger() -- CE10295 relief round 4. v7.83's comment-only trim did NOT clear the
// error (user-confirmed), which settles that round's open question: CE10295 counts actual top-level/
// main-body CODE, including everything nested inside a top-level `if` block -- comments never counted.
// The main script's ~50-line trigger `if` block (level-pick fallbacks, stop/target/stop2/target2 math,
// handle-snap overrides) was still sitting directly in the main body even after f_ats_draw_setup()/
// f_ats_handle_snap()/etc. were already offloaded, because an `if` block's contents are NOT a function
// body -- only wrapping the whole sequence in one function call actually shrinks main-body size, exactly
// per the compiler's own hint ("Try wrapping code in functions"). Takes the two trigger conditions, the
// cooldown flag, entry price, all 4 level-pick strings, the candidate pool, every pivot value the level
// picker needs, the flip-candle fallback prices, all 4 drag handles, and the two Show TP2/SL2 toggles;
// writes entry/stop/target/stop2/target2 directly into the caller's `out_call` float[5] array (arrays are
// Pine's only way around "exported functions can't return a tuple" -- convention #19), and returns one
// bool (whether a new setup actually fired) so the main script can still latch its own cooldown timer.
export f_ats_compute_trigger(bool trigger_long, bool trigger_short, bool cooldown_ok, float entry, string stop_pick, string target_pick, string stop2_pick, string target2_pick, float[] cand, float r3, float r2, float r1, float pp, float s1, float s2, float s3, float ydh, float ydl, float pmh, float pml, float htfPivH, float htfPivL, float htfEqh, float htfEql, float ltfPivH, float ltfPivL, float ema200v2, float vwapv2, float flip_lo, float flip_hi, float tp1_handle, float sl1_handle, float tp2_handle, float sl2_handle, bool show_tp2, bool show_sl2, float[] out_call) =>
    bool new_setup = false
    if (trigger_long or trigger_short) and cooldown_ok
        bool ats_long = trigger_long
        float stop_manual = stop_pick == "Automatic (nearest)" ? na : f_ats_level_by_name(stop_pick, r3, r2, r1, pp, s1, s2, s3, ydh, ydl, pmh, pml, htfPivH, htfPivL, htfEqh, htfEql, ltfPivH, ltfPivL, ema200v2, vwapv2)
        float target_manual = target_pick == "Automatic (nearest)" ? na : f_ats_level_by_name(target_pick, r3, r2, r1, pp, s1, s2, s3, ydh, ydl, pmh, pml, htfPivH, htfPivL, htfEqh, htfEql, ltfPivH, ltfPivL, ema200v2, vwapv2)
        float stop = not na(stop_manual) ? stop_manual : (ats_long ? f_ats_nearest_below(entry, cand) : f_ats_nearest_above(entry, cand))
        if na(stop)
            stop := ats_long ? flip_lo : flip_hi
        float target = not na(target_manual) ? target_manual : (ats_long ? f_ats_nearest_above(entry, cand) : f_ats_nearest_below(entry, cand))
        float tol = f_aplus_pivot_dist(0.0)
        if target_pick == "Automatic (nearest)"
            target := f_ats_handle_snap(tp1_handle, target, tol, ats_long, cand, entry)
        if stop_pick == "Automatic (nearest)"
            stop := f_ats_handle_snap(sl1_handle, stop, tol, not ats_long, cand, entry)
        float stop2_manual = stop2_pick == "Automatic (nearest)" ? na : f_ats_level_by_name(stop2_pick, r3, r2, r1, pp, s1, s2, s3, ydh, ydl, pmh, pml, htfPivH, htfPivL, htfEqh, htfEql, ltfPivH, ltfPivL, ema200v2, vwapv2)
        float target2_manual = target2_pick == "Automatic (nearest)" ? na : f_ats_level_by_name(target2_pick, r3, r2, r1, pp, s1, s2, s3, ydh, ydl, pmh, pml, htfPivH, htfPivL, htfEqh, htfEql, ltfPivH, ltfPivL, ema200v2, vwapv2)
        float stop2 = not show_sl2 ? na : not na(stop2_manual) ? stop2_manual : (ats_long ? f_ats_nearest_below(stop, cand) : f_ats_nearest_above(stop, cand))
        float target2 = not show_tp2 ? na : not na(target2_manual) ? target2_manual : (ats_long ? f_ats_nearest_above(target, cand) : f_ats_nearest_below(target, cand))
        if show_tp2 and target2_pick == "Automatic (nearest)" and not na(target2)
            target2 := f_ats_handle_snap(tp2_handle, target2, tol, ats_long, cand, target)
        if show_sl2 and stop2_pick == "Automatic (nearest)" and not na(stop2)
            stop2 := f_ats_handle_snap(sl2_handle, stop2, tol, not ats_long, cand, stop)
        if not na(stop) and not na(target) and stop != entry and target != entry
            new_setup := true
            array.set(out_call, 0, entry)
            array.set(out_call, 1, stop)
            array.set(out_call, 2, target)
            array.set(out_call, 3, stop2)
            array.set(out_call, 4, target2)
    new_setup

// v63: f_render_flip_brsg_fvg_piv_lines() -- proactive CE10295 headroom, per direct request ("can we
// move more into the libraries so we can have some headroom for future edits") after v7.84's fix. This
// relocates the single largest remaining top-level block in the main script: the `if barstate.islast`
// draw/reset block for the CBC Flip LTF/HTF lines, the BRSG zone, the HTF Flip FVG zone, and the HTF/
// LTF/MTF pivot reference lines -- 21 `var line`/`var linefill`/`var float` persistent-state
// declarations plus ~105 lines of drawing logic, all now living entirely inside this one exported
// function using the same "var state inside the library function" pattern already proven throughout
// this file (f_render_pivot_table, f_render_fib_zone_box, f_ats_draw_setup). bar_index/time/time_close
// (and their [] historical offsets) are Pine's own built-ins and need no parameter -- available from
// library scope exactly like f_obAdd already reads high[_idx]/low[_idx]/bar_index (see the comment
// above f_obAdd). cbc[1]/htf_cbc[1] are NOT built-ins (they're main-script-only series), so the color
// they used to pick between (col_ltf_flip_l/h, col_htf_flip_l/h) is now resolved ONCE at the call site
// and passed in as a single already-decided `color` -- same technique already used for
// f_ref_line_style(...)'s enum-to-string resolution at the f_render_fib_zone_box call site. All 3
// `f_ref_line_style()` calls (htf/ltf/mtf pivot line styles) are likewise resolved at the call site and
// passed in as plain strings, since f_ref_line_style() itself is a main-script-only RefLineStyle-enum
// function that can't be called from inside the library. Pure relocation -- every condition, delete-
// then-redraw-or-extend branch, and drawing call below is byte-for-byte identical to what the main
// script's inline block did; only the 21 var declarations moved from main-script top-level scope into
// this function's own persistent local state, and cbc[1]/htf_cbc[1]/f_ref_line_style() calls moved to
// pre-resolved parameters. See the v7.85 changelog block in the main script for the full writeup and the
// exact main-script diff.
export f_render_flip_brsg_fvg_piv_lines(bool show_cbc_flip_ltf, float ltf_flip_price, color col_ltf_flip_line, int cbc_flip_ltf_width, bool htf_enabled, bool show_cbc_flip_htf, float htf_flip_price, color col_htf_flip_line, int cbc_flip_htf_width, bool show_brsg_zone, float brsg_zone_top, float brsg_zone_bot, color col_brsg_zone, bool show_brsg_fill, color col_brsg_fill, bool show_htf_flip_fvg, bool htf_fvg_exists, float htf_fvg_top, float htf_fvg_bot, color col_htf_flip_fvg, int ch_sec_lbl, bool show_htf_pivots, string htf_piv_sty, float h_last_hi, int h_last_hi_t, float h_last_lo, int h_last_lo_t, color col_htf_piv_res, color col_htf_piv_sup, int htf_piv_w, bool show_htf_piv_fill, color col_htf_piv_fill, bool show_ltf_pivots, string ltf_piv_sty, float l_last_hi, int l_last_hi_t, float l_last_lo, int l_last_lo_t, color col_ltf_piv_res, color col_ltf_piv_sup, int ltf_piv_w, bool show_ltf_piv_fill, color col_ltf_piv_fill, bool show_mtf_pivots, bool mtf_enabled, string mtf_piv_sty, float m_last_hi, int m_last_hi_t, float m_last_lo, int m_last_lo_t, color col_mtf_piv_res, color col_mtf_piv_sup, int mtf_piv_w, bool show_mtf_piv_fill, color col_mtf_piv_fill) =>
    var line cbc_flip_ltf_line = na
    var line cbc_flip_htf_line = na
    var line brsg_line_top = na
    var line brsg_line_bot = na
    var float brsg_line_top_val = na
    var float brsg_line_bot_val = na
    var linefill brsg_fill = na
    var line htf_fvg_line_top = na
    var line htf_fvg_line_bot = na
    var float htf_fvg_line_top_val = na
    var float htf_fvg_line_bot_val = na
    var linefill htf_fvg_fill = na
    var line h_piv_hi_ln = na
    var line h_piv_lo_ln = na
    var linefill h_piv_fill = na
    var line l_piv_hi_ln = na
    var line l_piv_lo_ln = na
    var linefill l_piv_fill = na
    var line m_piv_hi_ln = na
    var line m_piv_lo_ln = na
    var linefill m_piv_fill = na
    line.delete(cbc_flip_ltf_line)
    cbc_flip_ltf_line := na
    line.delete(cbc_flip_htf_line)
    cbc_flip_htf_line := na
    line.delete(brsg_line_top)
    brsg_line_top := na
    line.delete(brsg_line_bot)
    brsg_line_bot := na
    line.delete(h_piv_hi_ln)
    h_piv_hi_ln := na
    line.delete(h_piv_lo_ln)
    h_piv_lo_ln := na
    linefill.delete(h_piv_fill)
    h_piv_fill := na
    line.delete(l_piv_hi_ln)
    l_piv_hi_ln := na
    line.delete(l_piv_lo_ln)
    l_piv_lo_ln := na
    linefill.delete(l_piv_fill)
    l_piv_fill := na
    line.delete(m_piv_hi_ln)
    m_piv_hi_ln := na
    line.delete(m_piv_lo_ln)
    m_piv_lo_ln := na
    linefill.delete(m_piv_fill)
    m_piv_fill := na
    linefill.delete(brsg_fill)
    brsg_fill := na
    line.delete(htf_fvg_line_top)
    htf_fvg_line_top := na
    line.delete(htf_fvg_line_bot)
    htf_fvg_line_bot := na
    linefill.delete(htf_fvg_fill)
    htf_fvg_fill := na
    if bar_index > 0 and not na(time[1]) and not na(time_close[1])
        if show_cbc_flip_ltf and not na(ltf_flip_price)
            cbc_flip_ltf_line := line.new(time[1], ltf_flip_price, time_close[1], ltf_flip_price, xloc=xloc.bar_time, color=col_ltf_flip_line, width=cbc_flip_ltf_width, style=line.style_solid, extend=extend.none)
        if htf_enabled and show_cbc_flip_htf and not na(htf_flip_price)
            cbc_flip_htf_line := line.new(time[1], htf_flip_price, time_close[1], htf_flip_price, xloc=xloc.bar_time, color=col_htf_flip_line, width=cbc_flip_htf_width, style=line.style_solid, extend=extend.none)
        if show_brsg_zone and not na(brsg_zone_top)
            if na(brsg_line_top) or brsg_zone_top != brsg_line_top_val
                brsg_line_top := line.new(bar_index, brsg_zone_top, bar_index, brsg_zone_top, color=col_brsg_zone, width=cbc_flip_ltf_width, style=line.style_solid)
                brsg_line_top_val := brsg_zone_top
            else
                line.set_x2(brsg_line_top, bar_index)
            if na(brsg_line_bot) or brsg_zone_bot != brsg_line_bot_val
                brsg_line_bot := line.new(bar_index, brsg_zone_bot, bar_index, brsg_zone_bot, color=col_brsg_zone, width=cbc_flip_ltf_width, style=line.style_solid)
                brsg_line_bot_val := brsg_zone_bot
            else
                line.set_x2(brsg_line_bot, bar_index)
            if show_brsg_fill and not na(brsg_line_top) and not na(brsg_line_bot)
                brsg_fill := linefill.new(brsg_line_top, brsg_line_bot, color=col_brsg_fill)
        else if not show_brsg_zone
            line.delete(brsg_line_top)
            brsg_line_top := na
            brsg_line_top_val := na
            line.delete(brsg_line_bot)
            brsg_line_bot := na
            brsg_line_bot_val := na
        if show_htf_flip_fvg and htf_fvg_exists
            if na(htf_fvg_line_top) or htf_fvg_top != htf_fvg_line_top_val
                htf_fvg_line_top := line.new(bar_index, htf_fvg_top, bar_index, htf_fvg_top, color=col_htf_flip_fvg, width=cbc_flip_ltf_width, style=line.style_solid)
                htf_fvg_line_top_val := htf_fvg_top
            else
                line.set_x2(htf_fvg_line_top, bar_index)
            if na(htf_fvg_line_bot) or htf_fvg_bot != htf_fvg_line_bot_val
                htf_fvg_line_bot := line.new(bar_index, htf_fvg_bot, bar_index, htf_fvg_bot, color=col_htf_flip_fvg, width=cbc_flip_ltf_width, style=line.style_solid)
                htf_fvg_line_bot_val := htf_fvg_bot
            else
                line.set_x2(htf_fvg_line_bot, bar_index)
            if not na(htf_fvg_line_top) and not na(htf_fvg_line_bot)
                htf_fvg_fill := linefill.new(htf_fvg_line_top, htf_fvg_line_bot, color=col_htf_flip_fvg)
        else if not show_htf_flip_fvg
            line.delete(htf_fvg_line_top)
            htf_fvg_line_top := na
            htf_fvg_line_top_val := na
            line.delete(htf_fvg_line_bot)
            htf_fvg_line_bot := na
            htf_fvg_line_bot_val := na
    if not na(ch_sec_lbl) and ch_sec_lbl > 0
        int piv_t_right = time_close + ch_sec_lbl * 1000
        if show_htf_pivots and htf_enabled
            if not na(h_last_hi) and not na(h_last_hi_t)
                h_piv_hi_ln := line.new(h_last_hi_t, h_last_hi, piv_t_right, h_last_hi, xloc=xloc.bar_time, color=col_htf_piv_res, style=htf_piv_sty, width=htf_piv_w, extend=extend.none)
            if not na(h_last_lo) and not na(h_last_lo_t)
                h_piv_lo_ln := line.new(h_last_lo_t, h_last_lo, piv_t_right, h_last_lo, xloc=xloc.bar_time, color=col_htf_piv_sup, style=htf_piv_sty, width=htf_piv_w, extend=extend.none)
            if show_htf_piv_fill and not na(h_piv_hi_ln) and not na(h_piv_lo_ln)
                h_piv_fill := linefill.new(h_piv_hi_ln, h_piv_lo_ln, color=col_htf_piv_fill)
        if show_ltf_pivots
            if not na(l_last_hi) and not na(l_last_hi_t)
                l_piv_hi_ln := line.new(l_last_hi_t, l_last_hi, piv_t_right, l_last_hi, xloc=xloc.bar_time, color=col_ltf_piv_res, style=ltf_piv_sty, width=ltf_piv_w, extend=extend.none)
            if not na(l_last_lo) and not na(l_last_lo_t)
                l_piv_lo_ln := line.new(l_last_lo_t, l_last_lo, piv_t_right, l_last_lo, xloc=xloc.bar_time, color=col_ltf_piv_sup, style=ltf_piv_sty, width=ltf_piv_w, extend=extend.none)
            if show_ltf_piv_fill and not na(l_piv_hi_ln) and not na(l_piv_lo_ln)
                l_piv_fill := linefill.new(l_piv_hi_ln, l_piv_lo_ln, color=col_ltf_piv_fill)
        if show_mtf_pivots and mtf_enabled
            if not na(m_last_hi) and not na(m_last_hi_t)
                m_piv_hi_ln := line.new(m_last_hi_t, m_last_hi, piv_t_right, m_last_hi, xloc=xloc.bar_time, color=col_mtf_piv_res, style=mtf_piv_sty, width=mtf_piv_w, extend=extend.none)
            if not na(m_last_lo) and not na(m_last_lo_t)
                m_piv_lo_ln := line.new(m_last_lo_t, m_last_lo, piv_t_right, m_last_lo, xloc=xloc.bar_time, color=col_mtf_piv_sup, style=mtf_piv_sty, width=mtf_piv_w, extend=extend.none)
            if show_mtf_piv_fill and not na(m_piv_hi_ln) and not na(m_piv_lo_ln)
                m_piv_fill := linefill.new(m_piv_hi_ln, m_piv_lo_ln, color=col_mtf_piv_fill)

// v46: republish-only bump, per direct request to force TradingView to treat this as a fresh publish
// after a suspected Pine Editor paste mismatch on the prior v45 upload (CE10017 "missing enclosing
// character" reported on text that doesn't exist anywhere in the actual v45 source — see the session
// handoff doc for the full back-and-forth). No functional change: zero exports touched, zero logic
// changed, this comment block is the only diff from v45.

// v47: f_ats_draw_setup() restyled per direct request/annotated screenshots referencing TradingView's
// native "Long/Short position" Forecasting drawing tool (split green/red box, entry through the
// middle). No scriptable API exists for that native tool, so this is the closest Pine approximation:
// dropped the rr_label text block ("LONG setup / Entry.. / Stop.. / Target.. / R:R..") so the setup is
// just the clean reward_box/risk_box/entry_line/stop_line/target_line shape, no info text. See the
// v47 comment directly above f_ats_draw_setup() for the full explanation. Signature unchanged at the
// time (txt_size param kept but now unused, to avoid a call-site mismatch) — superseded by v48 below.

// v48: TradingView compile warning CE10237 ("Unused argument 'txt_size'... Ensure that it utilizes all
// arguments") on the v47 signature — fixed by removing the parameter outright rather than leaving a
// dead one in place. `f_ats_draw_setup()` is now `(float entry, float stop, float target, color
// reward_col, color risk_col, bool is_long)`, 6 params (was 7). Main script's call site updated to
// match (6 args, `trade_setup_txt_size` dropped), and that now-orphaned "Label text size" input
// (`trade_setup_txt_size`) was removed from the main script entirely, since nothing consumes it
// anymore — see the v7.57 changelog block in the main script.

// v49: the SAME CE10237 warning, this time on `is_long` — v47's label removal left this parameter
// dead too (it used to pick "LONG"/"SHORT" label text and color), just not caught in the v48 pass
// since only `txt_size` had been reported yet. `f_ats_draw_setup()` is now `(float entry, float stop,
// float target, color reward_col, color risk_col)`, 5 params (was 6). Main script's call site updated
// to match (5 args) — the `ats_long` local variable itself stays in the main script, since it's still
// read elsewhere in that same `if` block for the stop/target direction logic; only the now-unneeded
// argument to THIS call was dropped. See the v7.58 changelog block in the main script.

// v50: RUNTIME BUG FIX for RE10039 "Column N is out of table bounds" in f_render_pivot_table(),
// reported at bar 22060 needing column 26 when the table had only been created with 26 columns.
// Root cause: `piv_tbl` (a `var table`, created exactly once, guarded by `if na(piv_tbl)`) had its
// column count fixed at whatever `piv_final_n` happened to be on the FIRST bar it drew
// (`table.new(f_status_pos(position), math.max(1, piv_final_n), 3, ...)`) — but `piv_final_n` is the
// live count of currently-enabled, non-na Pivot Points levels (BRSG zone visibility, R2/R3/S2/S3
// auto-escalation, HTF EQH/EQL only existing once formed, etc. — see v7.38/v7.41), so it can grow on
// a LATER bar past whatever the table was first sized for. Fix: allocate `piv_tbl` with a FIXED
// column count of 28 (27 candidate levels, indices 0-26 across pivT_price_arr/pivT_labels/
// pivT_enabled/pivT_lblcol, plus 1 for the PRICE row — piv_final_price/piv_final_label/
// piv_final_lblcol are already sized 28 for exactly this reason) instead of sizing to `piv_final_n`
// at creation time. This is the true upper bound `piv_final_n` can ever reach on any bar, for any
// combination of toggles, so the mismatch can't recur. Unused trailing columns on a sparser bar are
// simply never written to by the render loop — `table.new()` leaves an unset cell blank, no visual
// side effect. See the v7.60 changelog block in the main script for the full writeup.

// v51: `f_render_pivot_table()`'s PRICE row (label, Long/Short text, diff sign, green/red color) now
// follows the `htf_bull` parameter instead of `ltf_bull` in all 4 remaining spots
// (price_lbl_txt/p_diff/p_price_col_bg/p_row1_txt) — the sort order a few lines above was already keyed
// off `htf_bull` (unchanged since v7.35), so the whole table's "pivot price direction" concept is now
// consistently one direction instead of two. Signature left with `ltf_bull` still a parameter (still
// receiving `cbc` from the call site) but no longer read inside the function body. Main script's call
// site also switched its `htf_bull` ARGUMENT from `cf_f2_htf_bull` (a confluence-score variable that
// blends in the live, still-forming HTF bar under certain conditions) to `htf_dir_bull_now` (the
// confirmed, last-CLOSED-HTF-bar direction). See the v7.63 changelog block in the main script for the
// full writeup, including the direct-request quotes.

// v52: CE10237 FIX — "unused argument 'ltf_bull'", the SAME warning class that hit `f_ats_draw_setup()`
// twice at v7.57/v7.58 (see those changelog blocks), now on `f_render_pivot_table()`. v51 above switched
// every use inside the function from `ltf_bull` to `htf_bull` but left `ltf_bull` sitting in the
// signature with nothing left reading it — should have been caught by convention #33 ("remove an unused
// parameter in the SAME round it becomes unused") but wasn't, this time on the first pass rather than a
// missed second warning. Reported via the TradingView Pine Editor's "Pine Script compilation error"
// modal, single word "fix". Fix: removed `ltf_bull` from `f_render_pivot_table()`'s signature outright
// (61→60 params). Main script's call site updated to match — dropped the trailing `cbc` argument that
// used to fill that slot (60 args now, same order otherwise). No other behavior change — `cbc` itself
// (the main-script local variable) is untouched and still used elsewhere in the file. See the v7.64
// changelog block in the main script for the full writeup.

// v53: `f_ats_build_candidates()` gained NY/London/Asia session Opening Range High/Low as candidates —
// 6 new price/6 new show-toggle parameters (ny_orh/sh_ny_orh/ny_orl/sh_ny_orl, ln_orh/sh_ln_orh/
// ln_orl/sh_ln_orl, as_orh/sh_as_orh/as_orl/sh_as_orl) and 6 matching `if sh_x and not na(x)` push
// blocks, same pattern as every other candidate source in the function. OR-H/OR-L had simply never
// been wired into this function's parameter list before, unlike YDH/YDL and PMH/PML which already
// were. BRSG stays excluded, per the function's existing comment and the user's explicit answer when
// asked. Main script's call site updated to pass the same ORHigh_NY/ORLow_NY/ORHigh_LN/ORLow_LN/
// ORHigh_AS/ORLow_AS values and show_pivot_*_or* toggles the Pivot Points table itself already uses,
// so a session's OR only becomes a candidate when that session's OR row is enabled to show on the
// chart. Signature grew from 26 to 38 parameters; call site argument count matches. See the v7.67
// changelog block in the main script for the full writeup, including the direct-request quotes.

// v54: new helper `f_fmt_ny_time_hm(int t)` -- bare "H:MM" NY-time formatter (no month/day, no seconds,
// no " ET"), purpose-built for a narrow table cell where the existing f_fmt_ny_time()/
// f_fmt_ny_time_sec() are too verbose. `f_render_pivot_table()`'s Price row row-1 cell (previously the
// plain word "Long"/"Short") now reads `(htf_bull ? "L " : "S ") + f_fmt_ny_time_hm(htf_last_flip_t_open)`
// instead -- the direction letter plus the confirming HTF candle's own OPEN time (candles are
// conventionally named by their open time, e.g. "the 9:30 candle"). New parameter
// `int htf_last_flip_t_open` added to the signature (60→61 params); main script's call site passes a
// new sibling var of the same name, latched from `sig_htf_t_open` at the same point the existing
// `htf_last_flip_t` (close-time) latches from `sig_htf_t_close` -- kept separate since that existing
// var's close-time meaning, used elsewhere (Status table/Historical Bar Panel/alert email), was not
// asked to change. See the v7.70 changelog block in the main script for the full writeup.

// v55: `f_fmt_ny_time_hm(t)` (v54's single-time "H:MM" helper) REPLACED by `f_fmt_ny_time_range(t_open,
// t_close)` -- a compact open-close time RANGE formatter, per direct follow-up on v54's own display
// ("make it 9:30-45 or in another case 9:45-10"): same-hour close repeats just the close minutes
// ("9:30-45"), a close rolling into a new hour shows that hour instead, dropping ":00" when the close
// lands exactly on the hour ("9:45-10"). `f_render_pivot_table()`'s Price row row-1 cell now reads
// `(htf_bull ? "L " : "S ") + f_fmt_ny_time_range(htf_last_flip_t_open, htf_last_flip_t_close)` instead
// of v54's single-open-time display. New parameter `int htf_last_flip_t_close` added to the signature
// (61→62 params) alongside v54's existing `htf_last_flip_t_open`; main script's call site passes the
// EXISTING `htf_last_flip_t` var (already tracking that same bar's close time for other display
// purposes) into the new slot -- no new main-script var needed this round. See the v7.71 changelog
// block in the main script for the full writeup.

// v56: chart-level label overlap handling -- two brand-new exports, no existing signature changed.
// `f_level_group_leader(float[] prices, float dist) => int[]` unions price entries within `dist`
// points of each other via chained relaxation passes over all pairs, returning each entry's group-
// leader index (self-leader = singleton or group representative). `f_level_merged_text(string[] names,
// float price, bool show_name, bool show_price) => string` builds the combined label text for a merged
// group (e.g. "PMH / LN ORB-H 4308.4"), honoring the same Show-Name/Show-Price toggles as the existing
// `f_level_label_text()`. Both called from a new post-pass block in the main script, added after its
// existing ORB NY/LN/AS label block -- registers every currently-visible level label (~16-22 of them:
// YDH/YDL/YDC, PMH/PML, 7 pivots, LN-H/L, AS-H/L, 6 ORB levels), groups them by price proximity, and
// `label.set_text()`'s a merged group's leader to the combined text while blanking every other member.
// Distance passed in from a new main-script input, `level_overlap_dist_override` (0 = auto), fed
// straight into the EXISTING `f_aplus_pivot_dist()` export rather than duplicating its MNQ=50/else=5
// auto-by-symbol logic in a third function. See the v7.72 changelog block in the main script for the
// full writeup, including the direct-request quotes and the screenshots that prompted it.

// v57: `f_ats_draw_setup()` gained a second, optional TP2/SL2 zone -- 5 new trailing params
// (show_lvl2/stop2/target2/reward2_col/risk2_col), per direct request ("add an option for drawing the
// setup as is but also include one more level for tp and sl - maybe a slightly different shading for
// the tp1 to tp2 and sl1 to sl2"), clarified via AskUserQuestion: TP2/SL2 come from the next-nearest
// qualifying candidate PAST TP1/SL1 in Automatic mode (or their own manual level pickers), and the
// feature is a new toggle, default ON. The function's original 5 params and their drawing are
// completely unchanged -- TP2/SL2 are two NEW persistent box/line pairs (reward_box2/risk_box2/
// target2_line/stop2_line), drawn only when show_lvl2 is true and that level actually resolved (not
// na); a caller passing show_lvl2=false gets byte-for-byte the original single-level drawing. Signature
// grew from 5 to 10 parameters. See the v7.74 changelog block in the main script for the full writeup.

// v58: new export `f_ats_handle_snap(float handle, float current, float tol, bool want_above, float[]
// cand) => float` -- CE10295 "main body of the script is too long" relief, reported on v7.76's
// draggable drag-to-snap TP1/SL1/TP2/SL2 handles (4 near-identical multi-line override blocks that had
// been added directly to the main script's top-level scope). Collapses each block's "is the handle
// active, and if so what pivot does it snap to" logic into one library call -- same technique already
// used throughout this file for CE10117 relief (move pure-parameter, no-CBC-state logic to the
// library), and literally what CE10295's own message suggests ("try wrapping code in functions"). No
// existing export's signature changed. Pure relocation, no behavior change from what v7.76 shipped. See
// the v7.77 changelog block in the main script for the full writeup.

// v59: `f_ats_draw_setup()` gained 4 new persistent labels -- "TP1"/"SL1"/"TP2"/"SL2" tags drawn
// directly on their respective lines, per direct request ("mark tp1 and tp2 and sl1 and sl2 on the
// lines"). Delete-and-recreate on the SAME call that draws the box/lines, so a label only ever appears
// together with a genuinely new setup draw (this function has exactly one caller: the main script's
// cooldown-gated trigger block) -- no separate "on indicator load" path exists to guard against.
// Signature UNCHANGED (no new parameters) -- entry/stop/target/stop2/target2 were already available.
// Deliberately minimal per-line tags, not a revival of the v7.56-removed combined `rr_label`. See the
// v7.79 changelog block in the main script for the full writeup.

// v60: `f_ats_draw_setup()` gained a new FIRST parameter, `bool new_setup`, and now has to be called
// every bar (not just on a trigger bar) so it can check the active setup's TP2/SL2 against the current
// bar's high/low even on bars where nothing new fires. `new_setup=true` reproduces the exact v59 draw
// behavior (all objects, extend=extend.right); `new_setup=false` is a routine per-bar check that, once
// the active setup's TP2 or SL2 is breached, freezes every object's right edge at the breach bar
// (extend.none + set_right/set_x2) and never re-extends until the next genuinely new setup redraws.
// Signature grew from 10 to 11 parameters. Per direct request ("stop trade setup extending to the right
// when the price breaks tp2 or sl2"). See the v7.80 changelog block in the main script for the full
// writeup, including the call-site restructuring this required.

// v61: new export `f_ats_draw_handles(float tp1_h, float sl1_h, float tp2_h, float sl2_h, bool
// show_tp2, bool show_sl2) => void` -- draws a small, uniquely-colored "◆ TPx/SLx HANDLE" label right on
// each of the 4 drag-handle input.price() lines whenever that handle is active (non-zero), so the 4
// otherwise-identical draggable lines can finally be told apart on the chart, and skips it entirely
// while a handle is still at its 0.0 default (nothing to label). Fixes the reported "where is the
// handle to drag? i tried to drag sl2 higher and tp2 went way down" -- see the v7.81 changelog block in
// the main script for the full root-cause writeup. No existing export's signature changed.

// v62: new export `f_ats_compute_trigger(...)` -- CE10295 relief round 4, after v7.83's comment-only
// trim was reported still showing the error. Settles that round's open question: CE10295 counts actual
// top-level/main-body code (an `if` block's contents included), not comments. Wraps the ENTIRE trigger-
// to-array-fill sequence (level-pick fallbacks, stop/target/stop2/target2 math, all 4 handle-snap
// overrides) that used to sit inline in the main script's ~50-line trigger `if` block into one function
// call. Writes results into the caller's `out_call` float[5] array by reference (arrays sidestep "no
// tuple return" -- convention #19) and returns a single bool. See the v7.84 changelog block in the main
// script for the full writeup and the call-site restructuring this enabled.

// v63: new export `f_render_flip_brsg_fvg_piv_lines(...)` -- proactive CE10295 headroom, per direct
// request ("move more into the libraries so we can have some headroom for future edits"). Relocates the
// main script's single largest remaining top-level block: the barstate.islast CBC Flip line / BRSG zone
// / HTF Flip FVG zone / HTF-LTF-MTF pivot-line draw-and-reset logic. 21 `var line`/`var linefill`/`var
// float` persistent-state declarations moved inside this function (same pattern as f_ats_draw_setup/
// f_render_pivot_table); bar_index/time/time_close and their [] offsets used directly (Pine built-ins,
// no parameter needed); cbc[1]/htf_cbc[1] (not built-ins) and the 3 f_ref_line_style() calls (main-
// script-only) resolved at the call site instead and passed in pre-decided. 55 parameters, pure
// relocation, zero behavior change. See the v7.85 changelog block in the main script for the full
// writeup.

// v88: "potential flop" -- names of the levels inside the HTF flip candle's range, latched at each flip
// (held until the next one); draws the amber "Flop?" label at the flip when show_lbl.
f_flop1(float lv, string nm, float lo, float hi) =>
    (not na(lv) and not na(lo) and lo <= lv and hi >= lv) ? nm + ", " : ""
export f_flop(bool flip, bool flip_bull, bool show_lbl, float lo, float hi, float e200, float vw, float pp, float r1, float r2, float r3, float s1, float s2, float s3) =>
    var string txt = ""
    if flip
        string s0 = f_flop1(e200, "EMA200", lo, hi) + f_flop1(vw, "VWAP", lo, hi) + f_flop1(pp, "PP", lo, hi) + f_flop1(r1, "R1", lo, hi) + f_flop1(r2, "R2", lo, hi) + f_flop1(r3, "R3", lo, hi) + f_flop1(s1, "S1", lo, hi) + f_flop1(s2, "S2", lo, hi) + f_flop1(s3, "S3", lo, hi)
        txt := str.length(s0) > 2 ? str.substring(s0, 0, str.length(s0) - 2) : ""
        if show_lbl and txt != ""
            // rev10: label text is just "⚠" + "200" and/or "VWAP" (pivots only in the tooltip / alerts)
            string sh_txt = (str.contains(txt, "EMA200") ? " 200" : "") + (str.contains(txt, "VWAP") ? " V" : "")
            label.new(bar_index, flip_bull ? low : high, "⚠" + sh_txt, style=flip_bull ? label.style_label_up : label.style_label_down, color=color.new(#FF5722, 0), textcolor=color.white, size=size.normal, tooltip="Potential flop: the HTF flip candle crossed " + txt)
    txt
// v99 rev9: pre + txt when txt is not empty, else "" (CBC flop lines: alert snapshot and HTF flip marker tooltip).
export f_flop_ln(string txt, string pre) =>
    txt == "" ? "" : pre + txt

// v88: Setup outcome tracker (moved from the main script). Tracks the latest setup from the bar after it is
// drawn: best/worst excursion from Entry, furthest TP reached; ends on SL1 crossed, confirmed HTF CBC
// against it, 17:00 ET (eod) or a new setup. Returns the "Setup Ended" alert text on the ending bar, else "".
f_ats_pts(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v, "#.##")
export f_ats_track(bool new_setup, float[] c, float tp3, float tp4, bool dir_bull, bool dir_bear, bool eod, string tkr, string chart_tf, float trail, float part, bool be, bool part_alert, bool tstop) =>
    var float t_en = na
    var bool t_long = false
    var float t_sl1 = na
    var float[] t_tps = array.new_float(4, na)
    var int t_start = na
    var float t_best = 0.0
    var float t_worst = 0.0
    var int t_maxtp = 0
    var bool t_trail = false
    var bool t_tp1 = false // rev21: TP1 reached (partial booked / breakeven applied)
    var float t_part = 0.0 // rev21: fraction closed at TP1 (0..1)
    string msg = ""
    if not na(t_en)
        t_best := math.max(t_best, t_long ? high - t_en : t_en - low)
        t_worst := math.min(t_worst, t_long ? low - t_en : t_en - high)
        for k = 0 to 3
            float tp = array.get(t_tps, k)
            if not na(tp) and (t_long ? high >= tp : low <= tp) and k + 1 > t_maxtp
                t_maxtp := k + 1
        bool sl_hit = not na(t_sl1) and (t_long ? low <= t_sl1 : high >= t_sl1)
        bool flip = t_long ? dir_bear : dir_bull
        bool ts = tstop and not t_tp1 // rev33
        string why = sl_hit ? (t_trail ? "Trail SL hit" : t_tp1 and be ? "Breakeven hit" : "SL1 hit") : flip ? "CBC flip" : ts ? "Time stop" : eod ? "16:00" : new_setup ? "New setup" : ""
        if why != ""
            float rem = (sl_hit ? t_sl1 - t_en : close - t_en) * (t_long ? 1.0 : -1.0)
            float p1 = (array.get(t_tps, 0) - t_en) * (t_long ? 1.0 : -1.0)
            float res = t_part * p1 + (1.0 - t_part) * rem
            // rev21: with a TP1 partial, "Result: +5.2 = 0.5x6.1(TP1) + 0.5x4.3(Trail)"
            string rtxt = f_ats_pts(res) + (t_part > 0 ? " = " + str.tostring(t_part, "#.##") + "×" + str.tostring(p1, "#.##") + "(TP1) + " + str.tostring(1.0 - t_part, "#.##") + "×" + str.tostring(rem, "#.##") + "(" + (sl_hit ? (t_trail ? "Trail" : be ? "BE" : "SL1") : flip ? "Flip" : ts ? "Time" : eod ? "16:00" : "New") + ")" : "")
            int mins = int(math.round((time_close - t_start) / 60000.0))
            msg := tkr + " —\n• Setup Ended: " + (t_long ? "LONG" : "SHORT") + "\nEnded: " + why + " | Result: " + rtxt + " | Max: " + (t_maxtp > 0 ? "TP" + str.tostring(t_maxtp) : "none") + " | Best: " + f_ats_pts(t_best) + " | Worst: " + f_ats_pts(t_worst) + " | Lasted: " + str.tostring(mins) + "m | At: " + str.format_time(time_close, "HH:mm", "America/New_York") + "\nSetup Entry: " + str.tostring(t_en, "#.##") + " | Started: " + str.format_time(t_start, "HH:mm", "America/New_York") + "\nChart: " + tkr + " " + chart_tf + "\nTime: " + f_fmt_ny_time_sec(time_close)
            t_en := na
        else if t_maxtp >= 1
            bool first = not t_tp1
            if first
                t_tp1 := true
                t_part := math.max(0.0, math.min(100.0, part)) / 100.0
                // rev21: breakeven for the remainder at TP1
                if be
                    t_sl1 := t_long ? math.max(t_sl1, t_en) : math.min(t_sl1, t_en)
            // rev11: trailing SL1 after TP1 (checked from the next bar on)
            if not na(trail)
                t_sl1 := t_long ? math.max(t_sl1, (trail < 0 ? high : close) - math.abs(trail)) : math.min(t_sl1, (trail < 0 ? low : close) + math.abs(trail))
                t_trail := true
            // rev21: "TP1 Partial" alert on the candle that reaches TP1
            if first and part_alert and (t_part > 0 or be)
                float p1 = (array.get(t_tps, 0) - t_en) * (t_long ? 1.0 : -1.0)
                msg := tkr + " —\n• TP1 Partial: " + (t_long ? "LONG" : "SHORT") + "\nClose " + str.tostring(t_part * 100, "#") + "% @ " + str.tostring(array.get(t_tps, 0), "#.##") + " (" + f_ats_pts(p1) + ")" + " | Remainder " + str.tostring((1.0 - t_part) * 100, "#") + "% | SL1 now " + str.tostring(t_sl1, "#.##") + (be ? " (breakeven or better)" : "") + (na(trail) ? "" : " trailing") + "\nSetup Entry: " + str.tostring(t_en, "#.##") + " | Started: " + str.format_time(t_start, "HH:mm", "America/New_York") + "\nChart: " + tkr + " " + chart_tf + "\nTime: " + f_fmt_ny_time_sec(time_close)
    if new_setup
        float en = array.get(c, 0)
        t_en := en
        t_long := array.get(c, 2) > en
        t_sl1 := array.get(c, 1)
        t_trail := false
        t_tp1 := false
        t_part := 0.0
        array.set(t_tps, 0, array.get(c, 2))
        array.set(t_tps, 1, array.get(c, 4))
        array.set(t_tps, 2, tp3)
        array.set(t_tps, 3, tp4)
        t_start := time_close
        t_best := 0.0
        t_worst := 0.0
        t_maxtp := 0
    msg

// v99 rev7: "Fib zone: IN 15m 4162 / 4161.3\n" when the setup Entry is inside the HTF Fib golden pocket, else "".
export f_ats_fib_txt(bool valid, float en, float top, float bot, string tf) =>
    valid and en <= top and en >= bot ? "Fib zone: IN " + tf + " " + str.tostring(top, "#.##") + " / " + str.tostring(bot, "#.##") + "\n" : ""

// v99 rev7: the Trade Setup alert message (moved from CBC f_ats_setup_alert, same text).
export f_ats_msg(string tk, bool lg, string why, string flt, string lv, string flip, bool toward, string flop, string fib, string chart, string tm, string snap) =>
    tk + " —\n• Trade Setup: " + (lg ? "LONG" : "SHORT") + "\nTrigger: " + why + flt + "\n" + lv + (flip == "" ? "" : flip + "\n") + (toward ? "Flip side: TOWARD\n" : "") + (flop == "" ? "" : "Flip flop: crossed " + flop + "\n") + fib + "Chart: " + chart + "\nTime: " + tm + "\n\n" + snap

// v99 rev7: small "ⓘ" label just left of the setup's Entry; hover = what drew the setup.
export f_ats_info_lbl(bool show, float en, bool lg, string why, string ltf, bool lb, string htf, bool hb, bool toward, string flop, string fib, int keep_n) =>
    var label[] q = array.new_label() // rev24: keep_n >= 0 -> rolling: only the newest keep_n + 1 ⓘ stay
    label l = na
    if show
        l := label.new(bar_index, en, "ⓘ", color = color.new(color.white, 100), textcolor = lg ? #22C55E : #EF4444, style = label.style_label_right, size = size.normal, tooltip = (lg ? "LONG" : "SHORT") + " setup @ " + str.tostring(en, "#.##") + "\nTrigger: " + why + "\nCBC " + ltf + ": " + (lb ? "Bullish" : "Bearish") + "\nCBC " + htf + ": " + (hb ? "Bullish" : "Bearish") + "\nFlip side: " + (toward ? "TOWARD" : "AWAY") + (flop == "" ? "" : "\nFlip flop: crossed " + flop) + (fib == "" ? "" : "\n" + str.replace_all(fib, "\n", "")))
        array.push(q, l)
        while keep_n >= 0 and array.size(q) > keep_n + 1
            label.delete(array.shift(q))
    l

// v99 rev8: trigger list for the Trade Setup / Setup Confirmed alerts and the ⓘ tooltip (moved from CBC; same text).
// Each bool is already resolved for the setup's direction by the caller.
export f_ats_why(bool fl, int fwin, int fpb, bool lt, bool lt9, bool ll, int age, bool h9, bool h9l, bool h20, bool h20l, bool pb, bool mo, bool tc) =>
    string why = ""
    if fl
        why += fwin == 0 ? "HTF CBC Flip, " : "HTF CBC Flip (pullback, " + str.tostring(math.abs(fpb)) + " bars after), "
    if lt
        why += "LTF EMA20 Pierce (closed beyond EMA9: " + (lt9 ? "yes" : "no") + "), "
    if ll
        why += "LTF EMA20 Pierce (late, " + str.tostring(age) + " bars after), "
    if h9
        why += h9l ? "HTF EMA9 Pierce (late), " : "HTF EMA9 Pierce, "
    if h20
        why += h20l ? "HTF EMA20 Pierce (late), " : "HTF EMA20 Pierce, "
    if pb
        why += "HTF Pullback Structure, "
    if mo
        why += "Momentum break, "
    if tc
        why += barstate.isconfirmed ? "LTF EMA20 Touch, " : "LTF EMA20 Touch (mid-candle), "
    str.length(why) > 2 ? str.substring(why, 0, str.length(why) - 2) : "Setup"

// v99 rev8: "Setup Confirmed" alert text (moved from CBC; same text).
export f_ats_conf_msg(string tk, bool lg, string why, float en, string tf, string tm) =>
    tk + " —\n• Setup Confirmed: " + (lg ? "LONG" : "SHORT") + "\nBy: " + why + "\nSetup Entry: " + (na(en) ? "—" : str.tostring(en, "#.##")) + "\nChart: " + tk + " " + tf + "\nTime: " + tm

// v99 rev8: New York minutes after midnight of a timestamp (e.g. 17:00 -> 1020).
export f_ats_hm_ny(int t) =>
    hour(t, "America/New_York") * 60 + minute(t, "America/New_York")

// rev36 (10/26/2026, CBC v10.38): "OB entry with the HTF EMAs" alert helper. lv = ESLib2 f_ob2_manage output (6 values per active
// order block: 1/4, top, 2/5, bottom, 3/6, mid; 1 = bullish OB+, 4 = bearish OB-). bull = HTF EMA9 above EMA20. Returns
// [top, bottom] of the first same-side block this candle traded into (OB+ for bull: low <= top and the close held at or
// above the bottom; OB- mirrored), else [na, na]. e20 = the HTF EMA20: when not na, the block must contain it (na = no check).
export f_ob_htf_touch(float[] lv, bool bull, float e20) =>
    float tp = na
    float bt = na
    int n = array.size(lv)
    if n >= 6
        for i = 0 to n - 6 by 6
            float t = array.get(lv, i + 1)
            float b = array.get(lv, i + 3)
            bool same = bull ? array.get(lv, i) == 1.0 : array.get(lv, i) == 4.0
            if na(tp) and same and (bull ? low <= t and close >= b : high >= b and close <= t) and (na(e20) or (e20 <= t and e20 >= b))
                tp := t
                bt := b
    array.from(tp, bt)

// rev36 (10/26/2026, CBC v10.41, CE10117 relief): pieces of CBC's alert snapshot text (a_mid), same text as before.
f_amid_n(float x) => na(x) ? "—" : str.tostring(x, "#.##")
f_amid_s(float x) => (x >= 0 ? "+" : "") + f_amid_n(x)
f_amid_orb1(string nm, float lv) =>
    na(lv) ? nm + " —" : "Price " + f_amid_n(close) + " is " + (close > lv ? "above" : close < lv ? "below" : "at") + " " + nm + " " + f_amid_n(lv) + " (" + f_amid_s(close - lv) + ")"
// "\nORB High ...\nORB Low ..." lines (on = OR shown and on for this session)
export f_amid_orb(bool on, float hi, float lo) =>
    on ? "\n" + f_amid_orb1("ORB High", hi) + "\n" + f_amid_orb1("ORB Low", lo) : ""
// EMA cloud / VWAP / EMA200 / EMA order / zone-entry / previous-candle lines
export f_amid_tail(string ltf_disp, string htf_disp, string mtf_tf, bool show_mtf, string cloud_msg, string htf_cloud_msg, bool mtf_bull, string v_msg, string e200_msg, string ltf_num, float e9, float e20, string htf_tf, float h9, float h20, int ltf_btw, int htf_btw) =>
    "\nEMA cloud (" + ltf_disp + "): " + cloud_msg + "\nEMA cloud (" + htf_disp + "): " + htf_cloud_msg + (not show_mtf ? "" : "\nEMA cloud (" + mtf_tf + "): " + (mtf_bull ? "Bullish" : "Bearish")) + "\nVWAP: " + v_msg + "\nEMA 200: " + e200_msg + "\n" + ltf_num + "min - " + f_price_vs_emas(close, e9, e20) + ": " + f_order3(e9, "ema9(" + ltf_num + ")", e20, "ema20(" + ltf_num + ")", close, "price:", "price:") + "\n" + htf_tf + "min - " + f_price_vs_emas(close, h9, h20) + ": " + f_order3(h9, "ema9(" + htf_tf + ")", h20, "ema20(" + htf_tf + ")", close, "price:", "price:") + "\nEMA9/20 (" + ltf_num + ") zone entries since flip: " + str.tostring(ltf_btw) + "\nEMA9/20 (" + htf_tf + ") zone entries since flip: " + str.tostring(htf_btw) + "\nPrev Candle (LTF, " + ltf_disp + "): H=" + f_amid_n(high[1]) + " L=" + f_amid_n(low[1]) + " C=" + str.tostring(close[1], "#.##")
// OB Entry alert text (moved from CBC v10.40)
export f_ob_htf_msg(float[] obh, bool lg, float h9, float h20, bool e20in, string chart_tf) =>
    syminfo.ticker + " —\n• OB Entry: " + (lg ? "LONG" : "SHORT") + "\nOB" + (lg ? "+ " : "- ") + str.tostring(array.get(obh, 0), format.mintick) + "-" + str.tostring(array.get(obh, 1), format.mintick) + " | HTF EMA9 " + str.tostring(h9, format.mintick) + (lg ? " > " : " < ") + "EMA20 " + str.tostring(h20, format.mintick) + (e20in ? " (in OB)" : "") + "\nPrice: " + str.tostring(close, format.mintick) + "\nChart: " + syminfo.ticker + " " + chart_tf + "\nTime: " + f_fmt_ny_time_sec(time_close)
// Market / CBC / EMA / VWAP / Fib snapshot block of CBC's marker tooltips and alerts (a_marker_snapshot, moved from CBC v10.41)
export f_amid_snap(string mkt, string ltf_disp, string ltf_msg, string htf_disp, string htf_msg, string or_msg, string cloud_msg, string htf_cloud_msg, string v_msg, string e200_msg, string st2, bool fib_ok, float f50, float f618, bool fib_in) =>
    "Market: " + mkt + "\nPrice: " + f_amid_n(close) + "\nCBC (" + ltf_disp + "): " + ltf_msg + "\nCBC (" + htf_disp + "): " + htf_msg + "\nOpening range: " + or_msg + "\nEMA cloud (" + ltf_disp + "): " + cloud_msg + "\nEMA cloud (" + htf_disp + "): " + htf_cloud_msg + "\nVWAP: " + v_msg + "\nEMA 200: " + e200_msg + st2 + "\nFib Zone (" + htf_disp + "): " + (not fib_ok ? "—" : str.tostring(f50, "#.#") + " / " + str.tostring(f618, "#.#") + (fib_in ? "  IN" : ""))
